@using MudBlazor
@using Microsoft.Extensions.Configuration
@inherits LayoutComponentBase
@inject IConfiguration Configuration

@* Required *@
<MudThemeProvider Theme="CustomTheme" IsDarkMode />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

@* Needed for snackbars *@
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="4">
        <a href="/">
            <MudText Typo="Typo.h4" Style="white-space: nowrap;">
                E-W Framework Analysis Tool
                @if (DeploymentInfo.ShowDetails && !string.IsNullOrEmpty(DeploymentInfo.EnvironmentLabel) && DeploymentInfo.EnvironmentLabel != "PRODUCTION")
                {
                    <MudChip T="string" Color="Color.Secondary" Size="Size.Small" Class="ml-2">
                        @DeploymentInfo.EnvironmentLabel
                    </MudChip>
                }
            </MudText>
        </a>
        <MudSpacer /> @* Adds space between the title and the links *@
        <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.Center">
            <MudNavLink Class="text-nowrap" Href="/" Match="NavLinkMatch.All">Home</MudNavLink>
            <MudNavLink Class="text-nowrap" Href="/by-data-source" Match="NavLinkMatch.All">By Data Source and Sector</MudNavLink>
            <MudNavLink Class="text-nowrap" Href="/by-element" Match="NavLinkMatch.All">By Data Element</MudNavLink>
            <MudNavLink Class="text-nowrap" Href="/about" Match="NavLinkMatch.All">About</MudNavLink>
        </MudStack>
    </MudAppBar>

    <MudMainContent Class="mb-10">
        <MudContainer Gutters Class="mt-10">
            @Body
        </MudContainer>
    </MudMainContent>

    @* Footer with deployment information *@
    <MudAppBar Bottom="true" Fixed="false" Elevation="1" Style="height: auto; padding: 8px 16px;">
        <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Style="width: 100%;">
            <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary);">
                Version: @DeploymentInfo.Version
            </MudText>
            @if (DeploymentInfo.ShowDetails)
            {
                <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary);">
                    @if (!string.IsNullOrEmpty(DeploymentInfo.DeployDateTime) && DeploymentInfo.DeployDateTime != "NEVER")
                    {
                        <span>Deployed: @DeploymentInfo.DeployDateTime</span>
                    }
                    @if (!string.IsNullOrEmpty(DeploymentInfo.EnvironmentLabel))
                    {
                        <span class="ml-4">Environment: @DeploymentInfo.EnvironmentLabel</span>
                    }
                </MudText>
            }
        </MudStack>
    </MudAppBar>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private DeploymentInfoModel DeploymentInfo = new();

    protected override void OnInitialized()
    {
        // Load deployment info from configuration
        var deploymentSection = Configuration.GetSection("DeploymentInfo");
        DeploymentInfo = new DeploymentInfoModel
        {
            Version = deploymentSection["Version"] ?? "Unknown",
            DeployDateTime = deploymentSection["DeployDateTime"] ?? "Unknown",
            EnvironmentLabel = deploymentSection["EnvironmentLabel"] ?? "Unknown",
            ShowDetails = deploymentSection.GetValue<bool>("ShowDetails")
        };
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private MudTheme CustomTheme = new MudTheme()
        {
            PaletteDark = new PaletteDark()
            {
                Primary = "#1B75BB",
                Secondary = "#8BC53F",
                Tertiary = "#FFD300"
            }
        };

    public class DeploymentInfoModel
    {
        public string Version { get; set; } = string.Empty;
        public string DeployDateTime { get; set; } = string.Empty;
        public string EnvironmentLabel { get; set; } = string.Empty;
        public bool ShowDetails { get; set; }
    }
}
