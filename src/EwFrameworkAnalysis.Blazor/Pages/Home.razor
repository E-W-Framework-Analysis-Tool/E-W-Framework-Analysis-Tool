@page "/"
@using MudBlazor
@using EwFrameworkAnalysis.Blazor.Components
@inject HttpClient Http

<MudText Typo="Typo.h6" GutterBottom>
    Evaluate Your Education System's
    <MudText Typo="Typo.h5" Color="Color.Primary" HtmlTag="span"><strong>Data Readiness</strong></MudText>
    to Answer
    <MudText Typo="Typo.h5" Color="Color.Secondary" HtmlTag="span"><strong>Essential Questions</strong></MudText>
    Promoting
    <MudText Typo="Typo.h5" Color="Color.Tertiary" HtmlTag="span"><strong>Equitable Outcomes</strong></MudText>
    For All.
</MudText>
<MudText Typo="Typo.subtitle1" Align="Align.Center" GutterBottom>
    Assess your data readiness and plan for effective educational policies with this analysis tool and the Education-to-Workforce Indicator Framework.
</MudText>

<MudPaper Elevation="10" Class="pa-4 mt-10"><MudText Typo="Typo.h5" Color="Color.Tertiary" Align="Align.Center"><strong>Get started by selecting a data inventory method below!</strong></MudText></MudPaper>

<MudGrid Class="mt-5 ps-10 pe-10 mb-10">
    <MudItem xs="12" sm="6">
        <MudCard Class="h-100" Elevation="10">
            <a href="/by-data-source">
                <MudCardMedia Image="/images/ByDataSource.jpg" />
            </a>
            <MudCardContent>
                <MudStack Row>
                    <MudText Typo="Typo.h6">By Data Source and Sector</MudText>
                    <MudSpacer />
                    <MudChip T="string" Color="Color.Secondary">Quick</MudChip>
                </MudStack>
                <MudText Typo="Typo.body2">
                    Quickly assess your data readiness using broad categories defined by the E-W Framework. Ideal for an overview and general exploration.
                </MudText>
                <MudText Class="p-4">
                    <ul style="list-style-type: circle">
                        <li>Manual checklist</li>
                        <li>8 data sources and 4 sectors (PK, K12, PS, WF)</li>
                    </ul>
                </MudText>

            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Href="/by-data-source">Get Started</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudCard Class="h-100" Elevation="10">
            <a href="/by-element">
                <MudCardMedia Image="/images/ByDataElement.jpg" />
            </a>
            <MudCardContent>
                <MudStack Row>
                    <MudText Typo="Typo.h6">By Data Element</MudText>
                    <MudSpacer />
                    <MudChip T="string" Color="Color.Primary">Detailed</MudChip>
                </MudStack>
                <MudText Typo="Typo.body2">
                    Dive deep into specific data elements for a detailed assessment. Perfect for a high-resolution analysis of your readiness for each indicator.
                </MudText>
                <MudText Class="p-4">
                    <ul style="list-style-type: circle">
                        <li>Automate analysis with connnectors</li>
                        <li>Manual checklist</li>
                        <li>73 data elements</li>
                    </ul>
                </MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/by-element">Get Started</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
</MudGrid>


<MudText Typo="Typo.h5" GutterBottom>What is the E-W Framework?</MudText>
<MudText Typo="Typo.body1">
    The <MudLink Href="https://educationtoworkforce.org" Target="_blank" Class="text-nowrap">Education-to-Workforce Indicator Framework</MudLink> (or E-W Framework) is an extensive framework developed by
    <MudLink Href="https://www.mathematica.org">Mathematica</MudLink>
    in partnership with the
    <MudLink Href="https://www.gatesfoundation.org/">Bill & Melinda Gates Foundation</MudLink>
    and experts in education research. The framework offers essential questions and indicators to evaluate educational progress across Early Learning, K-12, Postsecondary, and Workforce sectors.
</MudText>
<MudText class="mt-10" Typo="Typo.h5" GutterBottom>What does the Analysis Tool for E-W Framework do?</MudText>
<MudText Typo="Typo.body1">
    This Analysis Tool was developed by
    <MudLink Href="https://wearedoubleline.com">Double Line</MudLink>
    to build upon the rich information in the E-W Framework and enable you to understand which indicators your data systems are prepared for. It then calculates how well your data satisfies the recommended metrics for each Indicator, giving you a visual representation of your system's readiness by Indicator and by Essential Question.
</MudText>

<MudGrid Class="mt-5">
    <MudItem md="4">
        <MudCard Elevation="10">
            <MudCardMedia Image="@taskImage" @onmouseover="() => taskImage = taskAnimatedSrc" @onmouseout="() => taskImage = taskStillSrc" />
            <MudCardContent>
                <MudText Class="fw-bolder" Typo="Typo.h6" Align="Align.Center">1. Input Your Data Inventory</MudText>
                <MudText Typo="Typo.body2" Align="Align.Center">
                    Provide details about your current data sources and elements through manual or automated methods.
                </MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem md="4">
        <MudCard Elevation="10">
            <MudCardMedia Image="@processImage" @onmouseover="() => processImage = processAnimatedSrc" @onmouseout="() => processImage = processStillSrc" />
            <MudCardContent>
                <MudText Class="fw-bolder" Typo="Typo.h6" Align="Align.Center">2. View Readiness Scores</MudText>
                <MudText Typo="Typo.body2" Align="Align.Center">
                    See instant feedback and visualize how well your data currently supports the E-W Framework's indicators.
                </MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem md="4">
        <MudCard Elevation="10">
            <MudCardMedia Image="@strategyImage" @onmouseover="() => strategyImage = strategyAnimatedSrc" @onmouseout="() => strategyImage = strategyStillSrc" />
            <MudCardContent>
                <MudText Class="fw-bolder" Typo="Typo.h6" Align="Align.Center">3. Plan Your Roadmap</MudText>
                <MudText Typo="Typo.body2" Align="Align.Center">
                    Use the insights to understand gaps and prioritize efforts.
                </MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private string taskStillSrc = "/images/task_still.png";
    private string taskAnimatedSrc = "/images/task.gif";
    private string taskImage = "/images/task.gif";

    private string processStillSrc = "/images/process_still.png";
    private string processAnimatedSrc = "/images/process.gif";
    private string processImage = "/images/process.gif";

    private string strategyStillSrc = "/images/strategy_still.png";
    private string strategyAnimatedSrc = "/images/strategy.gif";
    private string strategyImage = "/images/strategy.gif";

    protected override async Task OnInitializedAsync()
    {
        // Intentionally not awaited
        _ = QueueImagePausing();

        await base.OnInitializedAsync();
    }

    private async Task QueueImagePausing()
    {
        await Task.Delay(2000);

        await InvokeAsync(() =>
        {
            taskImage = taskStillSrc;
            processImage = processStillSrc;
            strategyImage = strategyStillSrc;
            StateHasChanged();
        });
    }
}
