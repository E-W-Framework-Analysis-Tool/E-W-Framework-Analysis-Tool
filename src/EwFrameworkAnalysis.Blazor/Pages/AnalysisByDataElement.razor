@page "/by-element"
@using Blazored.LocalStorage
@using Microsoft.Extensions.Caching.Memory
@using MudBlazor
@using EwFrameworkAnalysis.Blazor.Models
@using EwFrameworkAnalysis.Common.Models
@using EwFrameworkAnalysis.Blazor.Components
@using EwFrameworkAnalysis.Blazor.Services
@using EwFrameworkAnalysis.Blazor.Services.DataAvailability
@using FluentValidation
@inject EwFrameworkService EwFrameworkService
@inject QuestionScoringService QuestionScoringService
@inject ILocalStorageService LocalStorage
@inject HttpClient Http
@inject IMemoryCache Cache
@inject IConfiguration Configuration
@inject IDialogService DialogService

<MudText Typo="Typo.h4">Configure Data Inventory Methods</MudText>
<MudText Typo="Typo.body1" Class="mb-5">Select which methods to use to provide data availability for scoring readiness. When multiple providers are selected, the results are unioned.</MudText>

<MudPaper Class="p-4 mb-10">
    @* Validate the form on ANY field change, e.g. FieldChange="...", as some rules impact multiple fields *@
    <MudForm FieldChanged="async () => { if (form != null) await form.Validate(); }" @ref="form" Model="@configuration" Validation="@(validator.ValidateValue)">
        <MudGrid Class="mb-10">
            <!-- User Input Card -->
            <MudItem md="4">
                <MudCard Class="h-100" Elevation="5">
                    <MudCardHeader>
                        <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.h6">User Input</MudText>
                            <MudSwitch T="bool" @bind-Value="configuration.EnableUserInput" @bind-Value:after="async () => { if (calculateAutomatically) await CalculateScores(); }" Color="Color.Primary" />
                        </MudStack>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText>Manually select the data elements you have available.</MudText>
                        @if (configuration.EnableUserInput)
                        {
                            var providerProgress = scoringProgress?.ProviderReports.TryGetValue(UserInputDataItemProvider<DataElementDataItem>.ProviderName, out var progress) == true ? progress : null;
                            <MudStack>
                                <MudStack Row AlignItems="AlignItems.Center">
                                    <MudToggleIconButton @bind-Toggled="RenderSideBySide" Icon="@Icons.Material.Rounded.VerticalDistribute" ToggledIcon="@Icons.Material.Rounded.HorizontalDistribute" />
                                    <MudText>@(RenderSideBySide ? "Viewing Side-by-Side" : "Viewing Vertically")</MudText>
                                </MudStack>
                                @* Only show the availability score as the UI progress is not useful information *@
                                <ProviderProgress Report="providerProgress" AvailabilityScoreOnly />
                            </MudStack>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- Ed-Fi API Card -->
            <MudItem md="4">
                <MudCard Class="h-100" Elevation="5">
                    <MudCardHeader>
                        <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.h6">Ed-Fi ODS API</MudText>
                            <MudSwitch T="bool" @bind-Value="configuration.EnableEdFiApi" @bind-Value:after="async () => { if (calculateAutomatically) await CalculateScores(); }" Color="Color.Primary" />
                        </MudStack>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText>Check data availability using the Ed-Fi ODS API.</MudText>
                        @if (configuration.EnableEdFiApi)
                        {
                            var providerProgress = scoringProgress?.ProviderReports.TryGetValue(EdFiApiDataItemAvailabilityProvider.ProviderName, out var progress) == true ? progress : null;
                            <MudStack>
                                <MudTextField @bind-Value="configuration.EdFiApiBaseUrl" For="() => configuration.EdFiApiBaseUrl" HelperText="The portion up until `/data/v3/ed-fi/...`" Label="Base URL" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Http" Class="mb-2" Margin="Margin.Dense" />
                                <MudTextField @bind-Value="configuration.EdFiApiClientId" For="() => configuration.EdFiApiClientId" Label="Client ID" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.VpnKey" Class="mb-2" Margin="Margin.Dense" />
                                <MudTextField @bind-Value="configuration.EdFiApiClientSecret" For="() => configuration.EdFiApiClientSecret" Label="Client Secret" InputType="InputType.Password" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Lock" Class="mb-2" Margin="Margin.Dense" />
                                <MudText>-or-</MudText>
                                <MudTextField @bind-Value="configuration.EdFiApiTemporaryAccessToken" For="() => configuration.EdFiApiTemporaryAccessToken" Label="Temporary Access Token" InputType="InputType.Password" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Lock" Class="mb-2" Margin="Margin.Dense" />
                                <MudButton Variant="Variant.Outlined" Color="Color.Info" OnClick="SetDemoApiValues">Use Demo API</MudButton>

                                <ProviderProgress Report="providerProgress" />
                                @if (providerProgress != null)
                                {
                                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="() => OpenProviderDetails(EdFiApiDataItemAvailabilityProvider.ProviderName)">View Provider Details</MudButton>
                                }
                            </MudStack>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- Ed-Fi Database Card -->
            <MudItem md="4">
                <MudCard Class="h-100" Elevation="5">
                    <MudCardHeader>
                        <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.h6">Ed-Fi ODS Database</MudText>
                            <MudSwitch Disabled="databaseOptionsDisabled" T="bool" @bind-Value="configuration.EnableEdFiDatabase" @bind-Value:after="async () => { if (calculateAutomatically) await CalculateScores(); }" Color="Color.Primary" />
                        </MudStack>
                        @if (databaseOptionsDisabled)
                        {
                            <MudAlert Severity="MudBlazor.Severity.Warning">Disabled for public demo</MudAlert>
                        }
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText>Check data availability using a server-side connection to an Ed-Fi ODS Database.</MudText>
                        @if (configuration.EnableEdFiDatabase)
                        {
                            // fill with impl for async database scoring
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- CEDS DW Database Card -->
            <MudItem md="4">
                <MudCard Class="h-100" Elevation="5">
                    <MudCardHeader>
                        <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.h6">CEDS Data Warehouse</MudText>
                            <MudSwitch Disabled="databaseOptionsDisabled" T="bool" @bind-Value="configuration.EnableCedsDW" @bind-Value:after="async () => { if (calculateAutomatically) await CalculateScores(); }" Color="Color.Primary" />
                        </MudStack>
                        @if (databaseOptionsDisabled)
                        {
                            <MudAlert Severity="MudBlazor.Severity.Warning">Disabled for public demo</MudAlert>
                        }
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText>Check data availability using a server-side connection to a CEDS Data Warehouse Database.</MudText>
                        @if (configuration.EnableCedsDW)
                        {
                            // fill with impl for async database scoring
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>

        </MudGrid>

        <MudStack Row AlignItems="AlignItems.Start">
            <MudButton Disabled="@calculateAutomatically" Variant="Variant.Filled" Color="Color.Primary" OnClick="async () => { if (form != null) { await form.Validate(); if (form.IsValid) await Task.Run(() => CalculateScores());}}">@(calculateAutomatically ? "Automatically calculating" : "Calculate score")</MudButton>
            @if (isCalculating)
            {
                <MudProgressCircular Indeterminate />
            }

            @if (scoringProgress != null && scoringProgress.TotalAvailabilityChecks != 0 && !calculateAutomatically)
            {
                <MudStack>
                    <MudProgressLinear Color="Color.Primary" Value="@((double)scoringProgress.OverallProgress * 100)" />
                    <MudText Typo="Typo.body1">@($"Progress: {scoringProgress.CompletedAvailabilityChecks}/{scoringProgress.TotalAvailabilityChecks} checks completed")</MudText>
                </MudStack>
            }
        </MudStack>
    </MudForm>
</MudPaper>



<MudGrid>
    @if (configuration.EnableUserInput)
    {
        <MudItem md="12" lg="@(RenderSideBySide ? 6 : 12)">
            <MudItem Class="@(RenderSideBySide ? "mb-5" : "")">
                <MudText Typo="Typo.h4">User Input Data Inventory</MudText>
                <MudText Typo="Typo.body1">Indicate which data elements you have available below.</MudText>
            </MudItem>

            <MudStack Row Class="mb-5">
                <MudSpacer></MudSpacer>
                @if (panels != null)
                {
                    <MudButtonGroup>
                        <MudButton OnClick="@(async () => await panels.ExpandAllAsync())">Expand All</MudButton>
                        <MudButton OnClick="@(async () => await panels.CollapseAllAsync())">Collapse All</MudButton>
                    </MudButtonGroup>
                }
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="async () => { selectedData = new HashSet<DataElementDataItem>(); if (calculateAutomatically) { await CalculateScores(); }}">Clear all selections</MudButton>
            </MudStack>

            <MudCard Elevation="2" Class="mb-10">
                <MudCardContent>
                    <MudExpansionPanels @ref="panels" Elevation="3" MultiExpansion="true">
                        @foreach (var dataElementGroup in dataElementsGrouped)
                        {
                            <MudExpansionPanel>
                                <TitleContent>
                                    @{
                                        var groupSelected = dataElementGroup.Value.Where(de => selectedData.Contains(de)).Count();
                                        var groupTotal = dataElementGroup.Value.Count;
                                    }
                                    <MudProgressCircular Class="mr-3" Size="Size.Small" Color="Color.Primary" Value="@(groupSelected * 100.0 / groupTotal)" />
                                    @($"{dataElementGroup.Key} ({groupSelected} of {groupTotal} selected)")
                                </TitleContent>
                                <ChildContent>
                                    <MudGrid>
                                        @foreach (var dataElement in dataElementGroup.Value)
                                        {
                                            <MudItem lg="6">
                                                <MudToggleGroup T="bool" SelectionMode="SelectionMode.ToggleSelection" CheckMark Value="@selectedData.Contains(dataElement)" ValueChanged="selected => OnAvailableDataSelected(dataElement, selected)">
                                                    <MudToggleItem Value="true"><MudText Align="Align.Center">@dataElement.Name</MudText></MudToggleItem>
                                                </MudToggleGroup>
                                            </MudItem>
                                        }
                                    </MudGrid>
                                </ChildContent>
                            </MudExpansionPanel>
                        }
                        @if (dataElementsGrouped == null || dataElementsGrouped.Count == 0)
                        {
                            for (int placeholderCount = 0; placeholderCount < 5; placeholderCount++)
                            {
                                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Animation="Animation.Wave" Height="60px" Class="mb-2" />
                            }
                        }
                    </MudExpansionPanels>
                </MudCardContent>
            </MudCard>
        </MudItem>
    }
    <MudItem md="12" lg="@(RenderSideBySide && configuration.EnableUserInput ? 6 : 12)">
        <MudText Typo="Typo.h4">Readiness for Essential Questions</MudText>
        @if (scoredQuestions != null)
        {
            <MudText class="mb-5" Typo="Typo.body1">The E-W Framework Essential Questions are listed below with scores assigned based on data availability.</MudText>
            @* <MudAlert Class="mb-10" Severity="MudBlazor.Severity.Warning">This application is in an experimental phase, and while it is based on the E-W Framework, the data and calculations included should be verified against the official resources provided by the framework. The scores and insights generated by this application are intended for preliminary guidance only and should not be considered final or authoritative. Users are encouraged to cross-reference with the official E-W Framework documentation to ensure accuracy and completeness.</MudAlert> *@

            <MudGrid>
                @foreach (var questionScore in scoredQuestions)
                {
                    <MudItem lg="12">
                        <ScoredQuestion T="DataElementDataItem" QuestionWithScore="questionScore" />
                    </MudItem>
                }
            </MudGrid>
        }
    </MudItem>
</MudGrid>


@code {
    private List<EssentialQuestionWithIndicators>? essentialQuestions;
    private List<DataElementDataItem> dataElements = new List<DataElementDataItem>();
    private Dictionary<string, List<DataElementDataItem>> dataElementsGrouped = new Dictionary<string, List<DataElementDataItem>>();
    private HashSet<DataElementDataItem> selectedData = new HashSet<DataElementDataItem>();

    private const string PREVIOUS_STATE_LOCAL_STORAGE_KEY = "selected-data-dataelements";

    private List<QuestionWithScore<DataElementDataItem>>? scoredQuestions;

    private MudExpansionPanels? panels;

    private bool RenderSideBySide = true;

    private MultiStageProgressReport? scoringProgress;
    // Ed-Fi Database and API take longer, so when these are enabled, calculation must be triggered manually
    private bool calculateAutomatically => configuration.EnableUserInput && !configuration.EnableEdFiDatabase && !configuration.EnableEdFiApi && !configuration.EnableCedsDW;
    private bool isCalculating = false;

    // Data Availability Providers configuration
    private MudForm? form;
    private DataElementProviderConfigurationModel configuration = new();
    private DataElementProviderConfigurationValidator validator = new();

    private bool databaseOptionsDisabled = false;

    protected override async Task OnInitializedAsync()
    {
        databaseOptionsDisabled = !Configuration.GetValue<bool>("EnableDatabaseAvailabilityProvider");
        essentialQuestions = await EwFrameworkService.GetEssentialQuestionWithIndicatorsAsync();
        dataElements = (await EwFrameworkService.GetDataElementsAsync()).Select(x => new DataElementDataItem { DataElement = x }).ToList();
        dataElementsGrouped = dataElements.GroupBy(de => de.DataElement.Category)
            .ToDictionary(g => g.Key, g => g.ToList())
            .OrderBy(x => x.Key).ToDictionary();
        try
        {
            selectedData = await LocalStorage.GetItemAsync<HashSet<DataElementDataItem>>(PREVIOUS_STATE_LOCAL_STORAGE_KEY) ?? new();
        }
        catch (Exception)
        {

        }
        await Task.Run(() => CalculateScores());
    }

    private async Task OnAvailableDataSelected(DataElementDataItem item, bool selected)
    {
        if (selected)
        {
            selectedData.Add(item);
        }
        else
        {
            selectedData.Remove(item);
        }

        // Fire and forget for responsiveness
        if (calculateAutomatically)
        {
            await Task.Run(() => CalculateScores());
        }
    }

    private async Task CalculateScores()
    {
        try
        {
            isCalculating = true;
            StateHasChanged();
            var progress = new Progress<MultiStageProgressReport>(report =>
            {
                Debounce(() =>
                {
                    scoringProgress = report;
                    StateHasChanged();
                });
            });

            var dataAvailabilityProviders = new List<IDataAvailabilityProvider<DataElementDataItem>>();

            if (configuration.EnableUserInput)
            {
                var userInputProvider = new UserInputDataItemProvider<DataElementDataItem>(selectedData.ToList());
                dataAvailabilityProviders.Add(userInputProvider);
            }

            if (configuration.EnableEdFiDatabase)
            {
                throw new NotImplementedException("Asynchronous database scoring not yet implemented.");
            }

            if (configuration.EnableCedsDW)
            {
                throw new NotImplementedException("Asynchronous database scoring not yet implemented.");
            }

            if (configuration.EnableEdFiApi)
            {
                if (configuration.EdFiApiBaseUrl == null)
                {
                    throw new ArgumentNullException(nameof(configuration.EdFiApiBaseUrl));
                }
                var edFiApiProvider = new EdFiApiDataItemAvailabilityProvider(Http, Cache, configuration.EdFiApiBaseUrl, clientId: configuration.EdFiApiClientId, clientSecret: configuration.EdFiApiClientSecret, tempAccessToken: configuration.EdFiApiTemporaryAccessToken);
                dataAvailabilityProviders.Add(edFiApiProvider);
            }

            var dataRequirementsProvider = new DataElementIndicatorDataRequirementsProvider(dataElements.Select(x => x.DataElement).ToList());
            scoredQuestions = await QuestionScoringService.CalculateScoresForAvailableDataAsync(dataRequirementsProvider, dataAvailabilityProviders, progress);
            StateHasChanged();
            await LocalStorage.SetItemAsync(PREVIOUS_STATE_LOCAL_STORAGE_KEY, selectedData);
        }
        finally
        {
            isCalculating = false;
        }
    }

    private CancellationTokenSource stateChangeDebounceCts = new CancellationTokenSource();

    private void Debounce(Action action, int delayMs = 50)
    {
        stateChangeDebounceCts.Cancel();
        stateChangeDebounceCts = new CancellationTokenSource();

        Task.Run(async () =>
        {
            try
            {
                await Task.Delay(delayMs, stateChangeDebounceCts.Token);
                action();
            }
            catch (TaskCanceledException)
            {
                // Task was canceled, do nothing
            }
        });
    }

    private async Task OpenProviderDetails(string providerName)
    {
        var dataItemAvailabilities = GetDataElementAvailabilityForProvider(providerName);

        var parameters = new DialogParameters
            {
                ["DataItemAvailabilities"] = dataItemAvailabilities,
                ["ProviderName"] = providerName
            };

        var options = new DialogOptions
            {
                MaxWidth = MaxWidth.ExtraLarge,
                FullWidth = true
            };

        await DialogService.ShowAsync<DataAvailabilityProviderDetailsDialog>("Data Availability Details", parameters, options);
    }

    private List<(DataElementDataItem DataItem, DataAvailabilityCheckResult DataAvailability)> GetDataElementAvailabilityForProvider(string providerName)
    {
        var results = new Dictionary<string, (DataElementDataItem DataItem, DataAvailabilityCheckResult DataAvailability)>();

        if (scoredQuestions == null)
        {
            return new List<(DataElementDataItem DataItem, DataAvailabilityCheckResult DataAvailability)>();
        }

        foreach (var question in scoredQuestions)
        {
            foreach (var indicator in question.Indicators)
            {
                foreach (var dataAvailabilityResult in indicator.DataAvailabilityResults.Values)
                {
                    var dataItem = dataAvailabilityResult.DataItem;
                    var dataItemName = dataItem.Name;

                    var providerDataDetails = dataAvailabilityResult.ProviderResults.FirstOrDefault(p => p.ProviderName == providerName);

                    if (providerDataDetails != null)
                    {
                        // Deduplicate based on data item name
                        if (!results.ContainsKey(dataItemName))
                        {
                            results[dataItemName] = (dataItem, providerDataDetails.DataAvailability);
                        }
                    }
                }
            }
        }

        // Sort the results
        var sortedResults = results.Values
            .OrderBy(info => GetStatusOrder(info.DataAvailability.Status))
            .ThenBy(info => info.DataItem.Name)
            .ToList();

        return sortedResults;
    }

    private int GetStatusOrder(DataAvailabilityStatus status)
    {
        return status switch
        {
            DataAvailabilityStatus.DataAvailable => 0,
            DataAvailabilityStatus.DataUnavailable => 1,
            DataAvailabilityStatus.NotSupported => 2,
            _ => 3
        };
    }

    private void SetDemoApiValues()
    {
        configuration.EdFiApiBaseUrl = Configuration["DemoEdFiApiBaseUrl"];
        configuration.EdFiApiClientId = Configuration["DemoEdFiApiClientId"];
        configuration.EdFiApiClientSecret = Configuration["DemoEdFiApiClientSecret"];
    }

}
