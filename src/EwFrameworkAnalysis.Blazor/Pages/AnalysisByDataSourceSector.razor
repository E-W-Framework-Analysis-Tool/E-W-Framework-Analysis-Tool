@page "/by-data-source"
@using Blazored.LocalStorage
@using MudBlazor
@using EwFrameworkAnalysis.Blazor.Components
@using EwFrameworkAnalysis.Blazor.Models
@using EwFrameworkAnalysis.Common.Models
@using EwFrameworkAnalysis.Blazor.Services
@using EwFrameworkAnalysis.Blazor.Services.DataAvailability
@inject EwFrameworkService EwFrameworkService
@inject QuestionScoringService QuestionScoringService
@inject ILocalStorageService LocalStorage

<MudText Typo="Typo.h4">Data Inventory</MudText>

<MudGrid>
    <MudItem xs="8">
        <MudText Typo="Typo.body1">Indicate which data elements you have by sector available below.</MudText>
    </MudItem>

    <MudItem xs="4" Class="d-flex justify-end">
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="async () => { selectedData = DataSelectionDictionaryDefault; await RefreshScores(); StateHasChanged(); }">Clear all selections</MudButton>
    </MudItem>
</MudGrid>

<div class="mb-2 text-center">
    <small class="text-muted">
        <span class="mx-2"><strong>PK</strong> - Pre-Kindergarten</span> |
        <span class="mx-2"><strong>K12</strong> - Kindergarten through 12th Grade</span> |
        <span class="mx-2"><strong>PS</strong> - Post-Secondary Education</span> |
        <span class="mx-2"><strong>WF</strong> - Workforce</span>
    </small>
</div>

<MudGrid>
    @foreach (var dataSource in dataSources)
    {
        <MudItem sm="3">
            <MudCard Elevation="2">
                @if (selectedData.ContainsKey(dataSource))
                {
                    <MudCardHeader>
                        <CardHeaderContent>@dataSource</CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudStack>
                            <MudToggleGroup T="Sector" SelectionMode="SelectionMode.MultiSelection" CheckMark Values="@selectedData[dataSource]" ValuesChanged="(sectors) => OnAvailableDataSelected(dataSource, sectors)">
                                @foreach (var sector in sectors)
                                {
                                    <MudToggleItem T="Sector" Value="@sector">
                                        @sector
                                    </MudToggleItem>
                                }
                            </MudToggleGroup>
                        </MudStack>
                    </MudCardContent>
                }
                else
                {
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudSkeleton Animation="Animation.Wave" />
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudSkeleton Animation="Animation.Wave" SkeletonType="SkeletonType.Rectangle" Height="50px" />
                    </MudCardContent>
                }
            </MudCard>
        </MudItem>
    }
</MudGrid>
@if (scoredQuestions != null)
{
    @* <MudAlert Severity="Severity.Warning" Class="mt-10">This application is in an experimental phase, and while it is based on the E-W Framework, the data and calculations included should be verified against the official resources provided by the framework. The scores and insights generated by this application are intended for preliminary guidance only and should not be considered final or authoritative. Users are encouraged to cross-reference with the official E-W Framework documentation to ensure accuracy and completeness.</MudAlert> *@
    <MudText Typo="Typo.h4" Class="mt-10">Readiness for Essential Questions</MudText>
    <MudText class="mb-5" Typo="Typo.body1">The E-W Framework Essential Questions are listed below with scores assigned based on data availability.</MudText>
    <MudGrid>
        @foreach (var questionScore in scoredQuestions)
        {
            <MudItem lg="12">
                <ScoredQuestion T="DataSourceSectorDataItem" QuestionWithScore="questionScore" />
            </MudItem>
        }
    </MudGrid>
}

@code {
    private List<EssentialQuestionWithIndicators>? essentialQuestions;
    private List<Sector> sectors = Enum.GetValues<Sector>().ToList();
    private List<DataSource> dataSources = Enum.GetValues<DataSource>().ToList();
    private Dictionary<DataSource, List<Sector>> selectedData = new();

    private const string PREVIOUS_STATE_LOCAL_STORAGE_KEY = "selected-data";

    private List<QuestionWithScore<DataSourceSectorDataItem>>? scoredQuestions;

    protected override async Task OnInitializedAsync()
    {
        essentialQuestions = await EwFrameworkService.GetEssentialQuestionWithIndicators();
        try
        {
            selectedData = await LocalStorage.GetItemAsync<Dictionary<DataSource, List<Sector>>>(PREVIOUS_STATE_LOCAL_STORAGE_KEY) ?? DataSelectionDictionaryDefault;
        }
        catch (Exception)
        {

        }
        await CalculateScores();
    }

    private Dictionary<DataSource, List<Sector>> DataSelectionDictionaryDefault => Enum.GetValues<DataSource>().ToDictionary(ds => ds, ds => new List<Sector>());

    private async Task RefreshScores()
    {
        await CalculateScores();
        await LocalStorage.SetItemAsync(PREVIOUS_STATE_LOCAL_STORAGE_KEY, selectedData);
    }

    private Task OnAvailableDataSelected(DataSource dataSource, IEnumerable<Sector> sectors)
    {
        selectedData[dataSource] = sectors.ToList();
        // Fire and forget
        _ = RefreshScores();

        return Task.CompletedTask;
    }

    // Calculate scores based on the selected data sources
    private async Task CalculateScores()
    {
        var selectedDataItems = selectedData.SelectMany(kv => kv.Value.Select(sector => new DataSourceSectorDataItem { DataSource = kv.Key, Sector = sector })).ToList();
        var dataAvailability = new UserInputDataItemProvider<DataSourceSectorDataItem>(selectedDataItems);
        var dataRequirementProvider = new DataSourceSectorIndicatorDataRequirementsProvider();
        scoredQuestions = (await QuestionScoringService.CalculateScoresForAvailableData(dataRequirementProvider, new List<IDataAvailabilityProvider<DataSourceSectorDataItem>> { dataAvailability }));
        StateHasChanged();
    }
}
