@using EwFrameworkAnalysis.Common.Models
@using MudBlazor
@typeparam T where T : IScorableDataItem
@inject IDialogService DialogService
<MudExpansionPanels Elevation="3">
    <MudExpansionPanel>
        <TitleContent>
            <div class="d-flex align-center justify-space-between">
                <MudText Typo="Typo.h5">@QuestionWithScore.Question</MudText>
            </div>
            <div class="d-flex align-center">
                <MudProgressLinear class="mt-4 flex-grow-1" 
                                  Color="GetProgressBarColor(QuestionWithScore.Score)" 
                                  Rounded 
                                  Value="@((double)QuestionWithScore.Score * 100)" 
                                  Size="Size.Large">@QuestionWithScore.Score.ToString("0.##%")</MudProgressLinear>
            </div>
        </TitleContent>
        <ChildContent>
            <div class="mt-4">
                <MudText Typo="Typo.h5">Indicators</MudText>
                <MudGrid Class="mt-4">
                    @foreach (var indicator in QuestionWithScore.Indicators)
                    {
                        <MudItem md="6" Class="pt-2 pb-2 cursor-pointer">
                            <MudPaper Elevation="6" @onclick="() => OpenIndicatorDetailsAsync(indicator)">
                                <div class="d-flex align-center justify-space-between p-2">
                                    <MudText Typo="Typo.h6">
                                        @indicator.Indicator.Name (@((indicator.Score).ToString("0.##%")))
                                    </MudText>
                                </div>
                                <div class="d-flex align-center">
                                    <MudProgressLinear Class="flex-grow-1" 
                                                       Color="GetProgressBarColor(indicator.Score)" 
                                                       Rounded 
                                                       Value="@((double)indicator.Score * 100)" 
                                                       Size="Size.Medium" />
                                </div>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            </div>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>

@code {
    [Parameter, EditorRequired] public required QuestionWithScore<T> QuestionWithScore { get; set; }
    
    // Mock data for average scores and completion rates
    private Dictionary<string, decimal> IndicatorAverages { get; set; } = new Dictionary<string, decimal>();
    private Dictionary<string, int> IndicatorCompletionCounts { get; set; } = new Dictionary<string, int>();
    private int _indicatorTotalResponses = 63;
    
    protected override void OnInitialized()
    {
        base.OnInitialized();
    }

    private Color GetProgressBarColor(decimal score)
    {
        // Red (low score) to Green (high score) gradient
        if (score < 0.33m)
            return Color.Error;
        else if (score < 0.66m)
            return Color.Warning;
        else
            return Color.Primary;
    }
    
    private string GetComparisonIndicator(decimal userScore, decimal averageScore)
    {
        decimal difference = userScore - averageScore;
        
        if (difference > 0.1m)
            return "↑";
        else if (difference < -0.1m)
            return "↓";
        else
            return "≈";
    }
    
    private Color GetComparisonColor(decimal userScore, decimal averageScore)
    {
        decimal difference = userScore - averageScore;
        
        if (difference > 0.1m)
            return Color.Success;
        else if (difference < -0.1m)
            return Color.Error;
        else
            return Color.Default;
    }
    
    private string GetScoreComparisonText(decimal userScore, decimal averageScore)
    {
        decimal difference = userScore - averageScore;
        
        // Prevent division by zero
        decimal percentDifference = averageScore > 0 
            ? Math.Abs(difference / averageScore) * 100 
            : 0;
        
        if (difference > 0.1m)
            return $"Your score is {percentDifference:0}% above average";
        else if (difference < -0.1m)
            return $"Your score is {percentDifference:0}% below average";
        else
            return "Your score is about average";
    }

    private async Task OpenIndicatorDetailsAsync(IndicatorWithScore<T> indicator)
    {
        var parameters = new DialogParameters<IndicatorDetailsDialog<T>> 
        { 
            { x => x.Indicator, indicator }
        };
        await DialogService.ShowAsync<IndicatorDetailsDialog<T>>(indicator.Indicator.Name, parameters);
    }

    private int GetCompletionCountForIndicator(IndicatorWithScore<T> indicator)
    {
        // Always check and initialize the dictionary if needed to ensure stability
        if (!IndicatorCompletionCounts.ContainsKey(indicator.Indicator.Name))
        {
            Random random = new Random();
            IndicatorCompletionCounts[indicator.Indicator.Name] = random.Next(10, _indicatorTotalResponses - 8);
        }

        return IndicatorCompletionCounts[indicator.Indicator.Name];
    }
}
