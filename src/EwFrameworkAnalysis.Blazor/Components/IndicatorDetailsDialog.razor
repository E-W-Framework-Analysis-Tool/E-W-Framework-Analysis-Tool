@using EwFrameworkAnalysis.Common.Models
@using EwFrameworkAnalysis.Blazor.Models
@using MudBlazor
@using System.Text.Json

@typeparam T where T : IScorableDataItem

<MudDialog Options="new DialogOptions { FullWidth = true }">
    <TitleContent>
        <MudText Typo="Typo.h4">@Indicator.Indicator.Name</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudText>@Indicator.Indicator.Definition</MudText>
            <MudText>Domain: @Indicator.Indicator.Domain</MudText>
            <MudText>Indicator Type: @Indicator.Indicator.Type</MudText>

            <MudDivider></MudDivider>
            <MudText Typo="Typo.h5">Data availability score</MudText>
            <MudProgressLinear class="mt-4" Color="GetProgressBarColor(Indicator.Score)" Rounded Value="@((double)Indicator.Score * 100)" Size="Size.Large" />
            <MudText Align="Align.Center">@Indicator.Score.ToString("0.##%")</MudText>
            <MudStack Spacing="2">
                @foreach (var t in Indicator.DataAvailabilityResults)
                {
                    if (t.Value.IsAvailable)
                    {
                        <MudTooltip Text="@($"Available from: {string.Join(", ", t.Value.ProviderResults.Where(r => r.DataAvailability.Status == DataAvailabilityStatus.DataAvailable).Select(r => r.ProviderName))}")">
                            <MudStack Row>
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" />
                                <MudText>@t.Key</MudText>
                            </MudStack>
                        </MudTooltip>
                    }
                    else
                    {
                        <MudStack Row>
                            <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" />
                            <MudText>@t.Key</MudText>
                        </MudStack>
                    }
                }
            </MudStack>
            @*             <MudChipSet T="Tuple<Sector, DataSource>" SelectionMode="SelectionMode.MultiSelection" CheckMark>
            @foreach (var t in Indicator.DataAvailabilityResults)
            {
            if (t.Value.IsAvailable)
            {
            <MudTooltip Text="@($"Available from: {string.Join(", ", t.Value.ProviderResults.Where(r => r.DataAvailability.Status == DataAvailabilityStatus.DataAvailable).Select(r => r.ProviderName))}")">
            <MudChip Variant="Variant.Text" Color="Color.Primary" Selected="t.Value.IsAvailable" Value="t.Value.IsAvailable">@t.Key</MudChip>
            </MudTooltip>
            }
            else
            {
            <MudChip Variant="Variant.Text" Color="Color.Primary" Selected="t.Value.IsAvailable" Value="t.Value.IsAvailable">@t.Key</MudChip>
            }
            }
            </MudChipSet> *@

            <MudDivider></MudDivider>
            <MudExpansionPanel Gutters="false">
                <TitleContent>
                    <MudText Typo="Typo.h5">Additional Details</MudText>
                </TitleContent>
                <ChildContent>
                    <MudStack>
                        <MudText Typo="Typo.h6">Significance</MudText>
                        <MudText>@Indicator.Indicator.Significance</MudText>

                        <MudText Typo="Typo.h6">Recommended Metrics</MudText>
                        <MudText>@Indicator.Indicator.RecommendedMetrics</MudText>

                        <MudText Typo="Typo.h6">Measurement Notes</MudText>
                        <MudText>@Indicator.Indicator.MeasurementNotes</MudText>

                        <MudText Typo="Typo.h6">Source Frameworks</MudText>
                        <MudText>@Indicator.Indicator.SourceFrameworks</MudText>
                    </MudStack>
                </ChildContent>
            </MudExpansionPanel>

        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Color="Color.Primary">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public required IMudDialogInstance MudDialog { get; set; }
    [Parameter, EditorRequired] public required IndicatorWithScore<T> Indicator { get; set; }

    private void Close() => MudDialog.Close();

    // TODO: Duplicated with ScoredQuestion component
    private Color GetProgressBarColor(decimal score)
    {
        // Red (low score) to Green (high score) gradient
        if (score < 0.33m)
            return Color.Error;
        else if (score < 0.66m)
            return Color.Warning;
        else
            return Color.Primary;
    }
}
