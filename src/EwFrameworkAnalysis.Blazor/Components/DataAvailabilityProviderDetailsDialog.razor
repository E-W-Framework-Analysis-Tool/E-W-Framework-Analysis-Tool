@using MudBlazor
@using EwFrameworkAnalysis.Blazor.Models
@using EwFrameworkAnalysis.Common.Models

<MudDialog>
    <TitleContent>Data Availability Details for @ProviderName</TitleContent>
    <DialogContent>
        @if (DataItemAvailabilities != null && DataItemAvailabilities.Any())
        {
            <MudTable Items="DataItemAvailabilities" Hover="true" Bordered="true" Striped="true">
                <HeaderContent>
                    <MudTh>Data Element</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Total Count</MudTh>
                    <MudTh>Remarks</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.DataItem.Name</MudTd>
                    <MudTd>
                        @switch (context.DataAvailability.Status)
                        {
                            case DataAvailabilityStatus.DataAvailable:
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" />
                                break;
                            case DataAvailabilityStatus.DataUnavailable:
                                <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" />
                                break;
                            case DataAvailabilityStatus.NotSupported:
                                <MudText>N/A</MudText>
                                break;
                            default:
                                <MudText>N/A</MudText>
                                break;
                        }
                    </MudTd>
                    <MudTd>@(context.DataAvailability.TotalCount?.ToString() ?? "")</MudTd>
                    <MudTd>@(context.DataAvailability.Status == DataAvailabilityStatus.NotSupported ? "Data element or availability check not supported in this provider" : context.DataAvailability.Remarks)</MudTd>
                </RowTemplate>
            </MudTable>
        }
        else
        {
            <MudText>No data availability results found for this provider.</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public required IMudDialogInstance MudDialog { get; set; }
    [Parameter, EditorRequired] public required List<(DataElementDataItem DataItem, DataAvailabilityCheckResult DataAvailability)> DataItemAvailabilities { get; set; }
    [Parameter, EditorRequired] public required string ProviderName { get; set; }

    private void Close()
    {
        MudDialog.Close();
    }
}
