@*
    Modal.razor

    COMMON CASE — use props, ModalHeader is rendered internally:
        <Modal IsOpen="@_open" IsOpenChanged="v => _open = v"
               Title="Import Data Sources"
               Icon="fa-file-import"
               Subtitle="Select the data sources you want to import.">
            <Body>...</Body>
            <Footer>...</Footer>
        </Modal>

    ESCAPE HATCH — provide <Header> to fully override (props ignored):
        <Modal IsOpen="@_open" IsOpenChanged="v => _open = v">
            <Header>
                <ModalHeader Title="..." Icon="..." />
                <SomeExtraWidget />
            </Header>
            <Body>...</Body>
        </Modal>
*@

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4"
         role="dialog"
         aria-modal="true">

        <!-- Backdrop -->
        <div class="absolute inset-0 bg-black/40 backdrop-blur-sm transition-opacity"
             @onclick="OnBackdropClick"
             aria-hidden="true" />

        <!-- Panel -->
        <div class="relative flex flex-col w-full @(ExtraWide ? "max-w-5xl" : Wide ? "max-w-4xl" : "max-w-lg")
            bg-white rounded-2xl shadow-2xl ring-1 ring-black/10 max-h-[90vh]">

            <!-- Header row — rendered if props supplied OR Header fragment provided -->
            @if (Header != null || Title != null || ShowCloseButton)
            {
                <div class="flex-shrink-0 px-6 pt-6 pb-2">
                    <div class="flex items-start gap-4">
                        <div class="flex-1 min-w-0">
                            @if (Header != null)
                            {
                                @Header
                            }
                            else if (Title != null)
                            {
                                <ModalHeader Title="@Title" Icon="@Icon" Subtitle="@Subtitle" />
                            }
                        </div>
                        @if (ShowCloseButton)
                        {
                            <button class="ml-auto flex-shrink-0 flex h-8 w-8 items-center justify-center
                                rounded-full text-gray-400 hover:bg-gray-100 hover:text-gray-600
                                transition-colors focus:outline-none focus:ring-2 focus:ring-blue"
                                    @onclick="Close"
                                    aria-label="Close">
                                <i class="fas fa-times text-sm"></i>
                            </button>
                        }
                    </div>
                </div>
            }

            <!-- Body (scrollable) -->
            <div class="flex-1 overflow-y-auto px-6 py-4 min-h-0">
                @Body
            </div>

            <!-- Footer -->
            @if (Footer != null)
            {
                <div class="flex-shrink-0 bg-gray-50/80 px-6 py-4 rounded-b-2xl border-t border-gray-100">
                    @Footer
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    // --- Convenience props (shorthand for ModalHeader) ---
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? Subtitle { get; set; }

    // --- Fragments ---
    /// <summary>Overrides Title/Icon/Subtitle when provided. Use ModalHeader inside for consistent styling.</summary>
    [Parameter] public RenderFragment? Header { get; set; }
    [Parameter] public RenderFragment? Body { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }

    [Parameter] public bool ShowCloseButton { get; set; } = true;
    [Parameter] public bool CloseOnBackdrop { get; set; } = true;
    [Parameter] public bool Wide { get; set; } = false;
    [Parameter] public bool ExtraWide { get; set; } = false;
    [Parameter] public EventCallback CloseRequested { get; set; }

    private async Task Close()
    {
        await CloseRequested.InvokeAsync();
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task OnBackdropClick()
    {
        if (CloseOnBackdrop)
            await Close();
    }
}
