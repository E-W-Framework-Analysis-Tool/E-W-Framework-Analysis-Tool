@if (_isEditing)
{
    <!-- Edit Mode -->
    <div class="flex items-start gap-2">
        @if (Multiline)
        {
            <textarea @bind="_editedValue"
                      @bind:event="oninput"
                      @onkeydown="HandleKeyDown"
                      class="@GetEditInputClasses()"
                      placeholder="@Placeholder"
                      rows="@Rows"
                      autofocus></textarea>
        }
        else
        {
            <input type="text"
                   @bind="_editedValue"
                   @bind:event="oninput"
                   @onkeydown="HandleKeyDown"
                   class="@GetEditInputClasses()"
                   placeholder="@Placeholder"
                   autofocus />
        }
        <div class="flex flex-col gap-1 flex-shrink-0 pt-1">
            <button @onclick="SaveEdit"
                    class="text-green hover:text-green-700 transition-colors"
                    title="Save">
                <i class="fas fa-check @GetIconSize()"></i>
            </button>
            <button @onclick="CancelEdit"
                    class="text-red-500 hover:text-red-700 transition-colors"
                    title="Cancel">
                <i class="fas fa-times @GetIconSize()"></i>
            </button>
        </div>
    </div>
}
else
{
    <!-- View Mode -->
    @if (string.IsNullOrWhiteSpace(Value))
    {
        <!-- Empty State — tappable -->
        <button @onclick="StartEdit" class="text-sm text-blue hover:text-yellow transition-colors">
            <i class="fas fa-plus mr-1"></i>@EmptyStateText
        </button>
    }
    else
    {
        <!-- Has Value -->
        <div class="@GetViewContainerClasses()">
            @if (Variant == FieldVariant.Title)
            {
                <h2 class="text-xl sm:text-2xl font-title font-bold text-blue break-words min-w-0">@Value</h2>
            }
            else if (Variant == FieldVariant.Subtitle)
            {
                <h3 class="text-lg font-title font-semibold text-blue break-words min-w-0">@Value</h3>
            }
            else
            {
                <p class="text-sm text-gray break-words min-w-0 @(Multiline ? "whitespace-pre-wrap" : "")">@Value</p>
            }
            <button @onclick="StartEdit"
                    class="text-gray hover:text-blue transition-colors flex-shrink-0"
                    title="Edit">
                <i class="fas fa-edit @GetIconSize()"></i>
            </button>
        </div>
    }
}

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Enter value";
    [Parameter] public string EmptyStateText { get; set; } = "Add description";
    [Parameter] public bool Multiline { get; set; } = false;
    [Parameter] public int Rows { get; set; } = 3;
    [Parameter] public FieldVariant Variant { get; set; } = FieldVariant.Text;
    [Parameter] public EventCallback<string?> OnSave { get; set; }

    private bool _isEditing = false;
    private string _editedValue = "";

    private void StartEdit()
    {
        _editedValue = Value ?? "";
        _isEditing = true;
    }

    private async Task SaveEdit()
    {
        var trimmedValue = _editedValue?.Trim();
        if (trimmedValue != Value)
        {
            await OnSave.InvokeAsync(string.IsNullOrWhiteSpace(trimmedValue) ? null : trimmedValue);
        }
        _isEditing = false;
    }

    private void CancelEdit()
    {
        _isEditing = false;
        _editedValue = "";
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && (!Multiline || e.CtrlKey))
        {
            await SaveEdit();
        }
        else if (e.Key == "Escape")
        {
            CancelEdit();
        }
    }

    private string GetEditInputClasses()
    {
        var baseClasses = Multiline
            ? "flex-1 w-full text-sm text-gray bg-transparent border border-gray-300 rounded px-2 py-1 focus:outline-none focus:border-blue transition-colors resize-none"
            : "flex-1 w-full bg-transparent border-b-2 border-blue focus:outline-none focus:border-yellow transition-colors";

        var sizeClasses = Variant switch
        {
            FieldVariant.Title => "text-xl sm:text-2xl font-title font-bold text-blue",
            FieldVariant.Subtitle => "text-lg font-title font-semibold text-blue",
            _ => "text-sm text-gray"
        };

        return $"{baseClasses} {sizeClasses}";
    }

    private string GetViewContainerClasses()
    {
        return Multiline ? "w-full" : "flex items-center gap-2";
    }

    private string GetIconSize()
    {
        return Variant == FieldVariant.Title ? "text-lg" : "";
    }

    public enum FieldVariant
    {
        Title,
        Subtitle,
        Text
    }
}
