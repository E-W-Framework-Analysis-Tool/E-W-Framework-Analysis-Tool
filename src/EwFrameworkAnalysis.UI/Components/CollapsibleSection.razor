@*
    Variants:
      Block   — rounded card with background (existing style, default)
      Divider — clean horizontal rule only, no card chrome
*@

<div class="@ContainerClass @AdditionalClasses" @attributes="AdditionalAttributes">
    <input type="checkbox" class="peer"
           checked="@IsExpanded"
           @onchange="OnToggle"
           aria-label="@(AriaLabel ?? Title ?? "Toggle section")" />

    <div class="collapse-title @ResolvedTitleClasses">
        @if (TitleContent != null)
        {
            @TitleContent
        }
        else
        {
            @Title
        }
    </div>
    <div class="collapse-content">
        @ChildContent
    </div>
</div>

@code {
    public enum SectionVariant { Block, Divider }

    /// <summary>
    /// The content to display inside the collapsible section
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Simple string title (alternative to TitleContent)
    /// </summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>
    /// Custom title content (alternative to Title)
    /// </summary>
    [Parameter]
    public RenderFragment? TitleContent { get; set; }

    [Parameter]
    public string? AriaLabel { get; set; }

    /// <summary>
    /// Whether the section starts expanded
    /// </summary>
    [Parameter]
    public bool IsExpanded { get; set; } = false;

    /// <summary>
    /// Callback when expansion state changes
    /// </summary>
    [Parameter]
    public EventCallback<bool> IsExpandedChanged { get; set; }

    /// <summary>Overrides title classes entirely when provided.</summary>
    [Parameter] public string? TitleClasses { get; set; }

    /// <summary>
    /// Additional CSS classes for positioning, spacing, etc.
    /// </summary>
    [Parameter]
    public string AdditionalClasses { get; set; } = "";

    /// <summary>
    /// Style to use.
    /// </summary>
    [Parameter] public SectionVariant Variant { get; set; } = SectionVariant.Block;

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string ContainerClass => Variant switch
    {
        SectionVariant.Divider => "collapse collapse-arrow border-b border-gray-200 rounded-none",
        _ => "collapse collapse-arrow bg-white border border-gray-200 rounded"
    };

    private string ResolvedTitleClasses => TitleClasses ?? Variant switch
    {
        SectionVariant.Divider => "font-semibold text-blue text-lg py-5 px-0",
        _ => "text-sm font-medium text-blue"
    };

    private async Task OnToggle(ChangeEventArgs e)
    {
        if (e.Value is bool newValue)
        {
            IsExpanded = newValue;
            await IsExpandedChanged.InvokeAsync(IsExpanded);
        }
    }
}
