<div class="@GetCardClasses()" style="@GetCardStyle()" @attributes="AdditionalAttributes">
    @if (!string.IsNullOrWhiteSpace(Title))
    {
        <div class="@GetHeaderClasses()">
            <div class="flex items-center justify-between">
                <h3 class="text-lg font-title font-semibold text-blue">@Title</h3>
                @HeaderActions
            </div>
        </div>
    }
    <div class="@GetBodyClasses()">
        @ChildContent
    </div>
</div>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? HeaderActions { get; set; }
    [Parameter] public string AdditionalClasses { get; set; } = string.Empty;
    [Parameter] public bool NoPadding { get; set; }
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    // Granular visual parameters
    [Parameter] public bool Overflow { get; set; }
    [Parameter] public bool Rounded { get; set; } = true;
    [Parameter] public AccentColor? Accent { get; set; }

    // Raised shadow depth — matches the loading indicator's "ledge" feel
    // Default gives the standard raised look; Flat removes it entirely
    [Parameter] public RaiseLevel Raise { get; set; } = RaiseLevel.Default;

    private string GetCardClasses()
    {
        var classes = new List<string> { "bg-white" };

        if (Overflow)
            classes.Add("overflow-hidden");

        if (Rounded)
            classes.Add("rounded-lg");

        if (Accent.HasValue)
        {
            classes.Add("border-l-4");
            classes.Add(Accent.Value switch
            {
                AccentColor.Blue => "border-blue",
                AccentColor.Green => "border-green",
                AccentColor.Yellow => "border-yellow",
                AccentColor.Red => "border-red",
                AccentColor.Tan => "border-tan",
                _ => "border-gray-400"
            });
        }

        classes.Add(AdditionalClasses);

        return string.Join(" ", classes.Where(c => !string.IsNullOrWhiteSpace(c)));
    }

    // Hard-offset shadow to mimic the loading indicator's raised/pressed blocks.
    // Layered: solid bottom ledge (gives the 3D lift) + diffuse drop shadow beneath.
    private string GetCardStyle()
    {
        var ledge = Raise switch
        {
            RaiseLevel.Flat => "none",
            RaiseLevel.Subtle => "0 2px 0 #d1d5db, 0 3px 6px rgba(0,0,0,0.10)",
            RaiseLevel.Default => "0 4px 0 #9ca3af, 0 5px 10px rgba(0,0,0,0.12)",
            RaiseLevel.High => "0 6px 0 #9ca3af, 0 8px 14px rgba(0,0,0,0.14)",
            _ => "0 4px 0 #9ca3af, 0 5px 10px rgba(0,0,0,0.12)"
        };

        return $"box-shadow: {ledge};";
    }

    private string GetHeaderClasses()
        => NoPadding ? "px-4 py-5 sm:p-6" : "px-4 py-5 sm:p-6 pb-0";

    private string GetBodyClasses()
        => NoPadding ? "" : "p-5";

    public enum RaiseLevel
    {
        Flat,
        Subtle,
        Default,
        High
    }

    public enum AccentColor
    {
        Gray,
        Blue,
        Green,
        Yellow,
        Red,
        Tan
    }
}
