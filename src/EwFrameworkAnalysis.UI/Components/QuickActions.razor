
<div class="card shadow-sm rounded-lg">
    <div class="card-body">
        <h2 class="font-title font-semibold text-lg mb-4">Quick Actions</h2>

        <!-- Generate Report -->
        <div class="flex items-center mb-2">
            <button class="btn btn-ghost bg-white hover:border-gray-300">
                <i class="fa-solid fa-file-pdf text-red-700 mr-2"></i>
                Generate Report
            </button>
        </div>

        <!-- View Benchmarks -->
        <div class="flex items-center mb-2">
            <button class="btn btn-ghost bg-white hover:border-gray-300">
                <i class="fa-solid fa-chart-bar text-secondary mr-2"></i>
                View Benchmarks
            </button>
        </div>

        <!-- Export Report -->
        <div class="flex items-center mb-2">
            <button class="btn btn-ghost bg-white hover:border-gray-300">
                <i class="fa-solid fa-download text-secondary mr-2"></i>
                Export Report
            </button>
        </div>

    </div>
</div>
