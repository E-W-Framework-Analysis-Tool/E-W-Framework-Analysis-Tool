@using EwFrameworkAnalysis.UI.Components

<Card Variant="Card.CardVariant.Overflow" AdditionalClasses="@AdditionalClasses" NoPadding="true">
    <ChildContent>
        <div class="px-4 py-5 sm:p-6">
            <div class="flex items-start justify-between gap-4">
                <!-- Left: Title and Description -->
                <div class="flex-1 min-w-0 space-y-1">
                    @if (_isEditing)
                    {
                        <!-- Editing Mode -->
                        <div class="space-y-3">
                            <!-- Title Input -->
                            <div class="flex items-center gap-2">
                                <input type="text"
                                       @bind="_editedTitle"
                                       @bind:event="oninput"
                                       @onkeydown="HandleKeyDown"
                                       class="flex-1 text-2xl font-title font-bold text-blue bg-transparent border-b-2 border-blue focus:outline-none focus:border-yellow transition-colors"
                                       placeholder="@TitlePlaceholder"
                                       autofocus />
                                <button @onclick="SaveEdit"
                                        class="text-green hover:text-green-700 transition-colors flex-shrink-0"
                                        title="Save">
                                    <i class="fas fa-check text-lg"></i>
                                </button>
                                <button @onclick="CancelEdit"
                                        class="text-red-500 hover:text-red-700 transition-colors flex-shrink-0"
                                        title="Cancel">
                                    <i class="fas fa-times text-lg"></i>
                                </button>
                            </div>

                            <!-- Description Input (Optional) -->
                            @if (AllowDescriptionEdit)
                            {
                                <div>
                                    <textarea @bind="_editedDescription"
                                              @bind:event="oninput"
                                              class="w-full text-sm text-gray bg-transparent border border-gray-300 rounded px-2 py-1 focus:outline-none focus:border-blue transition-colors"
                                              placeholder="@DescriptionPlaceholder"
                                              rows="2"></textarea>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <!-- View Mode -->
                        <div class="flex items-center gap-2">
                            <h2 class="text-2xl font-title font-bold text-blue truncate">@Title</h2>
                            <button @onclick="StartEdit"
                                    class="text-gray hover:text-blue transition-colors flex-shrink-0"
                                    title="Edit">
                                <i class="fas fa-edit"></i>
                            </button>
                        </div>

                        <!-- Subtitle/Metadata Line -->
                        @if (!string.IsNullOrWhiteSpace(Subtitle) || !string.IsNullOrWhiteSpace(Description))
                        {
                            <p class="text-sm text-gray">
                                @if (!string.IsNullOrWhiteSpace(Subtitle))
                                {
                                    @Subtitle
                                }
                                @if (!string.IsNullOrWhiteSpace(Description))
                                {
                                    @if (!string.IsNullOrWhiteSpace(Subtitle))
                                    {
                                        <span class="mx-2">•</span>
                                    }
                                    <span>@Description</span>
                                }
                            </p>
                        }
                    }
                </div>

                <!-- Right: Actions -->
                @if (Actions != null)
                {
                    <div class="flex items-center gap-3 flex-shrink-0">
                        @Actions
                    </div>
                }
            </div>
        </div>
    </ChildContent>
</Card>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string TitlePlaceholder { get; set; } = "Enter title";
    [Parameter] public string DescriptionPlaceholder { get; set; } = "Enter description (optional)";
    [Parameter] public bool AllowDescriptionEdit { get; set; } = false;
    [Parameter] public string AdditionalClasses { get; set; } = "mb-6";
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public EventCallback<(string title, string? description)> OnSave { get; set; }

    private bool _isEditing = false;
    private string _editedTitle = "";
    private string _editedDescription = "";

    private void StartEdit()
    {
        _editedTitle = Title ?? "";
        _editedDescription = Description ?? "";
        _isEditing = true;
    }

    private async Task SaveEdit()
    {
        if (string.IsNullOrWhiteSpace(_editedTitle))
        {
            // Don't save empty titles
            CancelEdit();
            return;
        }

        if (_editedTitle != Title || (AllowDescriptionEdit && _editedDescription != Description))
        {
            await OnSave.InvokeAsync((_editedTitle.Trim(),
                AllowDescriptionEdit ? _editedDescription?.Trim() : Description));
        }
        _isEditing = false;
    }

    private void CancelEdit()
    {
        _isEditing = false;
        _editedTitle = "";
        _editedDescription = "";
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SaveEdit();
        }
        else if (e.Key == "Escape")
        {
            CancelEdit();
        }
    }
}
