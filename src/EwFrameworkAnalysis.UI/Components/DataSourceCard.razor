@using EwFrameworkAnalysis.Common.Models.Project
@inject AnalysisProjectService ProjectSvc

<div class="card border border-gray-300 rounded-lg w-full mb-4 last:mb-0">
    <div class="card-body flex flex-col p-4">
        <div class="flex flex-row items-center justify-between">
            <!-- Left Section -->
            <div class="flex flex-row items-center gap-4">
                <!-- Icon -->
                <div class="flex w-12 h-12 bg-secondary/20 rounded-md justify-center items-center font-semibold">
                    <i class="@GetMethodIcon(DataSource.Type) text-xl"></i>
                </div>

                <!-- Name & Description -->
                <div>
                    <a href="@GetDataSourceDetailsLink()" class="font-semibold text-lg link link-hover">@DataSource.Name</a>
                    <p class="text-sm text-gray-500">@DataSource.Description</p>
                </div>
            </div>

            <!-- Right Section -->
            <div class="flex flex-col items-end gap-2">
                <!-- Status -->
                <div class="flex items-center gap-1 text-sm">
                    @if (!DataSource.Enabled)
                    {
                        <span class="badge border-none bg-red-700/20 text-red-700 font-semibold text-xs">
                            <i class="fa-solid fa-circle-xmark"></i> Disabled
                        </span>
                    }
                    else if (HasAssessments())
                    {
                        <span class="badge border-none bg-success/20 text-success font-semibold text-xs">
                            <i class="fa-solid fa-circle-check"></i> Active
                        </span>
                    }
                    else
                    {
                        <span class="badge border-none bg-yellow-600/20 text-yellow-600 font-semibold text-xs">
                            <i class="fa-solid fa-clock"></i> Pending
                        </span>
                    }

                    <div class="link p-2 text-black opacity-50 hover:opacity-80">
                        <i class="fa-solid fa-gear"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex flex-row items-center justify-between">
            <!-- Left Section -->
            <div class="flex flex-row items-center gap-4">
                <!-- Last Run -->
                <p class="text-xs text-gray-400 mt-1">@GetAssessmentSummary(DataSource)</p>
            </div>

            <!-- Right Section -->
            <div class="flex flex-col items-end gap-2">
                <!-- Actions -->
                <div class="flex gap-3 text-sm">
                    <a href="@GetDataSourceDetailsLink()" class="link link-hover font-semibold">Run Analysis</a>
                    <a href="@GetDataSourceDetailsLink()" class="link link-hover font-semibold">View Results</a>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    
    [Parameter]
    public required DataSource DataSource { get; set; }

    private string FormatLastRun(DateTime? lastRun)
    {
        if (lastRun == null) return "Never";

        var diff = DateTime.UtcNow - lastRun.Value.ToUniversalTime();

        if (diff.TotalSeconds < 60)
            return $"{Math.Floor(diff.TotalSeconds)} seconds ago";
        if (diff.TotalMinutes < 60)
            return $"{Math.Floor(diff.TotalMinutes)} minutes ago";
        if (diff.TotalHours < 24)
            return $"{Math.Floor(diff.TotalHours)} hours ago";
        if (diff.TotalDays < 7)
            return $"{Math.Floor(diff.TotalDays)} days ago";

        return lastRun.Value.ToString("MMM dd, yyyy HH:mm");
    }

    private string GetDataSourceDetailsLink()
    {
        return AppRoutes.DataSourceDetails.ForDataSource(DataSource.Id);
    }

    private string GetMethodIcon(DataSourceType type) =>
    type switch
    {        
        DataSourceType.EdFiApi => "fa-solid fa-gears text-secondary",
        DataSourceType.CedsDw => "fa-solid fa-warehouse text-secondary",
        DataSourceType.Custom => "fa-solid fa-list-check text-secondary",
        _ => "fa-solid fa-question text-gray-600"
    };

    private bool HasAssessments() => ProjectSvc.GetAssessmentsForDataSource(DataSource.Id).Any();

    private string GetAssessmentSummary(DataSource dataSource)
    {
        var assessments = ProjectSvc.GetAssessmentsForDataSource(dataSource.Id).ToList();

        if (!assessments.Any())
            return GetNeverRunSummary(dataSource.Type);

        var latest = assessments.OrderByDescending(a => a.ConductedAt).First();
        var timeAgo = GetTimeAgo(latest.ConductedAt);
        var elementCount = latest.DataElementAssessments?.Count ?? 0;

        return $"Last run: {timeAgo} | {elementCount} elements assessed";
    }

    private string GetNeverRunSummary(DataSourceType type) => type switch
    {
        DataSourceType.EdFiApi => "Never run • ~127 potential elements",
        DataSourceType.CedsDw => "Never run • Upload CSV results",
        DataSourceType.Custom => "Never run • Manual checklist items",
        _ => "Never run"
    };

    private string GetTimeAgo(DateTime dateTime)
    {
        var timeSpan = DateTime.UtcNow - dateTime;
        return timeSpan.TotalHours < 1 ? $"{(int)timeSpan.TotalMinutes} minutes ago"
             : timeSpan.TotalDays < 1 ? $"{(int)timeSpan.TotalHours} hours ago"
             : $"{(int)timeSpan.TotalDays} days ago";
    }
}
