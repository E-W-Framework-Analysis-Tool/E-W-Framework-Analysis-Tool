@using EwFrameworkAnalysis.Common.Models.Project

<div class="card shadow border border-gray-200">
    <div class="px-4 py-5 sm:p-6">
        <h3 class="text-lg font-title font-semibold text-blue mb-4">
            Assessment Details
            @if (Version > 0)
            {
                <span class="badge badge-secondary">Version @Version</span>
            }
        </h3>

        @if (Assessment is not null)
        {
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
                <div class="bg-white rounded-lg p-4">
                    <div class="text-xs text-gray uppercase tracking-wide">Name</div>
                    <div class="text-sm font-semibold text-blue">@(Assessment.Name ?? "Unnamed")</div>
                </div>
                <div class="bg-white rounded-lg p-4">
                    <div class="text-xs text-gray uppercase tracking-wide">Conducted</div>
                    <div class="text-sm font-semibold text-blue">@Assessment.ConductedAt.ToString("g")</div>
                </div>
                <div class="bg-white rounded-lg p-4">
                    <div class="text-xs text-gray uppercase tracking-wide">Data Elements</div>
                    <div class="text-sm font-semibold text-blue">@(Assessment.DataElementAssessments?.Count ?? 0)</div>
                </div>
                <div class="bg-white rounded-lg p-4">
                    <div class="text-xs text-gray uppercase tracking-wide">Version</div>
                    <div class="text-sm font-semibold text-blue">@Version</div>
                </div>
            </div>

            @if (Assessment.DataElementAssessments?.Any() == true)
            {
                <div class="border-t border-white pt-4">
                    <h4 class="text-sm font-semibold text-blue mb-3">Data Elements Summary</h4>

                    <div class="space-y-4">
                        @foreach (var element in Assessment.DataElementAssessments.Take(10))
                        {
                            <div class="bg-white border border-gray-200 rounded-lg p-4 shadow-md hover:shadow-lg transition-shadow duration-200">
                                <h5 class="font-semibold text-blue mb-3">@element.DataElementName</h5>
                                @if (element.Characteristics?.Any() == true)
                                {
                                    <div class="space-y-3">
                                        @foreach (var characteristic in element.Characteristics)
                                        {
                                            @if (characteristic is RecordCount rc)
                                            {
                                                <div class="flex items-center justify-between p-2 bg-gray-100 rounded">
                                                    <span class="text-sm text-gray-700 font-medium">Record Count</span>
                                                    <span class="text-lg font-bold text-gray-900">@rc.Value.ToString("N0")</span>
                                                </div>
                                            }
                                            else if (characteristic is ReportedAvailability ra)
                                            {
                                                <div class="flex items-center justify-between p-2 bg-gray-100 rounded">
                                                    <span class="text-sm text-gray-700 font-medium">Availability</span>
                                                    <span class="badge @GetAvailabilityBadge(ra.Value)">@ra.Value</span>
                                                </div>
                                            }
                                            else if (characteristic is Completeness c)
                                            {
                                                <div class="p-3 bg-gray-100 rounded">
                                                    <div class="flex items-center justify-between mb-2">
                                                        <span class="text-sm font-medium text-gray-700">@c.AttributeName Completeness</span>
                                                        <span class="text-sm font-bold text-gray-900">@c.Percentage.ToString("F1")%</span>
                                                    </div>
                                                    <div class="w-full bg-gray-200 rounded-full h-2">
                                                        <div class="bg-blue h-2 rounded-full transition-all" style="width: @c.Percentage.ToString("F1")%"></div>
                                                    </div>
                                                    <div class="text-xs text-gray-600 mt-1">@c.PopulatedRecords.ToString("N0") / @c.TotalRecords.ToString("N0") records</div>
                                                </div>
                                            }
                                            else if (characteristic is IntegerRange ir)
                                            {
                                                <div class="p-2 bg-gray-100 rounded">
                                                    <span class="text-sm font-medium text-gray-700">@ir.Label:</span>
                                                    <span class="text-sm font-bold text-gray-900 ml-2">@ir.Minimum - @ir.Maximum</span>
                                                </div>
                                            }
                                            else if (characteristic is Distribution dist)
                                            {
                                                <div class="p-3 bg-gray-100 rounded">
                                                    <div class="text-sm font-medium text-gray-700 mb-2">@dist.Label Distribution (@dist.TotalCount.ToString("N0") total)</div>
                                                    <div class="space-y-2">
                                                        @foreach (var kvp in dist.Counts.OrderByDescending(k => k.Value).Take(10))
                                                        {
                                                            var percentage = dist.TotalCount > 0 ? (kvp.Value * 100.0 / dist.TotalCount) : 0;
                                                            <div>
                                                                <div class="flex items-center justify-between text-xs mb-1">
                                                                    <span class="font-medium text-gray-700 truncate mr-2">@kvp.Key</span>
                                                                    <span class="font-mono text-gray-900 whitespace-nowrap">@kvp.Value.ToString("N0") (@percentage.ToString("F1")%)</span>
                                                                </div>
                                                                <div class="w-full bg-gray-200 rounded-full h-1.5">
                                                                    <div class="bg-secondary h-1.5 rounded-full transition-all" style="width: @percentage.ToString("F1")%"></div>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                    @if (dist.Counts.Count > 10)
                                                    {
                                                        <div class="text-xs text-gray-600 mt-2">Showing top 10 of @dist.Counts.Count items</div>
                                                    }
                                                </div>
                                            }
                                        }
                                    </div>
                                    <div class="text-xs text-gray mt-2">Assessed: @element.AssessedAt.ToString("g")</div>
                                }
                                else
                                {
                                    <p class="text-sm text-gray">No characteristics recorded</p>
                                }
                            </div>
                        }
                    </div>


                    @if (Assessment.DataElementAssessments.Count > 10)
                    {
                        <div class="text-xs text-gray mt-2">
                            Showing 10 of @Assessment.DataElementAssessments.Count elements
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-4 text-gray border border-white rounded-lg bg-white bg-opacity-50">
                    <i class="fas fa-exclamation-triangle text-blue mb-2"></i>
                    <p class="text-sm">No detailed data elements in this assessment.</p>
                </div>
            }
        }
        else
        {
            <div class="text-center py-8 text-gray">
                <i class="fas fa-mouse-pointer text-4xl mb-4 opacity-50"></i>
                <p class="text-sm">Click on an assessment above to view detailed information.</p>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public DataSourceAssessment Assessment { get; set; } = new();

    [Parameter] public int Version { get; set; }

    private string GetAvailabilityBadge(AvailabilityJudgment judgment) => judgment switch
    {
        AvailabilityJudgment.Available => "badge-success",
        AvailabilityJudgment.PartiallyAvailable => "badge-warning",
        AvailabilityJudgment.NotAvailable => "badge-error",
        AvailabilityJudgment.InsufficientData => "badge-ghost",
        _ => "badge-ghost"
    };
}
