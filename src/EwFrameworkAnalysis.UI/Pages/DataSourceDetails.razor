@page "/data-sources/{Id:guid}"
@using EwFrameworkAnalysis.UI
@inject AnalysisProjectService ProjectSvc
@inject NavigationManager Nav

@if (_dataSource is null)
{
    <div class="container mx-auto max-w-4xl p-6">
        <div class="bg-white overflow-hidden shadow rounded-lg">
            <div class="px-4 py-5 sm:p-6 text-center">
                <h2 class="text-2xl font-title font-bold text-blue mb-2">Data Source not found</h2>
                <p class="text-gray mb-4">We couldn't locate a data source with ID "@Id".</p>
                <div class="flex justify-center">
                    <button class="btn btn-primary" @onclick="@(() => Nav.NavigateTo(AppRoutes.Dashboard))">
                        Back to Dashboard
                    </button>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <!-- Notification Toast -->
    @if (_showNotification && !string.IsNullOrEmpty(_notificationMessage))
    {
        <div class="toast toast-top toast-end z-50">
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i>
                <span>@_notificationMessage</span>
                <button class="btn btn-sm btn-circle btn-ghost" @onclick="() => _showNotification = false">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        </div>
    }

    <div class="container mx-auto max-w-7xl p-4 lg:p-8">
        <!-- Header -->
        <div class="bg-white overflow-hidden shadow rounded-lg mb-6">
            <div class="px-4 py-5 sm:p-6">
                <div class="flex items-start justify-between">
                    <div class="space-y-1 flex-1">
                        @if (_isEditingName)
                        {
                            <div class="flex items-center gap-2">
                                <input @bind="_editingName"
                                       @onkeyup="@(async (e) => { if (e.Key == "Enter") await SaveName(); else if (e.Key == "Escape") CancelEditingName(); })"
                                       class="input input-lg input-bordered text-blue font-title flex-1"
                                       placeholder="Data source name" />
                                <button class="text-green hover:text-yellow" @onclick="SaveName">
                                    <i class="fas fa-check"></i>
                                </button>
                                <button class="text-gray hover:text-blue" @onclick="CancelEditingName">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="flex items-center gap-2">
                                <h1 class="text-2xl font-title font-bold text-blue">@_dataSource.Name</h1>
                                <button class="text-gray hover:text-blue" @onclick="StartEditingName">
                                    <i class="fas fa-edit"></i>
                                </button>
                            </div>
                        }
                        <p class="text-sm text-gray">
                            <span class="font-medium">Type:</span> @_dataSource.Type.ToString()
                            @if (!string.IsNullOrWhiteSpace(_dataSource.Description))
                            {
                                <span class="mx-2">•</span>
                                <span>@_dataSource.Description</span>
                            }
                        </p>
                    </div>
                    <div class="flex items-center space-x-3">
                        <button class="btn btn-primary gap-2" @onclick="RunNewAssessment">
                            <i class="fas fa-play"></i>
                            Run New Assessment
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Left: Controls -->
            <div class="lg:col-span-1 space-y-6">

                <!-- Left: Metadata -->
                <div class="bg-white shadow rounded-lg">
                    <div class="px-4 py-5 sm:p-6">
                        <h3 class="text-lg font-title font-semibold text-blue mb-4">Metadata</h3>
                        <div class="space-y-3">
                            <div class="flex justify-between items-center">
                                <span class="text-sm font-medium text-gray">Name</span>
                                <span class="text-sm text-blue">@_dataSource.Name</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="text-sm font-medium text-gray">Type</span>
                                <span class="text-sm text-blue">@_dataSource.Type</span>
                            </div>
                            <div class="flex justify-between items-start">
                                <span class="text-sm font-medium text-gray">Description</span>
                                <span class="text-sm text-blue text-right max-w-xs">@(_dataSource.Description ?? "—")</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-sm font-medium text-gray">Status</span>
                                <div class="flex items-center gap-2">
                                    @if (_dataSource.Enabled)
                                    {
                                        <div class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green bg-opacity-20 text-white">
                                            <i class="fas fa-check-circle mr-1"></i>
                                            Enabled
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-500 bg-opacity-20 text-white">
                                            <i class="fas fa-times-circle mr-1"></i>
                                            Disabled
                                        </div>
                                    }
                                    <button class="text-xs text-blue hover:text-yellow font-medium" @onclick="ToggleEnabled">
                                        @(_dataSource.Enabled ? "Disable" : "Enable")
                                    </button>
                                </div>
                            </div>
                            @if (true) // _dataSource.ActiveVersion.HasValue)
                            {
                                <div class="flex justify-between items-center">
                                    <span class="text-sm font-medium text-gray">Active Version</span>
                                    <div class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue bg-opacity-20 text-white">@* @_dataSource.ActiveVersion *@</div>
                                </div>
                            }
                            <div class="flex justify-between items-center">
                                <span class="text-sm font-medium text-gray">Total Assessments</span>
                                <span class="text-sm font-semibold text-blue">@* @(_dataSource.Assessments?.Count ?? 0) *@ 0 </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Left: Assessment History -->
                <div class="bg-white shadow rounded-lg">
                    <div class="px-4 py-5 sm:p-6">
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="text-lg font-title font-semibold text-blue">Assessment History</h3>
                        </div>

                        @if (_dataSourceAssesments?.Any() == true)
                        {
                            <div class="space-y-3">
                                @foreach (var a in _dataSourceAssesments.OrderByDescending(x => x.ConductedAt))
                                {
                                    var isActive = true; //a.Version == _dataSource.ActiveVersion;
                                    var isViewing = true; //a.Version == _selectedAssessment?.Version;
                                    <div class="card bg-white border border-gray-200 shadow-md hover:bg-tan hover:shadow-[2px_4px_8px_0px_rgba(0,0,0,0.1),2px_2px_0px_0px_theme(colors.blue)] hover:-translate-y-1 hover:-translate-x-0.5 transform transition-all duration-200 cursor-pointer @(isViewing ? "ring-2 ring-blue ring-opacity-30 bg-tan" : "")"
                                         @onclick="() => SelectAssessment(a)">
                                        <div class="card-body p-4">
                                            <div class="flex items-center justify-between">
                                                <div class="flex-1">
                                                    <div class="text-sm font-semibold text-blue flex items-center gap-2">
                                                        Version 1 @* @a.Version *@
                                                        @if (isActive)
                                                        {
                                                            <div class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green bg-opacity-20 text-white">active</div>
                                                        }
                                                        @if (isViewing)
                                                        {
                                                            <div class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue bg-opacity-20 text-white">viewing</div>
                                                        }
                                                    </div>
                                                    <div class="text-xs text-gray mt-1">
                                                        @(a.Name ?? "Unnamed") — @a.ConductedAt.ToString("g")
                                                    </div>
                                                    @if (a.DataElementAssessments?.Any() == true)
                                                    {
                                                        <div class="text-xs text-gray mt-1">
                                                            @a.DataElementAssessments.Count data elements assessed
                                                        </div>
                                                    }
                                                </div>
                                                <div class="flex items-center gap-2">
                                                    @if (!isActive)
                                                    {
                                                        <button class="btn btn-sm bg-blue text-white border-blue hover:bg-yellow hover:text-yellow hover:border-yellow"
                                                                @onclick:stopPropagation="true"
                                                                @* @onclick="() => SetActiveAssessment(a.Version)" *@>
                                                            Set Active
                                                        </button>
                                                    }
                                                    <i class="fas fa-chevron-right text-gray"></i>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-8 text-gray">
                                <i class="fas fa-clock text-4xl mb-4 opacity-50"></i>
                                <p class="font-semibold">No assessments yet</p>
                                <p class="text-xs mt-2">Click "Run New Assessment" to get started.</p>
                            </div>
                        }
                    </div>
                </div>

                <!-- Left: Management -->
                <div class="bg-white shadow rounded-lg">
                    <div class="px-4 py-5 sm:p-6">
                        <h3 class="text-lg font-title font-semibold text-blue mb-4">Management</h3>
                        <div class="space-y-3">
                            <button class="btn btn-sm w-full @(_dataSource.Enabled ? "btn-outline" : "bg-green text-white border-green")"
                                    @onclick="ToggleEnabled">
                                <i class="fas @(_dataSource.Enabled ? "fa-pause" : "fa-play") mr-2"></i>
                                @(_dataSource.Enabled ? "Disable" : "Enable") Data Source
                            </button>

                            <div class="border-t border-gray-200 pt-3">
                                <p class="text-xs text-gray mb-2">Danger Zone</p>
                                <button class="btn btn-sm btn-error btn-outline w-full"
                                        @onclick="ShowDeleteConfirmation">
                                    <i class="fas fa-trash mr-2"></i>
                                    Delete Data Source
                                </button>
                            </div>
                        </div>
                    </div>
                </div>


            </div>



            <!-- Right: Details -->
            <div class="lg:col-span-2 space-y-6">

                @if (_selectedAssessment is not null)
                {
                    <div class="bg-white shadow rounded-lg">
                        <div class="px-4 py-5 sm:p-6">
                            <h3 class="text-lg font-title font-semibold text-blue mb-4">
                                Assessment Details (Version @* @_selectedAssessment.Version *@)
                            </h3>

                            <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
                                <div class="bg-white rounded-lg p-4">
                                    <div class="text-xs text-gray uppercase tracking-wide">Name</div>
                                    <div class="text-sm font-semibold text-blue">@(_selectedAssessment.Name ?? "Unnamed")</div>
                                </div>
                                <div class="bg-white rounded-lg p-4">
                                    <div class="text-xs text-gray uppercase tracking-wide">Conducted</div>
                                    <div class="text-sm font-semibold text-blue">@_selectedAssessment.ConductedAt.ToString("g")</div>
                                </div>
                                <div class="bg-white rounded-lg p-4">
                                    <div class="text-xs text-gray uppercase tracking-wide">Data Elements</div>
                                    <div class="text-sm font-semibold text-blue">@(_selectedAssessment.DataElementAssessments?.Count ?? 0)</div>
                                </div>
                                <div class="bg-white rounded-lg p-4">
                                    <div class="text-xs text-gray uppercase tracking-wide">Version</div>
                                    <div class="text-sm font-semibold text-blue">@* @_selectedAssessment.Version *@</div>
                                </div>
                            </div>

                            @if (_selectedAssessment.DataElementAssessments?.Any() == true)
                            {
                                <div class="border-t border-tan pt-4">
                                    <h4 class="text-sm font-semibold text-blue mb-3">Data Elements Summary</h4>
                                    <div class="bg-tan rounded-lg overflow-hidden">
                                        <div class="max-h-64 overflow-y-auto">
                                            <table class="min-w-full">
                                                <thead class="bg-blue bg-opacity-20">
                                                    <tr>
                                                        <th class="px-4 py-2 text-left text-xs font-medium text-blue uppercase tracking-wide">Element Name</th>
                                                        <th class="px-4 py-2 text-left text-xs font-medium text-blue uppercase tracking-wide">Characteristics</th>
                                                    </tr>
                                                </thead>
                                                <tbody class="divide-y divide-gray-200">
                                                    @foreach (var element in _selectedAssessment.DataElementAssessments.Take(10))
                                                    {
                                                        <tr class="hover:bg-yellow hover:bg-opacity-20">
                                                            <td class="px-4 py-2 text-sm font-medium text-blue">@element.DataElementName</td>
                                                            <td class="px-4 py-2 text-xs text-gray">
                                                                @if (element.Characteristics?.Any() == true)
                                                                {
                                                                    <span>@string.Join(", ", element.Characteristics.Select(c => $"c.CharacteristicType: c.Value"))</span>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                    @if (_selectedAssessment.DataElementAssessments.Count > 10)
                                    {
                                        <div class="text-xs text-gray mt-2">
                                            Showing 10 of @_selectedAssessment.DataElementAssessments.Count elements
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-4 text-gray border border-tan rounded-lg bg-tan bg-opacity-50">
                                    <i class="fas fa-exclamation-triangle text-blue mb-2"></i>
                                    <p class="text-sm">No detailed data elements in this assessment.</p>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="bg-white shadow rounded-lg">
                        <div class="px-4 py-5 sm:p-6">
                            <h3 class="text-lg font-title font-semibold text-blue mb-4">Assessment Details</h3>
                            <div class="text-center py-8 text-gray">
                                <i class="fas fa-mouse-pointer text-4xl mb-4 opacity-50"></i>
                                <p class="text-sm">Click on an assessment above to view detailed information.</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@if (_showDeleteModal)
{
    <div class="modal modal-open">
        <div class="modal-box">
            <h3 class="font-bold text-lg text-blue font-title">Delete Data Source</h3>
            <p class="py-4 text-gray">
                Are you sure you want to delete "<span class="font-semibold text-blue">@_dataSource?.Name</span>"?
                This action cannot be undone and will remove all associated assessment history.
            </p>
            <div class="modal-action">
                <button class="btn btn-ghost" @onclick="CancelDelete">Cancel</button>
                <button class="btn btn-error" @onclick="ConfirmDelete">
                    <i class="fas fa-trash mr-2"></i>
                    Delete Data Source
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private DataSource? _dataSource;
    private List<DataSourceAssessment> _dataSourceAssesments = [];
    private DataSourceAssessment? _selectedAssessment;
    private bool _showDeleteModal = false;

    // Edit mode state
    private bool _isEditingName = false;
    private string _editingName = "";

    // Notification state
    private string? _notificationMessage;
    private bool _showNotification = false;

    protected override async Task OnInitializedAsync()
    {
        await ProjectSvc.InitializeAsync();
        LoadDataSource();
    }

    protected override void OnParametersSet()
    {
        LoadDataSource();
    }

    private void OnProjectChanged()
    {
        LoadDataSource();
        InvokeAsync(StateHasChanged);
    }

    private void LoadDataSource()
    {
        _dataSource = ProjectSvc.GetDataSource(Id);
        _dataSourceAssesments = ProjectSvc.GetDataSourceAssessments(Id);
        if (_dataSourceAssesments?.Any() == true && _selectedAssessment == null)
        {
            // Default to most recent assessment if none selected
            _selectedAssessment = _dataSourceAssesments.OrderByDescending(a => a.ConductedAt).First();
        }
    }

    private async Task SetActiveAssessment(int version)
    {
        if (_dataSource is null) return;
        await ProjectSvc.SetActiveAssessmentAsync(_dataSource.Id, version);
        ShowNotification($"Version {version} is now active");
    }

    private void SelectAssessment(DataSourceAssessment assessment)
    {
        _selectedAssessment = assessment;
    }

    private async Task RunNewAssessment()
    {
        if (_dataSource is null) return;

        var assessment = new DataSourceAssessment
        {
            Name = $"Assessment {DateTime.Now:yyyy-MM-dd HH:mm}",
            ConductedAt = DateTime.UtcNow
        };

        await ProjectSvc.AddAssessmentAsync(_dataSource.Id, assessment);
        ShowNotification("New assessment started");

        // Select the newly created assessment
        _selectedAssessment = assessment;
    }

    private async Task ToggleEnabled()
    {
        if (_dataSource is null) return;
        await ProjectSvc.SetEnabledAsync(_dataSource.Id, !_dataSource.Enabled);
        ShowNotification($"Data source {(_dataSource.Enabled ? "enabled" : "disabled")}");
    }

    private void StartEditingName()
    {
        if (_dataSource is null) return;
        _isEditingName = true;
        _editingName = _dataSource.Name;
    }

    private void CancelEditingName()
    {
        _isEditingName = false;
        _editingName = "";
    }

    private async Task SaveName()
    {
        if (_dataSource is null || string.IsNullOrWhiteSpace(_editingName)) return;

        var updatedDs = new DataSource
        {
            Id = _dataSource.Id,
            Name = _editingName.Trim(),
            Description = _dataSource.Description,
            Type = _dataSource.Type,
            Enabled = _dataSource.Enabled,
            // Assessments = _dataSource.Assessments,
            // ActiveVersion = _dataSource.ActiveVersion
        };

        await ProjectSvc.UpdateDataSourceAsync(updatedDs);
        _isEditingName = false;
        ShowNotification("Name updated successfully");
    }

    private void ShowNotification(string message)
    {
        _notificationMessage = message;
        _showNotification = true;
        StateHasChanged();

        // Hide notification after 3 seconds
        _ = Task.Run(async () =>
        {
            await Task.Delay(3000);
            _showNotification = false;
            await InvokeAsync(StateHasChanged);
        });
    }

    private void ShowDeleteConfirmation()
    {
        _showDeleteModal = true;
    }

    private void CancelDelete()
    {
        _showDeleteModal = false;
    }

    private async Task ConfirmDelete()
    {
        if (_dataSource is null) return;

        await ProjectSvc.DeleteDataSourceAsync(_dataSource.Id);
        _showDeleteModal = false;

        // Navigate back to dashboard after deletion
        Nav.NavigateTo(AppRoutes.Dashboard);
    }
}
