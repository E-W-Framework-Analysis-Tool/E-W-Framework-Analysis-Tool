@page "/data-sources/{Id:guid}"
@using System.Net.Http.Headers
@using System.Text.Json
@using EwFrameworkAnalysis.Common.Models.Project
@using EwFrameworkAnalysis.Common.Models.Scoring
@using EwFrameworkAnalysis.Common.Assessors.EdFi
@using EwFrameworkAnalysis.Common.Services
@inject AnalysisProjectService ProjectSvc
@inject NavigationManager Nav
@inject EdFiAssessmentOrchestrator Orchestrator
@inject HttpClient HttpClient

@if (_dataSource is null)
{
    <div class="container mx-auto max-w-4xl p-6">
        <div class="bg-white overflow-hidden shadow rounded-lg">
            <div class="px-4 py-5 sm:p-6 text-center">
                <h2 class="text-2xl font-title font-bold text-blue mb-2">Data Source not found</h2>
                <p class="text-gray mb-4">We couldn't locate a data source with ID "@Id".</p>
                <div class="flex justify-center">
                    <button class="btn btn-primary" @onclick="@(() => Nav.NavigateTo(AppRoutes.Dashboard))">
                        Back to Dashboard
                    </button>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <!-- Notification Toast -->
    @if (_showNotification && !string.IsNullOrEmpty(_notificationMessage))
    {
        <div class="toast toast-top toast-end z-50">
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i>
                <span>@_notificationMessage</span>
                <button class="btn btn-sm btn-circle btn-ghost" @onclick="() => _showNotification = false">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        </div>
    }

    <div class="container mx-auto max-w-7xl p-4 lg:p-8">
        <!-- Header -->
        <div class="bg-white overflow-hidden shadow rounded-lg mb-6">
            <div class="px-4 py-5 sm:p-6">
                <div class="flex items-start justify-between">
                    <div class="space-y-1 flex-1">
                        @if (_isEditingName)
                        {
                            <div class="flex items-center gap-2">
                                <input @bind="_editingName"
                                       @onkeyup="@(async (e) => { if (e.Key == "Enter") await SaveName(); else if (e.Key == "Escape") CancelEditingName(); })"
                                       class="input input-lg input-bordered text-blue font-title flex-1"
                                       placeholder="Data source name" />
                                <button class="text-green hover:text-yellow" @onclick="SaveName">
                                    <i class="fas fa-check"></i>
                                </button>
                                <button class="text-gray hover:text-blue" @onclick="CancelEditingName">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="flex items-center gap-2">
                                <h1 class="text-2xl font-title font-bold text-blue">@_dataSource.Name</h1>
                                <button class="text-gray hover:text-blue" @onclick="StartEditingName">
                                    <i class="fas fa-edit"></i>
                                </button>
                            </div>
                        }
                        <p class="text-sm text-gray">
                            <span class="font-medium">Type:</span> @_dataSource.Type.ToString()
                            @if (!string.IsNullOrWhiteSpace(_dataSource.Description))
                            {
                                <span class="mx-2">•</span>
                                <span>@_dataSource.Description</span>
                            }
                        </p>
                    </div>
                    <div class="flex items-center space-x-3">
                        @if (_dataSource.Type == DataSourceType.EdFiApi)
                        {
                            <button class="btn btn-primary gap-2" @onclick="ShowAssessmentRunner">
                                <i class="fas fa-play"></i>
                                Run New Assessment
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Assessment Runner Modal (for Ed-Fi) -->
        @if (_showAssessmentRunner && _dataSource.Type == DataSourceType.EdFiApi)
        {
            <div class="fixed inset-0 z-50 flex items-center justify-center p-4 overflow-y-auto">
                <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" @onclick="CloseAssessmentRunner"></div>
                <div class="relative w-full max-w-6xl bg-white rounded-2xl shadow-2xl max-h-[90vh] overflow-y-auto">
                    <div class="sticky top-0 bg-white border-b border-gray-200 px-6 py-4 rounded-t-2xl z-10">
                        <div class="flex items-center justify-between">
                            <h2 class="text-xl font-title font-bold text-blue">Run Ed-Fi Assessment</h2>
                            <button class="btn btn-sm btn-circle btn-ghost" @onclick="CloseAssessmentRunner">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    </div>

                    <div class="px-6 py-6 space-y-6">
                        @if (_currentProgress == null)
                        {
                            <div class="bg-tan bg-opacity-50 rounded-lg p-4">
                                <h3 class="text-lg font-semibold text-blue mb-4">API Configuration</h3>
                                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                    <div class="form-control">
                                        <label class="label"><span class="label-text font-semibold text-gray">Base URL</span></label>
                                        <input type="text" @bind="_rootUrl" class="input input-bordered w-full font-mono text-sm" />
                                    </div>
                                    <div class="form-control">
                                        <label class="label"><span class="label-text font-semibold text-gray">Client ID</span></label>
                                        <input type="text" @bind="_clientId" class="input input-bordered w-full font-mono text-sm" />
                                    </div>
                                    <div class="form-control">
                                        <label class="label"><span class="label-text font-semibold text-gray">Client Secret</span></label>
                                        <input type="password" @bind="_clientSecret" class="input input-bordered w-full font-mono text-sm" />
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(_validationError))
                                {
                                    <div class="alert alert-error mt-4">
                                        <i class="fas fa-exclamation-circle"></i>
                                        <span>@_validationError</span>
                                    </div>
                                }
                            </div>
                        }

                        @if (_currentProgress != null)
                        {
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                <div class="bg-white border border-gray-200 rounded-lg p-4 shadow">
                                    <h3 class="text-sm text-gray mb-2">Overall Progress</h3>
                                    <div class="text-3xl font-bold text-blue">@_currentProgress.PercentComplete%</div>
                                    <progress class="progress progress-primary w-full h-2 mt-2" value="@_currentProgress.PercentComplete" max="100"></progress>
                                </div>
                                <div class="bg-white border border-gray-200 rounded-lg p-4 shadow">
                                    <h3 class="text-sm text-gray mb-2">Assessors Complete</h3>
                                    <div class="text-3xl font-bold text-blue">@_currentProgress.CompletedAssessors / @_currentProgress.TotalAssessors</div>
                                </div>
                                <div class="bg-white border border-gray-200 rounded-lg p-4 shadow">
                                    <h3 class="text-sm text-gray mb-2">Status</h3>
                                    <div class="space-y-1 text-sm">
                                        <div class="flex justify-between">
                                            <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-yellow-500"></span>Running</span>
                                            <span class="font-bold">@_currentProgress.AssessorProgresses.Count(a => a.Status == AssessorStatus.Running)</span>
                                        </div>
                                        <div class="flex justify-between">
                                            <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-green"></span>Completed</span>
                                            <span class="font-bold">@_currentProgress.AssessorProgresses.Count(a => a.Status == AssessorStatus.Completed)</span>
                                        </div>
                                        <div class="flex justify-between">
                                            <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-red-500"></span>Failed</span>
                                            <span class="font-bold">@_currentProgress.AssessorProgresses.Count(a => a.Status == AssessorStatus.Failed)</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="bg-white border border-gray-200 rounded-lg shadow">
                                <div class="px-4 py-3 border-b border-gray-200">
                                    <h3 class="font-semibold text-blue">Assessor Progress</h3>
                                </div>
                                <div class="p-4 space-y-2 max-h-96 overflow-y-auto">
                                    @foreach (var assessor in _currentProgress.AssessorProgresses)
                                    {
                                        <div class="border border-gray-200 rounded-lg p-3 @GetAssessorBorderClass(assessor.Status)">
                                            <div class="flex items-start justify-between gap-3">
                                                <div class="flex-1 min-w-0">
                                                    <div class="flex items-center gap-2 mb-1">
                                                        @if (assessor.Status == AssessorStatus.Running)
                                                        {
                                                            <span class="loading loading-spinner loading-sm text-yellow-500"></span>
                                                        }
                                                        else if (assessor.Status == AssessorStatus.Completed)
                                                        {
                                                            <i class="fas fa-check-circle text-green"></i>
                                                        }
                                                        else if (assessor.Status == AssessorStatus.Failed)
                                                        {
                                                            <i class="fas fa-times-circle text-red-500"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="fas fa-clock text-gray"></i>
                                                        }
                                                        <span class="font-semibold text-sm text-blue truncate">@assessor.DataElementName</span>
                                                    </div>
                                                    @if (assessor.Status == AssessorStatus.Completed && assessor.Result != null)
                                                    {
                                                        <div class="ml-6 mt-2 space-y-2">
                                                            <div class="text-xs text-green">@assessor.Result.Characteristics?.Count characteristic(s) collected</div>
                                                            @if (assessor.Result.Characteristics?.Any() == true)
                                                            {
                                                                <div class="space-y-1 pl-2 border-l-2 border-green">
                                                                    @foreach (var characteristic in assessor.Result.Characteristics)
                                                                    {
                                                                        @if (characteristic is RecordCount rc)
                                                                        {
                                                                            <div class="text-xs text-gray-700">
                                                                                <span class="font-medium">Records:</span> @rc.Value.ToString("N0")
                                                                            </div>
                                                                        }
                                                                        else if (characteristic is ReportedAvailability ra)
                                                                        {
                                                                            <div class="text-xs text-gray-700">
                                                                                <span class="font-medium">Availability:</span>
                                                                                <span class="badge badge-xs @GetAvailabilityBadge(ra.Value)">@ra.Value</span>
                                                                            </div>
                                                                        }
                                                                        else if (characteristic is Completeness c)
                                                                        {
                                                                            <div class="text-xs text-gray-700">
                                                                                <span class="font-medium">@c.AttributeName:</span> @c.Percentage.ToString("F1")% complete
                                                                            </div>
                                                                        }
                                                                        else if (characteristic is IntegerRange ir)
                                                                        {
                                                                            <div class="text-xs text-gray-700">
                                                                                <span class="font-medium">@ir.Label:</span> @ir.Minimum - @ir.Maximum
                                                                            </div>
                                                                        }
                                                                        else if (characteristic is Distribution dist)
                                                                        {
                                                                            <div class="text-xs text-gray-700">
                                                                                <span class="font-medium">@dist.Label:</span> @dist.TotalCount.ToString("N0") items
                                                                            </div>
                                                                        }
                                                                    }
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                    else if (assessor.Status == AssessorStatus.Running)
                                                    {
                                                        <div class="ml-6 text-xs text-yellow-600">@(assessor.StatusMessage ?? "Processing...")</div>
                                                    }
                                                    else if (assessor.Status == AssessorStatus.Failed)
                                                    {
                                                        <div class="ml-6 text-xs text-red-500">@assessor.ErrorMessage</div>
                                                    }

                                                    @if (assessor.LogMessages?.Any() == true)
                                                    {
                                                        <div class="collapse collapse-arrow bg-gray-50 border border-gray-200 ml-6 mt-2">
                                                            <input type="checkbox" class="peer" />
                                                            <div class="collapse-title text-xs text-blue">
                                                                @assessor.LogMessages.Count log message(s)
                                                            </div>
                                                            <div class="collapse-content">
                                                                <div class="font-mono text-xs space-y-1 max-h-48 overflow-y-auto">
                                                                    @foreach (var log in assessor.LogMessages)
                                                                    {
                                                                        <div class="text-gray-700">@log</div>
                                                                    }
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                                <div class="badge badge-sm @GetStatusBadgeClass(assessor.Status)">@assessor.Status.ToString()</div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @if (_error != null)
                        {
                            <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i><span>@_error</span></div>
                        }

                        @if (_assessmentResult != null)
                        {
                            <div class="alert alert-success">
                                <i class="fas fa-check-circle"></i>
                                <div>
                                    <h3 class="font-bold">Assessment Complete!</h3>
                                    <div class="text-sm">Collected @_assessmentResult.DataElementAssessments.Count assessments with @_assessmentResult.DataElementAssessments.Sum(a => a.Characteristics.Count) total characteristics</div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="sticky bottom-0 bg-gray-50 border-t border-gray-200 px-6 py-4 rounded-b-2xl">
                        <div class="flex justify-end gap-3">
                            @if (_isRunning)
                            {
                                <button class="btn btn-error" @onclick="CancelAssessment"><i class="fas fa-stop mr-2"></i>Cancel Assessment</button>
                            }
                            else if (_assessmentResult != null)
                            {
                                <button class="btn btn-ghost" @onclick="ResetAssessmentRunner">Run Another</button>
                                <button class="btn btn-primary" @onclick="CloseAssessmentRunner">Done</button>
                            }
                            else
                            {
                                <button class="btn btn-ghost" @onclick="CloseAssessmentRunner">Cancel</button>
                                <button class="btn btn-primary" @onclick="StartAssessment" disabled="@(!IsFormValid())"><i class="fas fa-play mr-2"></i>Start Assessment</button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Left: Controls -->
            <div class="lg:col-span-1 space-y-6">
                <div class="bg-white shadow rounded-lg">
                    <div class="px-4 py-5 sm:p-6">
                        <h3 class="text-lg font-title font-semibold text-blue mb-4">Metadata</h3>
                        <div class="space-y-3">
                            <div class="flex justify-between items-center">
                                <span class="text-sm font-medium text-gray">Name</span>
                                <span class="text-sm text-blue">@_dataSource.Name</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="text-sm font-medium text-gray">Type</span>
                                <span class="text-sm text-blue">@_dataSource.Type</span>
                            </div>
                            <div class="flex justify-between items-start">
                                <span class="text-sm font-medium text-gray">Description</span>
                                <span class="text-sm text-blue text-right max-w-xs">@(_dataSource.Description ?? "—")</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-sm font-medium text-gray">Status</span>
                                <div class="flex items-center gap-2">
                                    @if (_dataSource.Enabled)
                                    {
                                        <div class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green bg-opacity-20 text-white"><i class="fas fa-check-circle mr-1"></i>Enabled</div>
                                    }
                                    else
                                    {
                                        <div class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-500 bg-opacity-20 text-white"><i class="fas fa-times-circle mr-1"></i>Disabled</div>
                                    }
                                    <button class="text-xs text-blue hover:text-yellow font-medium" @onclick="ToggleEnabled">@(_dataSource.Enabled ? "Disable" : "Enable")</button>
                                </div>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="text-sm font-medium text-gray">Total Assessments</span>
                                <span class="text-sm font-semibold text-blue">@(_dataSourceAssessments?.Count ?? 0)</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="bg-white shadow rounded-lg">
                    <div class="px-4 py-5 sm:p-6">
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="text-lg font-title font-semibold text-blue">Assessment History</h3>
                        </div>
                        @if (_dataSourceAssessments?.Any() == true)
                        {
                            <div class="space-y-3">
                                @foreach (var a in _dataSourceAssessments.OrderByDescending(x => x.ConductedAt))
                                {
                                    var isViewing = a.Id == _selectedAssessment?.Id;
                                    <div class="card bg-white border border-gray-200 shadow-md hover:bg-tan hover:shadow-[2px_4px_8px_0px_rgba(0,0,0,0.1),2px_2px_0px_0px_theme(colors.blue)] hover:-translate-y-1 hover:-translate-x-0.5 transform transition-all duration-200 cursor-pointer @(isViewing ? "ring-2 ring-blue ring-opacity-30 bg-tan" : "")"
                                         @onclick="() => SelectAssessment(a)">
                                        <div class="card-body p-4">
                                            <div class="flex items-center justify-between">
                                                <div class="flex-1">
                                                    <div class="text-sm font-semibold text-blue flex items-center gap-2">
                                                        @(a.Name ?? "Unnamed Assessment")
                                                        @if (isViewing)
                                                        {
                                                            <div class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue bg-opacity-20 text-white">viewing</div>
                                                        }
                                                    </div>
                                                    <div class="text-xs text-gray mt-1">@a.ConductedAt.ToString("g")</div>
                                                    @if (a.DataElementAssessments?.Any() == true)
                                                    {
                                                        <div class="text-xs text-gray mt-1">@a.DataElementAssessments.Count data elements assessed</div>
                                                    }
                                                </div>
                                                <div class="flex items-center gap-2"><i class="fas fa-chevron-right text-gray"></i></div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-8 text-gray">
                                <i class="fas fa-clock text-4xl mb-4 opacity-50"></i>
                                <p class="font-semibold">No assessments yet</p>
                                <p class="text-xs mt-2">Click "Run New Assessment" to get started.</p>
                            </div>
                        }
                    </div>
                </div>

                <div class="bg-white shadow rounded-lg">
                    <div class="px-4 py-5 sm:p-6">
                        <h3 class="text-lg font-title font-semibold text-blue mb-4">Management</h3>
                        <div class="space-y-3">
                            <button class="btn btn-sm w-full @(_dataSource.Enabled ? "btn-outline" : "bg-green text-white border-green")" @onclick="ToggleEnabled">
                                <i class="fas @(_dataSource.Enabled ? "fa-pause" : "fa-play") mr-2"></i>
                                @(_dataSource.Enabled ? "Disable" : "Enable") Data Source
                            </button>
                            <div class="border-t border-gray-200 pt-3">
                                <p class="text-xs text-gray mb-2">Danger Zone</p>
                                <button class="btn btn-sm btn-error btn-outline w-full" @onclick="ShowDeleteConfirmation"><i class="fas fa-trash mr-2"></i>Delete Data Source</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Details -->
            <div class="lg:col-span-2 space-y-6">
                @if (_selectedAssessment is not null)
                {
                    <div class="bg-white shadow rounded-lg">
                        <div class="px-4 py-5 sm:p-6">
                            <h3 class="text-lg font-title font-semibold text-blue mb-4">Assessment Details</h3>
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
                                <div class="bg-white rounded-lg p-4">
                                    <div class="text-xs text-gray uppercase tracking-wide">Name</div>
                                    <div class="text-sm font-semibold text-blue">@(_selectedAssessment.Name ?? "Unnamed")</div>
                                </div>
                                <div class="bg-white rounded-lg p-4">
                                    <div class="text-xs text-gray uppercase tracking-wide">Conducted</div>
                                    <div class="text-sm font-semibold text-blue">@_selectedAssessment.ConductedAt.ToString("g")</div>
                                </div>
                                <div class="bg-white rounded-lg p-4">
                                    <div class="text-xs text-gray uppercase tracking-wide">Data Elements</div>
                                    <div class="text-sm font-semibold text-blue">@(_selectedAssessment.DataElementAssessments?.Count ?? 0)</div>
                                </div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(_selectedAssessment.Notes))
                            {
                                <div class="mb-6 p-4 bg-tan bg-opacity-50 rounded-lg">
                                    <div class="text-xs text-gray uppercase tracking-wide mb-1">Notes</div>
                                    <div class="text-sm text-blue">@_selectedAssessment.Notes</div>
                                </div>
                            }
                            @if (_selectedAssessment.DataElementAssessments?.Any() == true)
                            {
                                <div class="border-t border-tan pt-4">
                                    <h4 class="text-sm font-semibold text-blue mb-3">Data Elements</h4>
                                    <div class="space-y-4">
                                        @foreach (var element in _selectedAssessment.DataElementAssessments.Take(10))
                                        {
                                            <div class="bg-white border border-gray-200 rounded-lg p-4 shadow-md hover:shadow-lg transition-shadow duration-200">
                                                <h5 class="font-semibold text-blue mb-3">@element.DataElementName</h5>
                                                @if (element.Characteristics?.Any() == true)
                                                {
                                                    <div class="space-y-3">
                                                        @foreach (var characteristic in element.Characteristics)
                                                        {
                                                            @if (characteristic is RecordCount rc)
                                                            {
                                                                <div class="flex items-center justify-between p-2 bg-gray-100 rounded">
                                                                    <span class="text-sm text-gray-700 font-medium">Record Count</span>
                                                                    <span class="text-lg font-bold text-gray-900">@rc.Value.ToString("N0")</span>
                                                                </div>
                                                            }
                                                            else if (characteristic is ReportedAvailability ra)
                                                            {
                                                                <div class="flex items-center justify-between p-2 bg-gray-100 rounded">
                                                                    <span class="text-sm text-gray-700 font-medium">Availability</span>
                                                                    <span class="badge @GetAvailabilityBadge(ra.Value)">@ra.Value</span>
                                                                </div>
                                                            }
                                                            else if (characteristic is Completeness c)
                                                            {
                                                                <div class="p-3 bg-gray-100 rounded">
                                                                    <div class="flex items-center justify-between mb-2">
                                                                        <span class="text-sm font-medium text-gray-700">@c.AttributeName Completeness</span>
                                                                        <span class="text-sm font-bold text-gray-900">@c.Percentage.ToString("F1")%</span>
                                                                    </div>
                                                                    <div class="w-full bg-gray-200 rounded-full h-2">
                                                                        <div class="bg-blue h-2 rounded-full transition-all" style="width: @c.Percentage.ToString("F1")%"></div>
                                                                    </div>
                                                                    <div class="text-xs text-gray-600 mt-1">@c.PopulatedRecords.ToString("N0") / @c.TotalRecords.ToString("N0") records</div>
                                                                </div>
                                                            }
                                                            else if (characteristic is IntegerRange ir)
                                                            {
                                                                <div class="p-2 bg-gray-100 rounded">
                                                                    <span class="text-sm font-medium text-gray-700">@ir.Label:</span>
                                                                    <span class="text-sm font-bold text-gray-900 ml-2">@ir.Minimum - @ir.Maximum</span>
                                                                </div>
                                                            }
                                                            else if (characteristic is Distribution dist)
                                                            {
                                                                <div class="p-3 bg-gray-100 rounded">
                                                                    <div class="text-sm font-medium text-gray-700 mb-2">@dist.Label Distribution (@dist.TotalCount.ToString("N0") total)</div>
                                                                    <div class="space-y-2">
                                                                        @foreach (var kvp in dist.Counts.OrderByDescending(k => k.Value).Take(10))
                                                                        {
                                                                            var percentage = dist.TotalCount > 0 ? (kvp.Value * 100.0 / dist.TotalCount) : 0;
                                                                            <div>
                                                                                <div class="flex items-center justify-between text-xs mb-1">
                                                                                    <span class="font-medium text-gray-700 truncate mr-2">@kvp.Key</span>
                                                                                    <span class="font-mono text-gray-900 whitespace-nowrap">@kvp.Value.ToString("N0") (@percentage.ToString("F1")%)</span>
                                                                                </div>
                                                                                <div class="w-full bg-gray-200 rounded-full h-1.5">
                                                                                    <div class="bg-secondary h-1.5 rounded-full transition-all" style="width: @percentage.ToString("F1")%"></div>
                                                                                </div>
                                                                            </div>
                                                                        }
                                                                    </div>
                                                                    @if (dist.Counts.Count > 10)
                                                                    {
                                                                        <div class="text-xs text-gray-600 mt-2">Showing top 10 of @dist.Counts.Count items</div>
                                                                    }
                                                                </div>
                                                            }
                                                        }
                                                    </div>
                                                    <div class="text-xs text-gray mt-2">Assessed: @element.AssessedAt.ToString("g")</div>
                                                }
                                                else
                                                {
                                                    <p class="text-sm text-gray">No characteristics recorded</p>
                                                }
                                            </div>
                                        }
                                    </div>
                                    @if (_selectedAssessment.DataElementAssessments.Count > 10)
                                    {
                                        <div class="text-xs text-gray mt-4 text-center">Showing 10 of @_selectedAssessment.DataElementAssessments.Count elements</div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-4 text-gray border border-tan rounded-lg bg-tan bg-opacity-50">
                                    <i class="fas fa-exclamation-triangle text-blue mb-2"></i>
                                    <p class="text-sm">No detailed data elements in this assessment.</p>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="bg-white shadow rounded-lg">
                        <div class="px-4 py-5 sm:p-6">
                            <h3 class="text-lg font-title font-semibold text-blue mb-4">Assessment Details</h3>
                            <div class="text-center py-8 text-gray">
                                <i class="fas fa-mouse-pointer text-4xl mb-4 opacity-50"></i>
                                <p class="text-sm">Click on an assessment above to view detailed information.</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@if (_showDeleteModal)
{
    <div class="modal modal-open">
        <div class="modal-box">
            <h3 class="font-bold text-lg text-blue font-title">Delete Data Source</h3>
            <p class="py-4 text-gray">
                Are you sure you want to delete "<span class="font-semibold text-blue">@_dataSource?.Name</span>"?
                This action cannot be undone. Note that assessments will remain in the project history.
            </p>
            <div class="modal-action">
                <button class="btn btn-ghost" @onclick="CancelDelete">Cancel</button>
                <button class="btn btn-error" @onclick="ConfirmDelete">
                    <i class="fas fa-trash mr-2"></i>
                    Delete Data Source
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private DataSource? _dataSource;
    private List<DataSourceAssessment>? _dataSourceAssessments;
    private DataSourceAssessment? _selectedAssessment;
    private bool _showDeleteModal = false;

    private bool _isEditingName = false;
    private string _editingName = "";

    private string? _notificationMessage;
    private bool _showNotification = false;

    private bool _showAssessmentRunner = false;
    private string _rootUrl = "http://localhost:5000/GrandBend/";
    private string DataApiUrl => EnsureTrailingSlash(_rootUrl) + "data/v3/";
    private string AuthUrl => EnsureTrailingSlash(_rootUrl) + "oauth/token";
    private string _clientId = "RvcohKz9zHI4";
    private string _clientSecret = "E1676E88-4D3B-4E4E-B7B7-7C3F8E5D2A9C";
    private bool _isRunning = false;
    private AssessmentProgress? _currentProgress;
    private DataSourceAssessment? _assessmentResult;
    private string? _error;
    private string? _validationError;
    private CancellationTokenSource? _cancellationTokenSource;
    private Timer? _renderTimer;
    private volatile bool _pendingRender;

    protected override async Task OnInitializedAsync()
    {
        ProjectSvc.Changed += OnProjectChanged;
        LoadDataSource();
        await Task.CompletedTask;
    }

    protected override void OnParametersSet()
    {
        LoadDataSource();
    }

    private void OnProjectChanged()
    {
        LoadDataSource();
        InvokeAsync(StateHasChanged);
    }

    private void LoadDataSource()
    {
        _dataSource = ProjectSvc.GetDataSource(Id);

        if (_dataSource != null)
        {
            _dataSourceAssessments = ProjectSvc.GetAssessmentsForDataSource(_dataSource.Id).ToList();

            if (_dataSourceAssessments?.Any() == true && _selectedAssessment == null)
            {
                _selectedAssessment = _dataSourceAssessments.OrderByDescending(a => a.ConductedAt).First();
            }
        }
    }

    private void SelectAssessment(DataSourceAssessment assessment)
    {
        _selectedAssessment = assessment;
    }

    private void ShowAssessmentRunner()
    {
        _showAssessmentRunner = true;
        ResetAssessmentRunner();
    }

    private void CloseAssessmentRunner()
    {
        _showAssessmentRunner = false;
        if (_assessmentResult != null)
        {
            LoadDataSource();
            // Auto-select the newly completed assessment
            _selectedAssessment = _assessmentResult;
        }
        ResetAssessmentRunner();
    }

    private void ResetAssessmentRunner()
    {
        _currentProgress = null;
        _assessmentResult = null;
        _error = null;
        _validationError = null;
    }

    private bool IsFormValid()
    {
        return !string.IsNullOrWhiteSpace(_rootUrl)
            && !string.IsNullOrWhiteSpace(_clientId)
            && !string.IsNullOrWhiteSpace(_clientSecret);
    }

    private static string EnsureTrailingSlash(string url)
    {
        if (string.IsNullOrWhiteSpace(url))
            return url;
        return url.EndsWith("/") ? url : url + "/";
    }

    private void OnProgressUpdate(AssessmentProgress p)
    {
        _currentProgress = p;
        _pendingRender = true;

        _renderTimer ??= new Timer(_ =>
        {
            if (_pendingRender)
            {
                _pendingRender = false;
                InvokeAsync(StateHasChanged);
            }
        }, null, 0, 500);
    }

    private async Task StartAssessment()
    {
        _validationError = null;
        _error = null;

        if (!Uri.TryCreate(DataApiUrl, UriKind.Absolute, out var baseUri))
        {
            _validationError = "Invalid Root URL";
            return;
        }

        try
        {
            _isRunning = true;
            _cancellationTokenSource = new CancellationTokenSource();

            var httpClient = new HttpClient { BaseAddress = baseUri };

            var token = await GetAccessTokenAsync(AuthUrl, _clientId, _clientSecret);
            httpClient.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);

            var progress = new Progress<AssessmentProgress>(OnProgressUpdate);

            _assessmentResult = await Orchestrator.RunAssessmentsAsync(
                httpClient,
                _dataSource!,
                $"Assessment {DateTime.Now:yyyy-MM-dd HH:mm}",
                "",
                progress,
                true,
                _cancellationTokenSource.Token
            );

            if (_assessmentResult != null)
            {
                await ProjectSvc.AddAssessmentAsync(_assessmentResult);
                ShowNotification("Assessment completed and saved");
            }

            httpClient.Dispose();
        }
        catch (OperationCanceledException)
        {
            _error = "Assessment was cancelled by user.";
        }
        catch (Exception ex)
        {
            _error = $"Assessment failed: {ex.Message}";
        }
        finally
        {
            _isRunning = false;
            _cancellationTokenSource?.Dispose();
            _cancellationTokenSource = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<string> GetAccessTokenAsync(string authUrl, string clientId, string clientSecret)
    {
        using var authClient = new HttpClient();

        var tokenRequest = new HttpRequestMessage(HttpMethod.Post, authUrl);
        var formData = new Dictionary<string, string>
            {
                ["grant_type"] = "client_credentials",
                ["client_id"] = clientId,
                ["client_secret"] = clientSecret
            };
        tokenRequest.Content = new FormUrlEncodedContent(formData);

        var response = await authClient.SendAsync(tokenRequest);

        if (!response.IsSuccessStatusCode)
        {
            var error = await response.Content.ReadAsStringAsync();
            throw new InvalidOperationException($"OAuth failed ({response.StatusCode}): {error}");
        }

        var json = await response.Content.ReadAsStringAsync();
        var token = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(json);

        if (token?.TryGetValue("access_token", out var accessToken) == true)
        {
            return accessToken.GetString() ?? throw new InvalidOperationException("Access token was null");
        }

        throw new InvalidOperationException("No access_token in response");
    }

    private void CancelAssessment()
    {
        _cancellationTokenSource?.Cancel();
    }

    private string GetAssessorBorderClass(AssessorStatus status) => status switch
    {
        AssessorStatus.Running => "border-l-4 border-yellow-500",
        AssessorStatus.Completed => "border-l-4 border-green",
        AssessorStatus.Failed => "border-l-4 border-red-500",
        _ => ""
    };

    private string GetStatusBadgeClass(AssessorStatus status) => status switch
    {
        AssessorStatus.Pending => "badge-ghost",
        AssessorStatus.Running => "badge-warning",
        AssessorStatus.Completed => "badge-success",
        AssessorStatus.Failed => "badge-error",
        _ => "badge-ghost"
    };

    private string GetAvailabilityBadge(AvailabilityJudgment judgment) => judgment switch
    {
        AvailabilityJudgment.Available => "badge-success",
        AvailabilityJudgment.PartiallyAvailable => "badge-warning",
        AvailabilityJudgment.NotAvailable => "badge-error",
        AvailabilityJudgment.InsufficientData => "badge-ghost",
        _ => "badge-ghost"
    };

    private async Task ToggleEnabled()
    {
        if (_dataSource is null) return;
        await ProjectSvc.SetEnabledAsync(_dataSource.Id, !_dataSource.Enabled);
        LoadDataSource(); // Reload to get fresh state
        ShowNotification($"Data source {(_dataSource.Enabled ? "enabled" : "disabled")}");
    }

    private void StartEditingName()
    {
        if (_dataSource is null) return;
        _isEditingName = true;
        _editingName = _dataSource.Name;
    }

    private void CancelEditingName()
    {
        _isEditingName = false;
        _editingName = "";
    }

    private async Task SaveName()
    {
        if (_dataSource is null || string.IsNullOrWhiteSpace(_editingName)) return;

        var updatedDs = new DataSource
            {
                Id = _dataSource.Id,
                Name = _editingName.Trim(),
                Description = _dataSource.Description,
                Type = _dataSource.Type,
                Enabled = _dataSource.Enabled
            };

        await ProjectSvc.UpdateDataSourceAsync(updatedDs);
        LoadDataSource(); // Reload to get fresh state
        _isEditingName = false;
        ShowNotification("Name updated successfully");
    }

    private void ShowNotification(string message)
    {
        _notificationMessage = message;
        _showNotification = true;
        StateHasChanged();

        _ = Task.Run(async () =>
        {
            await Task.Delay(3000);
            _showNotification = false;
            await InvokeAsync(StateHasChanged);
        });
    }

    private void ShowDeleteConfirmation()
    {
        _showDeleteModal = true;
    }

    private void CancelDelete()
    {
        _showDeleteModal = false;
    }

    private async Task ConfirmDelete()
    {
        if (_dataSource is null) return;

        await ProjectSvc.DeleteDataSourceAsync(_dataSource.Id);
        _showDeleteModal = false;

        Nav.NavigateTo(AppRoutes.Dashboard);
    }

    public void Dispose()
    {
        ProjectSvc.Changed -= OnProjectChanged;
        _cancellationTokenSource?.Cancel();
        _cancellationTokenSource?.Dispose();
        _renderTimer?.Dispose();
    }
}
