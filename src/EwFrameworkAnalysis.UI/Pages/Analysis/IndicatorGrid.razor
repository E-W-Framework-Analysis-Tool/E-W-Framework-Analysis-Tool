@using EwFrameworkAnalysis.Common.FrameworkReferenceData
@using EwFrameworkAnalysis.Common.Models.Framework
@using EwFrameworkAnalysis.Common.Models.Project
@using EwFrameworkAnalysis.Common.Models.Scoring
@using EwFrameworkAnalysis.UI.Components
@using EwFrameworkAnalysis.UI.Options

<Card Shadow="Card.ShadowSize.XLarge" AdditionalClasses="tab-content rounded-tl-none">
    <ChildContent>

        @* Search *@
        <div class="flex gap-4 pb-4">
            <label class="input flex-1">
                <i class="fa-solid fa-magnifying-glass opacity-50"></i>
                <input type="search" placeholder="Search" @bind="_searchQuery" @bind:event="oninput" class="right-placeholder" />
                <span class="label">@FilteredIndicators.Count() of @_allIndicators.Count()</span>
            </label>

            <select class="select w-52" @bind="_selectedSector">
                <option value="">All Sectors</option>
                @foreach (var sector in Enum.GetValues<Sector>())
                {
                    <option value="@sector">@sector.GetDisplayName()</option>
                }
            </select>
        </div>

        @* List *@
        <div class="join join-vertical border-1 border-gray-300 rounded-lg">
            <SortableList List="@FilteredIndicators" Columns="@IndicatorColumnOptions()" DefaultSortColumn="@SortColumnNames.Score" Context="sortedIndicators">

                @* Headers *@
                <div class="collapse-title items-center font-semibold text-lg border-b border-gray-300">
                    <div class="grid grid-cols-24">
                        <div class="col-span-18 cursor-pointer" @onclick="() => sortedIndicators.Toggle(SortColumnNames.Name)">
                            Indicator
                            <span class="fa-stack fa-xs">
                                <i class="fas fa-stack-1x fa-sort-up @(sortedIndicators.IsActive(SortColumnNames.Name, true) ? "" : "opacity-50")"></i>
                                <i class="fas fa-stack-1x fa-sort-down @(sortedIndicators.IsActive(SortColumnNames.Name, false) ? "" : "opacity-50")"></i>
                            </span>
                        </div>
                        <div class="col-span-6 justify-self-center cursor-pointer" @onclick="() => sortedIndicators.Toggle(SortColumnNames.Score)">
                            Coverage Score
                            <span class="fa-stack fa-xs">
                                <i class="fas fa-stack-1x fa-sort-up @(sortedIndicators.IsActive(SortColumnNames.Score, true) ? "" : "opacity-50")"></i>
                                <i class="fas fa-stack-1x fa-sort-down @(sortedIndicators.IsActive(SortColumnNames.Score, false) ? "" : "opacity-50")"></i>
                            </span>
                        </div>
                    </div>
                </div>

                @* Add border between header and list *@
                <div class="join-item border-b border-gray-300"></div>

                @* List Items *@                
                @foreach (var (indicator, index) in sortedIndicators.List.Select((value, i) => (value, i)))
                {
                    var indicatorScore = GetIndicatorScoreByCode(indicator.Name) ?? new IndicatorCoverageScore();

                    <div class="collapse collapse-arrow join-item border-b border-gray-300">
                        <input type="checkbox" name="indicator-check-@index" />

                        @* Name, Definition, & Score *@
                        <div class="collapse-title font-semibold">
                            <div class="grid grid-cols-24">
                                <div class="flex-col col-span-18 justify-start items-center">
                                    @indicator.Name
                                    <div class="justify-start items-center font-normal text-gray-500">@indicator.Definition</div>
                                </div>
                                <div class="flex col-span-6 justify-center content-center flex-wrap gap-0.5 mx-4">
                                    <progress class="progress @GetProgressBarColor(indicatorScore.CoverageScore)" value="@(indicatorScore.CoverageScore * 100)" max="100"> </progress>
                                    @indicatorScore.CoverageScore.ToString("0.##%")
                                </div>
                            </div>
                        </div>

                        @* Collapsed Content *@
                        <div class="collapse-content text-sm">
                            <div class="grid grid-cols-24">
                                <div class="flex flex-col col-span-24 justify-start space-y-4">

                                    @* Domain, Type, & Data Elements *@
                                    <p class="font-semibold text-sm text-blue">Domain: <span class="font-normal text-gray">@indicator.Domain.GetDisplayName()</span></p>
                                    <p class="font-semibold text-sm text-blue">Indicator Type: <span class="font-normal text-gray">@indicator.Type.GetDisplayName()</span></p>
                                    <h5 class="font-semibold text-sm text-blue">Data Elements:</h5>
                                    <div class="flex flex-col gap-2">
                                        @foreach (var dataElementName in indicator.DataElementNames.Order())
                                        {
                                            var deScore = indicatorScore.DataElementScores.FirstOrDefault(x => x.DataElementName.Equals(dataElementName));
                                            <div class="text-sm text-gray">
                                                <i class="@GetDataElementIsAvailableIcon(indicatorScore, dataElementName)"></i>
                                                @if (deScore is { IsAvailable: true } && !string.IsNullOrEmpty(deScore.Source))
                                                {
                                                    <div class="dropdown dropdown-top dropdown-start inline-block">
                                                        <span tabindex="0" role="button" class="cursor-pointer hover:font-semibold focus:font-semibold transition-all">
                                                            @dataElementName
                                                            <i class="@GetDataSourceTypeIcon(deScore) text-gray-400 ml-1 text-xs"></i>
                                                        </span>
                                                        <ul tabindex="0" class="menu dropdown-content bg-base-100 rounded-box z-10 w-64 p-2 shadow-lg border border-gray-200">
                                                            <li class="menu-title text-sm text-gray-600">@dataElementName</li>
                                                            <li class="menu-title text-sm text-gray-400">Data Sources:</li>
                                                            @foreach (var source in deScore.SourceScores)
                                                            {
                                                                <li class="menu-title text-sm text-gray-600 @(source.DataSourceName == deScore.Source ? "bg-gray-200 rounded" : "")">
                                                                    <span class="text-sm">
                                                                        <i class="@GetSourceAvailabilityIcon(source.AvailabilityScore)"></i>
                                                                        @source.DataSourceName
                                                                    </span>
                                                                </li>
                                                            }
                                                        </ul>
                                                    </div>
                                                }
                                                else
                                                {
                                                    @dataElementName
                                                }
                                            </div>
                                        }
                                    </div>

                                    @* Recommended Metrics *@
                                    <h5 class="font-semibold text-sm text-blue">Recommended Metrics</h5>
                                    <p class="text-sm text-gray">@indicator.RecommendedMetrics</p>

                                    @* Sectors *@
                                    <h5 class="font-semibold text-sm text-blue">Sectors</h5>
                                    <div class="flex gap-2">
                                        @foreach (var sector in indicator.Sectors)
                                        {
                                            <div class="badge badge-secondary ">@sector.GetDisplayName()</div>
                                        }
                                    </div>

                                    @* Data Needed *@
                                    <h5 class="font-semibold text-sm text-blue">Data Needed</h5>
                                    <div class="flex gap-2">
                                        @foreach (var dataNeeded in indicator.DataNeeded)
                                        {
                                            <div class="badge badge-secondary ">@dataNeeded.GetDisplayName()</div>
                                        }
                                    </div>

                                    @* Essential Questions *@
                                    <h5 class="font-semibold text-sm text-blue">Essential Questions</h5>
                                    <ul class="flex flex-col gap-2 list-disc pl-5">
                                        @foreach (var eq in GetEssentialQuestionsForIndicator(indicator))
                                        {
                                            <li class="text-sm text-gray">
                                                # @eq.QuestionNumber - @eq.Question
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                }

            </SortableList>
        </div>

    </ChildContent>
</Card>

@code {
    [Parameter]
    public List<IndicatorCoverageScore> IndicatorScores { get; set; } = [];

    private IEnumerable<Indicator> _allIndicators = [];
    private List<EssentialQuestion> _allQuestions = [];
    private string _searchQuery = string.Empty;
    private string? _selectedSector = string.Empty;

    private static class SortColumnNames
    {
        public const string Name = nameof(Name);
        public const string Score = nameof(Score);
    }

    // TODO: we should refactor to project to a list of what is needed here rather than looking up the value N times by indicator code
    private List<SortColumn<Indicator>> IndicatorColumnOptions() =>
    [
        new SortColumn<Indicator> { Key = SortColumnNames.Name, Selector = eq => eq.Name, DefaultAscending = true },
        new SortColumn<Indicator> { Key = SortColumnNames.Score, Selector = i => GetIndicatorScoreByCode(i.Name)?.CoverageScore ?? 0m, DefaultAscending = false },
    ];

    protected override void OnInitialized()
    {
        _allIndicators = EwFrameworkIndicators.Indicators.Values.ToList();
        _allQuestions = EwFrameworkEssentialQuestions.Questions;
    }

    private IndicatorCoverageScore? GetIndicatorScoreByCode(string indicatorCode) =>
        IndicatorScores.FirstOrDefault(x => x.IndicatorCode == indicatorCode);

    private string GetProgressBarColor(decimal score) =>
        score switch
        {
            // Green (high score) gradient to Red (low score)
            > 0.66m => "progress-success",
            > 0.33m => "progress-warning",
            > 0m => "progress-error",
            _ => "bg-gray-200"
        };

    private string GetDataElementIsAvailableIcon(IndicatorCoverageScore indicatorScore, string dataElementName)
    {
        var score = indicatorScore.DataElementScores.FirstOrDefault(x => x.DataElementName.Equals(dataElementName));
        if (score is { IsAvailable: true })
        {
            return score.AvailabilityScore switch
            {
                AvailabilityJudgment.Available => "fas fa-check-circle text-success",
                AvailabilityJudgment.PartiallyAvailable => "fas fa-triangle-exclamation text-warning",
                _ => ""
            };
        }

        return "fas fa-times-circle text-error";
    }

    private static string GetSourceAvailabilityIcon(AvailabilityJudgment judgment) =>
        judgment switch
        {
            AvailabilityJudgment.Available => "fas fa-check-circle text-success",
            AvailabilityJudgment.PartiallyAvailable => "fas fa-triangle-exclamation text-warning",
            AvailabilityJudgment.NotAvailable => "fas fa-times-circle text-error",
            _ => "fas fa-question-circle text-gray-400"
        };

    private static string GetDataSourceTypeIcon(DataElementScore score)
    {
        var selectedSource = score.SourceScores.FirstOrDefault(s => s.DataSourceName == score.Source);
        return selectedSource?.SourceType switch
        {
            nameof(DataSourceType.EdFiApi) => "fas fa-network-wired",
            nameof(DataSourceType.CedsDw) => "fas fa-warehouse",
            nameof(DataSourceType.Custom) => "fas fa-list-check",
            nameof(DataSourceType.EcsState) => "fas fa-map",
            _ => "fas fa-database"
        };
    }

    private IEnumerable<EssentialQuestion> GetEssentialQuestionsForIndicator(Indicator indicator) =>
        _allQuestions
            .Where(eq => eq.RelatedIndicatorNames.Contains(indicator.Name));

    private IEnumerable<Indicator> FilteredIndicators =>
        _allIndicators
            .Where(q =>
                string.IsNullOrWhiteSpace(_searchQuery)
                || q.Name.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)
                || q.Definition.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase))
            .Where(q =>
                string.IsNullOrWhiteSpace(_selectedSector)
                || q.Sectors.Contains(Enum.Parse<Sector>(_selectedSector))
            );
}
