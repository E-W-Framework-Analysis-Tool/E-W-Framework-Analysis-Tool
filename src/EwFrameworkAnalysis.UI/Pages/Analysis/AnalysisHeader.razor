@using EwFrameworkAnalysis.UI.Components
@using EwFrameworkAnalysis.UI.Services

<Card Overflow Shadow="Card.ShadowSize.XLarge" AdditionalClasses="mb-6" NoPadding>
    <ChildContent>
        <div class="px-4 py-5 sm:p-6">
            <div class="flex items-start justify-between gap-4">
                <!-- Left: Title and Description -->
                <div class="flex-1 min-w-0 space-y-3">
                    <div class="flex items-start gap-2 items-center">
                        <h2 class="text-2xl font-title font-bold text-blue truncate">Reports and Analysis</h2>
                    </div>

                    <div class="flex items-start gap-2 items-center">
                        <h3 class="text-lg font-title font-semibold text-blue">Comprehensive analysis of your framework readiness assessment results</h3>
                    </div>
                </div>

                <!-- Right: Actions -->
                <div class="flex items-center space-x-3 flex-shrink-0">
                    <button class="btn btn-primary gap-2" @onclick="DownloadReportAsync" disabled="@_isGenerating" data-walkthrough="@WalkthroughSteps.StepIds.DownloadReportButton">
                        @if (_isGenerating)
                        {
                            <span class="loading loading-spinner loading-sm"></span>
                        }
                        else
                        {
                            <i class="fas fa-file-pdf"></i>
                        }
                        View Report
                    </button>
                </div>
            </div>
        </div>
    </ChildContent>
</Card>

@code {
    [Parameter, EditorRequired]
    public EventCallback OnGenerateReport { get; set; }

    private bool _isGenerating;

    private async Task DownloadReportAsync()
    {
        _isGenerating = true;
        try
        {
            await OnGenerateReport.InvokeAsync();
        }
        finally
        {
            _isGenerating = false;
        }
    }
}
