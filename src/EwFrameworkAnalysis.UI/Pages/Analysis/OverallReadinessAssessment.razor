@using EwFrameworkAnalysis.Common.Models.Scoring
@using EwFrameworkAnalysis.UI.Components

<Card Overflow Title="Data Sources" AdditionalClasses="mb-6" NoPadding>
    <ChildContent>
        <div class="px-4 pb-5 sm:px-6 sm:pb-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

                @* Coverage Comparison *@
                <div class="flex flex-col gap-4">
                    <h2 class="flex font-semibold">Coverage By Data Source Type</h2>

                    <div class="flex flex-1 flex-col space-y-2">
                        <div class="flex justify-between">
                            <div class="text-gray-500">Manual Entry Data Sources</div>
                            <div class="font-semibold">@CoverageScores.Manual.ToString("0.##%")</div>
                        </div>
                        <div class="flex">
                            <progress class="progress progress-primary bg-gray-200 h-3" value="@(CoverageScores.Manual * 100)" max="100"></progress>
                        </div>
                    </div>

                    <div class="flex flex-1 flex-col space-y-2">
                        <div class="flex justify-between">
                            <div class="text-gray-500">Automated Scan Data Sources (Ed-Fi &amp; CEDS)</div>
                            <div class="font-semibold">@CoverageScores.Automated.ToString("0.##%")</div>
                        </div>
                        <div class="flex">
                            <progress class="progress progress-accent bg-gray-200 h-3" value="@(CoverageScores.Automated * 100)" max="100"></progress>
                        </div>
                    </div>

                    <div class="flex flex-1 flex-col space-y-2">
                        <div class="flex justify-between">
                            <div class="text-gray-500">ECS Reference Profile (State Data)</div>
                            <div class="font-semibold">@CoverageScores.Ecs.ToString("0.##%")</div>
                        </div>
                        <div class="flex">
                            <progress class="progress progress-info bg-gray-200 h-3" value="@(CoverageScores.Ecs * 100)" max="100"></progress>
                        </div>
                    </div>

                    <div class="flex flex-1 flex-col space-y-2">
                        <div class="flex justify-between">
                            <div class="text-gray-500">Combined (All Data Sources)</div>
                            <div class="font-semibold">@CoverageScores.Combined.ToString("0.##%")</div>
                        </div>
                        <div class="flex">
                            <progress class="progress progress-secondary bg-gray-200 h-3" value="@(CoverageScores.Combined * 100)" max="100"></progress>
                        </div>
                    </div>
                </div>

                @* Highest ROI Data Elements *@
                <div class="flex flex-col gap-4">
                    <div class="flex flex-col gap-0.5">
                        <h2 class="font-semibold">Highest ROI Data Elements</h2>
                        <p class="text-xs text-gray-500">Data elements whose availability would improve the most indicators</p>
                    </div>

                    @if (_roiItems.Count > 0)
                    {
                        <ol class="flex flex-col gap-3">
                            @foreach (var item in _roiItems)
                            {
                                <li class="flex items-center gap-2">
                                    <span class="font-semibold text-sm">@item.Name</span>
                                    <button class="badge badge-neutral badge-sm shrink-0 cursor-pointer hover:badge-primary transition-colors"
                                            @onclick="() => _selectedItem = item">
                                        @item.Indicators.Count indicator@(item.Indicators.Count != 1 ? "s" : "")
                                    </button>
                                </li>
                            }
                        </ol>
                    }
                    else
                    {
                        <p class="text-sm text-gray-400">No unscored data elements found. Run a data profiler to see ROI recommendations.</p>
                    }
                </div>

            </div>
        </div>
    </ChildContent>
</Card>

<Modal IsOpen="@(_selectedItem != null)"
       IsOpenChanged="@(v => { if (!v) _selectedItem = null; })"
       Title="@(_selectedItem?.Name ?? "")"
       ShowCloseButton="true">
    <Body>
        <p class="text-sm text-gray-500 mb-4">
            Improving this data element's availability would affect the following
            @_selectedItem?.Indicators.Count indicator@(_selectedItem?.Indicators.Count != 1 ? "s" : ""):
        </p>
        <ul class="flex flex-col gap-2">
            @foreach (var indicator in _selectedItem?.Indicators ?? [])
            {
                <li class="flex items-start gap-2 text-sm">
                    <span class="text-gray-400 mt-0.5">•</span>
                    <span>@indicator</span>
                </li>
            }
        </ul>
    </Body>
    <Footer>
        <div class="flex justify-end">
            <button class="btn btn-ghost" @onclick="() => _selectedItem = null">Close</button>
        </div>
    </Footer>
</Modal>

@code {
    [Parameter, EditorRequired]
    public SourceTypeCoverageBreakdown CoverageScores { get; set; } = new();

    [Parameter, EditorRequired]
    public IReadOnlyList<IndicatorCoverageScore> IndicatorScores { get; set; } = [];

    private record RoiItem(string Name, List<string> Indicators, decimal PotentialImpact);

    private List<RoiItem> _roiItems = [];
    private RoiItem? _selectedItem;

    protected override void OnParametersSet()
    {
        var uniqueIndicators = IndicatorScores
            .DistinctBy(i => i.IndicatorCode)
            .ToList();

        _roiItems = uniqueIndicators
            .SelectMany(i => i.DataElementScores
                .Where(de => de.QualityScore < 1.0m)
                .Select(de => new { i.IndicatorCode, DataElement = de }))
            .GroupBy(x => x.DataElement.DataElementName)
            .Select(g => new RoiItem(
                Name: g.Key,
                Indicators: g.Select(x => x.IndicatorCode).Distinct().OrderBy(x => x).ToList(),
                PotentialImpact: g.Sum(x => 1.0m - x.DataElement.QualityScore)
            ))
            .OrderByDescending(x => x.PotentialImpact)
            .ThenByDescending(x => x.Indicators.Count)
            .Take(5)
            .ToList();
    }
}
