@using EwFrameworkAnalysis.Common.FrameworkReferenceData
@using EwFrameworkAnalysis.Common.Models.Framework
@using EwFrameworkAnalysis.Common.Models.Scoring
@using EwFrameworkAnalysis.UI.Components
@using EwFrameworkAnalysis.UI.Options

<Card Title="Essential Questions" Shadow="Card.ShadowSize.XLarge">
    <ChildContent>
        <div class="flex gap-4 pb-4">
            @* Search *@
            <label class="input flex-1">
                <i class="fa-solid fa-magnifying-glass opacity-50"></i>
                <input type="search" placeholder="Search" @bind="_searchQuery" @bind:event="oninput"/>
            </label>

            <select class="select w-52" @bind="_selectedSector">
                <option value="">All Sectors</option>
                @foreach (var sector in Enum.GetValues<Sector>())
                {
                    <option value="@sector">@sector.GetDisplayName()</option>
                }
            </select>
        </div>

        @* List *@
        <div class="join join-vertical border-1 border-gray-300 rounded-lg">
            <SortableList List="@FilteredQuestions" Columns="@EssentialQuestionColumnOptions()" Context="eqContext">
                <div class="collapse-title font-semibold">
                    <div class="grid grid-cols-24 font-semibold text-lg">

                        <div class="flex col-span-1 justify-start items-center" @onclick="() => eqContext.Toggle(SortColumnNames.Question)">#</div>
                        <div class="flex col-span-17 justify-start items-center" @onclick="() => eqContext.Toggle(SortColumnNames.Question)">
                            Question
                            <span class="fa-stack fa-xs">
                                <i class="fas fa-stack-1x fa-sort-up @(eqContext.IsActive(SortColumnNames.Question, true) ? "" : "opacity-50")"></i>
                                <i class="fas fa-stack-1x fa-sort-down @(eqContext.IsActive(SortColumnNames.Question, false) ? "" : "opacity-50")"></i>
                            </span>
                        </div>
                        <div class="flex col-span-4 justify-center items-center text-center" @onclick="() => eqContext.Toggle(SortColumnNames.Score)">Indicators Aligned</div>
                        <div class="flex col-span-2 justify-center items-center text-center px-4 gap-4" @onclick="() => eqContext.Toggle(SortColumnNames.Score)">
                            Score
                            <span class="fa-stack fa-xs">
                                <i class="fas fa-stack-1x fa-sort-up @(eqContext.IsActive(SortColumnNames.Score, true) ? "" : "opacity-50")"></i>
                                <i class="fas fa-stack-1x fa-sort-down @(eqContext.IsActive(SortColumnNames.Score, false) ? "" : "opacity-50")"></i>
                            </span>
                        </div>
                    </div>
                </div>

                <div class="join-item border-b border-gray-300"></div>
                @foreach (var q in PagedQuestions(eqContext.List))
                {
                    var qs = GetQuestionScoreByNumber(q.QuestionNumber) ?? new QuestionScore();

                    <div class="collapse collapse-arrow join-item border-b border-gray-300">
                        <input type="checkbox" name="question-check-@q.QuestionNumber"/>
                        <div class="collapse-title font-semibold">
                            <div class="grid grid-cols-24">
                                <div class="flex col-span-1 justify-start items-center">@q.QuestionNumber</div>
                                <div class="flex col-span-17 justify-start items-center">@q.Question</div>
                                <div class="flex col-span-4 justify-center items-center flex-wrap gap-0.5 mx-4">
                                    @foreach (var indicatorScore in qs.IndicatorScores.OrderByDescending(x => x.ReadinessScore))
                                    {
                                        <div class="flex w-2 h-2 rounded-full @GetIndicatorColor(indicatorScore.ReadinessScore)"></div>
                                    }
                                </div>
                                <div class="flex col-span-2 justify-center items-center text-center"> @qs.ReadinessScore.ToString("0.##%")</div>
                            </div>
                        </div>
                        <div class="collapse-content  text-sm">
                            <div class="grid grid-cols-24">
                                <div class="flex col-span-1 justify-start items-center"><!-- EMPTY / PLACEHOLDER --></div>
                                <div class="flex flex-col col-span-21 justify-start items-center space-y-2">
                                    <SortableList List="@qs.IndicatorScores" Columns="@IndicatorColumnOptions()" Context="indicatorContext">
                                        <h3 class="flex w-full font-semibold text-lg" @onclick="() => indicatorContext.Toggle(SortColumnNames.Indicators)">
                                            Indicators
                                            <span class="fa-stack fa-xs">
                                                <i class="fas fa-stack-1x fa-sort-up @(indicatorContext.IsActive(SortColumnNames.Indicators, true) ? "" : "opacity-50")"></i>
                                                <i class="fas fa-stack-1x fa-sort-down @(indicatorContext.IsActive(SortColumnNames.Indicators, false) ? "" : "opacity-50")"></i>
                                            </span>
                                        </h3>
                                        <div class="grid grid-cols-12 w-full gap-4 items-stretch">
                                            @foreach (var indicatorScore in indicatorContext.List)
                                            {
                                                <div class="col-span-12 md:col-span-6 xl:col-span-4" @onclick="() => ShowIndicatorDetails(indicatorScore)">
                                                    <div class="card border border-gray-300 rounded-md w-full h-full p-4 gap-4 hover:translate-0.5 hover:shadow transition duration-200">
                                                        <p class="font-semibold">@(indicatorScore.IndicatorCode) (@indicatorScore.ReadinessScore.ToString("0.##%"))</p>
                                                        <progress class="progress @GetProgressBarColor(indicatorScore.ReadinessScore)" value="@(indicatorScore.ReadinessScore * 100)" max="100"></progress>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </SortableList>
                                </div>
                                <div class="flex col-span-2 justify-center items-center"><!-- EMPTY / PLACEHOLDER --></div>
                            </div>
                        </div>
                    </div>
                }
            </SortableList>
        </div>

        @if (TotalPages > 1)
        {
            <div class="flex justify-center mt-6">
                <div class="join">
                    <button class="join-item btn shadow-none @(_currentPage == 1 ? "btn-secondary opacity-80" : "btn-secondary hover:opacity-90")"
                            @onclick="PreviousPage">
                        <i class="fas fa-chevron-left"></i>
                    </button>

                    @for (int page = 1; page <= TotalPages; page++)
                    {
                        <!-- capture local copy -->
                        var p = page;
                        <button class="join-item btn shadow-none @(_currentPage == p ? "btn-secondary opacity-80" : "btn-secondary hover:opacity-90")"
                                @onclick="@(() => GoToPage(p))">
                            @(p)
                        </button>
                    }

                    <button class="join-item btn shadow-none @(_currentPage == TotalPages ? "btn-secondary opacity-80" : "btn-secondary hover:opacity-90")" @onclick="NextPage">
                        <i class="fas fa-chevron-right"></i>
                    </button>
                </div>
            </div>
        }
    </ChildContent>
</Card>


<IndicatorDetailsModal _indicatorScore="@_selectedIndicatorScore"
                       IsOpen="@_showIndicatorDetails"
                       OnClose="HandleModalClosed"
                       IsOpenChanged="@(x => _showIndicatorDetails = x)"/>

@code {

    [Parameter]
    public List<QuestionScore> QuestionScores { get; set; } = new();

    private List<EssentialQuestion> _allQuestions = [];
    private string _searchQuery = string.Empty;
    private string? _selectedSector = string.Empty;

    private int _pageSize = 20;
    private int _currentPage = 1;

    private bool _showIndicatorDetails = false;
    private IndicatorScore? _selectedIndicatorScore;

    private static class SortColumnNames
    {
        public const string Question = nameof(Question);
        public const string Score = nameof(Score);
        public const string IndicatorsAligned = nameof(IndicatorsAligned);
        public const string Indicators = nameof(Indicators);
    }

    private List<SortColumn<EssentialQuestion>> EssentialQuestionColumnOptions() =>
    [
        new SortColumn<EssentialQuestion> { Key = SortColumnNames.Question, Selector = eq => eq.QuestionNumber },
        new SortColumn<EssentialQuestion> { Key = SortColumnNames.Score, Selector = eq => (GetQuestionScoreByNumber(eq.QuestionNumber) ?? new QuestionScore()).ReadinessScore }
    ];

    private List<SortColumn<IndicatorScore>> IndicatorColumnOptions() =>
    [
        new SortColumn<IndicatorScore> { Key = SortColumnNames.Indicators, Selector = i => -i.ReadinessScore }
    ];

    protected override void OnInitialized()
    {
        _allQuestions = EwFrameworkEssentialQuestions.Questions;
    }

    private QuestionScore? GetQuestionScoreByNumber(int questionNumber)
    {
        return QuestionScores.FirstOrDefault(x => x.QuestionNumber == questionNumber);
    }

    private string GetIndicatorColor(decimal score) =>
        score switch
        {
            // Green (high score) gradient to Red (low score)
            > 0.66m => "bg-success/80",
            > 0.33m => "bg-warning/80",
            > 0m => "bg-error/80",
            _ => "bg-gray-200"
        };

    private string GetProgressBarColor(decimal score) =>
        score switch
        {
            // Green (high score) gradient to Red (low score)
            > 0.66m => "progress-success",
            > 0.33m => "progress-warning",
            > 0m => "progress-error",
            _ => "bg-gray-200"
        };

    private int TotalPages => (int)Math.Ceiling((double)FilteredQuestions.Count() / _pageSize);

    private IEnumerable<EssentialQuestion> FilteredQuestions =>
        _allQuestions
            .Where(q =>
                (string.IsNullOrWhiteSpace(_searchQuery) ||
                    q.Question.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    q.RelatedIndicatorNames.Any(name => name.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)))
            )
            .Where(q =>
                string.IsNullOrWhiteSpace(_selectedSector) ||
                q.ApplicableSectors.Contains(Enum.Parse<Sector>(_selectedSector))
            );

    private IEnumerable<EssentialQuestion> PagedQuestions(IEnumerable<EssentialQuestion> list) =>
        list
            .Skip((_currentPage - 1) * _pageSize)
            .Take(_pageSize);

    private void ClearSearch()
    {
        _searchQuery = string.Empty;
    }

    private void NextPage()
    {
        if (_currentPage < TotalPages)
            _currentPage++;
    }

    private void PreviousPage()
    {
        if (_currentPage > 1)
            _currentPage--;
    }

    private void GoToPage(int page)
    {
        _currentPage = page;
    }

    private void ShowIndicatorDetails(IndicatorScore indicatorScore)
    {
        _selectedIndicatorScore = indicatorScore;
        _showIndicatorDetails = true;
    }

    private void HandleModalClosed()
    {
        _showIndicatorDetails = false;
        _selectedIndicatorScore = null;
    }

}
