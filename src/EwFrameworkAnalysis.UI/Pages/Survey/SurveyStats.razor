@using EwFrameworkAnalysis.UI.Pages.Survey

<div class="grid grid-cols-3 gap-3">
    <SurveyDonutCard Title="Interest"     Slices="_interestSlices"     Total="_total" />
    <SurveyDonutCard Title="Availability" Slices="_availabilitySlices" Total="_total" />
    <SurveyDonutCard Title="Can Share"    Slices="_canShareSlices"      Total="_total" />
</div>

@code {
    [Parameter] public Dictionary<string, SurveyResponse> Responses { get; set; } = new();
    [Parameter] public int TotalElements { get; set; }

    private int _total => TotalElements;

    private List<SurveyDonutCard.DonutSlice> _interestSlices = [];
    private List<SurveyDonutCard.DonutSlice> _availabilitySlices = [];
    private List<SurveyDonutCard.DonutSlice> _canShareSlices = [];

    protected override void OnParametersSet() => BuildData();

    private void BuildData()
    {
        _interestSlices =
        [
            new("High",    Responses.Values.Count(r => r.Interest == InterestLevel.HighPriority), "#22c55e"),
            new("Low",     Responses.Values.Count(r => r.Interest == InterestLevel.LowPriority),  "#f59e0b"),
            new("None",    Responses.Values.Count(r => r.Interest == InterestLevel.NoInterest),   "#ef4444"),
        ];

        _availabilitySlices =
        [
            new("Avail",   Responses.Values.Count(r => r.Availability == SurveyAvailability.Available),          "#22c55e"),
            new("Partial", Responses.Values.Count(r => r.Availability == SurveyAvailability.PartiallyAvailable), "#f59e0b"),
            new("No",      Responses.Values.Count(r => r.Availability == SurveyAvailability.NotAvailable),       "#ef4444"),
        ];

        _canShareSlices =
        [
            new("Yes", Responses.Values.Count(r => r.CanQueryAndShare == true),  "#22c55e"),
            new("No",  Responses.Values.Count(r => r.CanQueryAndShare == false), "#ef4444"),
        ];
    }
}
