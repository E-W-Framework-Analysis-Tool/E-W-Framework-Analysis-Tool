@page "/assessment/edfi/run"
@using System.Net.Http.Headers
@using System.Text.Json
@using EwFrameworkAnalysis.Common.Assessors.EdFi
@using EwFrameworkAnalysis.Common.Services
@using EwFrameworkAnalysis.Common.Models.Project
@using System.Diagnostics
@inject EdFiAssessmentOrchestrator Orchestrator
@inject HttpClient HttpClient

<!-- THIS PAGE IS FOR DEMONSTRATION PURPOSES ONLY -->
<!-- This functionality will be integrated into the Data Source Details page eventually -->

<div class="container mx-auto p-6 max-w-7xl">
    <!-- Header -->
    <div class="mb-8">
        <h1 class="text-4xl font-bold mb-2">Ed-Fi ODS API v7.3 (DS v5.2)</h1>
        <p class="text-base-content/70">Configure and execute data assessment against an Ed-Fi API</p>
    </div>

    <div class="mb-6">
        <div class="card bg-base-200 shadow-lg">
            <div class="card-body">
                <h2 class="card-title text-xl mb-4">Data Source Configuration for Assessment</h2>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="form-control">
                        <label class="label">
                            <span class="label-text font-semibold">Base URL</span>
                        </label>
                        <input type="text"
                        @bind="_rootUrl"
                        class="input input-bordered w-full font-mono text-sm" />
                    </div>

                    <div class="form-control">
                        <label class="label">
                            <span class="label-text font-semibold">Client ID</span>
                        </label>
                        <input type="text"
                        @bind="_clientId"
                        class="input input-bordered w-full font-mono text-sm" />
                    </div>

                    <div class="form-control">
                        <label class="label">
                            <span class="label-text font-semibold">Client Secret</span>
                        </label>
                        <input type="password"
                        @bind="_clientSecret"
                        class="input input-bordered w-full font-mono text-sm" />
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_validationError))
                {
                    <div class="alert alert-error mt-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        <span>@_validationError</span>
                    </div>
                }

                <div class="card-actions justify-end mt-4">
                    <button class="btn btn-primary px-8" @onclick="StartAssessment" disabled="@(!IsFormValid())">
                        <span class="loading loading-spinner loading-sm mr-2" hidden="@(!_isRunning)"></span>
                        Start Assessment
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (_currentProgress != null)
    {
        <!-- Overall Progress Section -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
            <!-- Progress Card -->
            <div class="card bg-base-200 shadow-lg">
                <div class="card-body">
                    <h3 class="card-title text-sm text-base-content/70">Overall Progress</h3>
                    <div class="flex items-end gap-2">
                        <span class="text-5xl font-bold">@_currentProgress.PercentComplete</span>
                        <span class="text-2xl text-base-content/70 mb-1">%</span>
                    </div>
                    <progress class="progress progress-primary w-full h-3 mt-2"
                    value="@_currentProgress.PercentComplete"
                    max="100"></progress>
                </div>
            </div>

            <!-- Completed Count -->
            <div class="card bg-base-200 shadow-lg">
                <div class="card-body">
                    <h3 class="card-title text-sm text-base-content/70">Assessors Complete</h3>
                    <div class="flex items-end gap-2">
                        <span class="text-5xl font-bold">@_currentProgress.CompletedAssessors</span>
                        <span class="text-2xl text-base-content/70 mb-1">/ @_currentProgress.TotalAssessors</span>
                    </div>
                </div>
            </div>

            <!-- Status Breakdown -->
            <div class="card bg-base-200 shadow-lg">
                <div class="card-body">
                    <h3 class="card-title text-sm text-base-content/70 mb-3">Status</h3>
                    <div class="space-y-2">
                        <div class="flex justify-between text-sm">
                            <span class="flex items-center gap-2">
                                <span class="inline-block w-3 h-3 rounded-full bg-yellow-500"></span>
                                Running
                            </span>
                            <span class="font-bold">@_currentProgress.AssessorProgresses.Count(a => a.Status == AssessorStatus.Running)</span>
                        </div>
                        <div class="flex justify-between text-sm">
                            <span class="flex items-center gap-2">
                                <span class="inline-block w-3 h-3 rounded-full bg-success"></span>
                                Completed
                            </span>
                            <span class="font-bold">@_currentProgress.AssessorProgresses.Count(a => a.Status == AssessorStatus.Completed)</span>
                        </div>
                        <div class="flex justify-between text-sm">
                            <span class="flex items-center gap-2">
                                <span class="inline-block w-3 h-3 rounded-full bg-error"></span>
                                Failed
                            </span>
                            <span class="font-bold">@_currentProgress.AssessorProgresses.Count(a => a.Status == AssessorStatus.Failed)</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Assessor Progress List -->
        <div class="card bg-base-200 shadow-xl">
            <div class="card-body">
                <h2 class="card-title text-2xl mb-4">Assessor Progress</h2>

                <div class="space-y-3 max-h-[600px] overflow-y-auto">
                    @foreach (var assessor in _currentProgress.AssessorProgresses)
                    {
                        <div class="card bg-base-100 shadow @GetStatusClass(assessor.Status)">
                            <div class="card-body p-4">
                                <div class="flex items-start justify-between gap-4">
                                    <div class="flex-1">
                                        <div class="flex items-center gap-3 mb-2">
                                            @if (assessor.Status == AssessorStatus.Pending)
                                            {
                                                <span class="loading loading-ring loading-xs opacity-30"></span>
                                            }
                                            else if (assessor.Status == AssessorStatus.Running)
                                            {
                                                <span class="loading loading-spinner loading-sm text-warning"></span>
                                            }
                                            else if (assessor.Status == AssessorStatus.Completed)
                                            {
                                                <span class="text-success text-xl">✓</span>
                                            }
                                            else if (assessor.Status == AssessorStatus.Failed)
                                            {
                                                <span class="text-error text-xl">✗</span>
                                            }

                                            <h3 class="font-semibold">@assessor.DataElementName</h3>
                                        </div>

                                        @if (assessor.Status == AssessorStatus.Completed && assessor.Result != null)
                                        {
                                            <div class="text-sm text-success ml-7 mb-2">
                                                Completed • @assessor.Result.Characteristics.Count characteristic(s) collected
                                            </div>

                                            @if (assessor.Result.Characteristics.Any())
                                            {
                                                <div class="ml-7 space-y-1">
                                                    @foreach (var characteristic in assessor.Result.Characteristics)
                                                    {
                                                        <div class="text-xs bg-base-200 rounded px-2 py-1 inline-block mr-2">
                                                            <span class="font-semibold">@characteristic.GetType().Name:</span>
                                                            @if (characteristic is RecordCount rc)
                                                            {
                                                                <span class="font-mono ml-1">@rc.Value.ToString("N0")</span>
                                                            }
                                                            else if (characteristic is IntegerRange ir)
                                                            {
                                                                <span class="font-mono ml-1">@ir.Minimum - @ir.Maximum (@ir.Label)</span>
                                                            }
                                                            else if (characteristic is Completeness c)
                                                            {
                                                                <span class="font-mono ml-1">@c.PopulatedRecords.ToString("N0") / @c.TotalRecords.ToString("N0") (@c.Percentage.ToString("F1")%) - @c.AttributeName</span>
                                                            }
                                                            else if (characteristic is Distribution dist)
                                                            {
                                                                var total = dist.Counts.Values.Sum();

                                                                <div class="mt-1 space-y-1">
                                                                    <span class="font-semibold">@dist.Label</span>
                                                                    <div class="space-y-1">
                                                                        @foreach (var kvp in dist.Counts.OrderByDescending(k => k.Value))
                                                                        {
                                                                            var percentage = total > 0
                                                                            ? (int)((double)kvp.Value / total * 100)
                                                                            : 0;

                                                                            <div class="flex items-center text-xs">
                                                                                <span class="w-24 truncate">@dist.FormatItem(kvp.Key, kvp.Value)</span>
                                                                                <div class="flex-1 ml-2">
                                                                                    <div class="bg-base-200 rounded h-2">
                                                                                        <div class="bg-primary h-2 rounded" style="width:@percentage%"></div>
                                                                                    </div>
                                                                                </div>
                                                                                <span class="ml-2 font-mono">@percentage%</span>
                                                                            </div>
                                                                        }
                                                                    </div>
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <span class="ml-1">@characteristic.ToString()</span>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        }
                                        else if (assessor.Status == AssessorStatus.Running)
                                        {
                                            <div class="ml-7">
                                                @if (assessor.ProgressPercentage.HasValue)
                                                {
                                                    <div class="flex items-center gap-3 mb-1">
                                                        <progress class="progress progress-warning w-32 h-2"
                                                        value="@assessor.ProgressPercentage.Value"
                                                        max="100"></progress>
                                                        <span class="text-xs font-mono text-warning">@assessor.ProgressPercentage.Value%</span>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrEmpty(assessor.StatusMessage))
                                                {
                                                    <div class="text-sm text-warning">
                                                        @assessor.StatusMessage
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="text-sm text-warning">
                                                        Assessing data...
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else if (assessor.Status == AssessorStatus.Failed)
                                        {
                                            <div class="text-sm text-error ml-7">
                                                Failed: @assessor.ErrorMessage
                                            </div>
                                        }
                                        else if (assessor.Status == AssessorStatus.Pending)
                                        {
                                            <div class="text-sm text-base-content/50 ml-7">
                                                Waiting to start...
                                            </div>
                                        }

                                        @if (assessor.LogMessages.Any() && _showLogs.Contains(assessor.DataElementName))
                                        {
                                            <div class="ml-7 mt-3 p-3 bg-base-200 rounded-lg text-xs font-mono max-h-40 overflow-y-auto">
                                                @foreach (var log in assessor.LogMessages.TakeLast(10))
                                                {
                                                    <div class="text-base-content/70 mb-1">@log</div>
                                                }
                                            </div>
                                        }

                                        @if (assessor.LogMessages.Any())
                                        {
                                            <button class="btn btn-ghost btn-xs ml-7 mt-2"
                                            @onclick="() => ToggleLogs(assessor.DataElementName)">
                                                @if (_showLogs.Contains(assessor.DataElementName))
                                                {
                                                    <span>▼ Hide logs</span>
                                                }
                                                else
                                                {
                                                    <span>▶ Show logs (@assessor.LogMessages.Count)</span>
                                                }
                                            </button>
                                        }
                                    </div>

                                    <div class="badge @GetStatusBadgeClass(assessor.Status)">
                                        @assessor.Status.ToString()
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @if (_isRunning)
                {
                    <div class="card-actions justify-end mt-6">
                        <button class="btn btn-error" @onclick="CancelAssessment">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8 7a1 1 0 00-1 1v4a1 1 0 001 1h4a1 1 0 001-1V8a1 1 0 00-1-1H8z" clip-rule="evenodd" />
                            </svg>
                            Cancel Assessment
                        </button>
                    </div>
                }
                else if (_assessmentResult != null)
                {
                    <div class="alert alert-success mt-6">
                        <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        <div>
                            <h3 class="font-bold">Assessment Complete!</h3>
                            <div class="text-sm">
                                Collected @_assessmentResult.DataElementAssessments.Count assessments
                                with @_assessmentResult.DataElementAssessments.Sum(a => a.Characteristics.Count) total characteristics
                            </div>
                        </div>
                    </div>
                    <div class="card-actions justify-end mt-4">
                        <button class="btn btn-ghost" @onclick="Reset">
                            Run Another Assessment
                        </button>
                    </div>
                }
            </div>
        </div>
    }

    @if (_error != null)
    {
        <div class="alert alert-error mt-6 shadow-lg">
            <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <div>
                <h3 class="font-bold">Error</h3>
                <div class="text-sm">@_error</div>
            </div>
            <button class="btn btn-sm btn-ghost" @onclick="Reset">Dismiss</button>
        </div>
    }
</div>

@code {
    // Pre-populated with demo values
    private string _rootUrl = "http://localhost:5000/GrandBend/";

    // Derived URLs
    private string DataApiUrl => EnsureTrailingSlash(_rootUrl) + "data/v3/";
    private string AuthUrl => EnsureTrailingSlash(_rootUrl) + "oauth/token";

    private string _clientId = "RvcohKz9zHI4";
    private string _clientSecret = "E1676E88-4D3B-4E4E-B7B7-7C3F8E5D2A9C";
    private bool _isRunning = false;
    private AssessmentProgress? _currentProgress;
    private DataSourceAssessment? _assessmentResult;
    private string? _error;
    private string? _validationError;
    private CancellationTokenSource? _cancellationTokenSource;
    private HashSet<string> _showLogs = new();
    
    private bool IsFormValid()
    {
        return !string.IsNullOrWhiteSpace(_rootUrl)
            && !string.IsNullOrWhiteSpace(_clientId)
            && !string.IsNullOrWhiteSpace(_clientSecret);
    }

    private static string EnsureTrailingSlash(string url)
    {
        if (string.IsNullOrWhiteSpace(url))
            return url;
        return url.EndsWith("/") ? url : url + "/";
    }

    private Timer? _renderTimer;
    private volatile bool _pendingRender;

    private void OnProgressUpdate(AssessmentProgress p)
    {
        _currentProgress = p;
        _pendingRender = true;

        _renderTimer ??= new Timer(_ =>
        {
            if (_pendingRender)
            {
                _pendingRender = false;
                InvokeAsync(StateHasChanged);
            }
        }, null, 0, 500); // every 500ms
    }

    private async Task StartAssessment()
    {
        _validationError = null;
        _error = null;

        if (!Uri.TryCreate(DataApiUrl, UriKind.Absolute, out var baseUri))
        {
            _validationError = "Invalid Root URL";
            return;
        }

        try
        {
            _isRunning = true;
            _cancellationTokenSource = new CancellationTokenSource();

            var httpClient = new HttpClient { BaseAddress = baseUri };

            // Acquire token using client credentials
            var token = await GetAccessTokenAsync(AuthUrl, _clientId, _clientSecret);
            httpClient.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", token);

            var dataSource = new DataSource
                {
                    Id = Guid.NewGuid(),
                    Name = "Ed-Fi API",
                    Type = DataSourceType.EdFiApi,
                    Enabled = true
                };

            var progress = new Progress<AssessmentProgress>(OnProgressUpdate);

            _assessmentResult = await Orchestrator.RunAssessmentsAsync(
                httpClient,
                dataSource,
                $"Assessment {DateTime.Now:yyyy-MM-dd HH:mm}",
                "",
                progress,
                true,
                _cancellationTokenSource.Token
            );

            httpClient.Dispose();
        }
        catch (OperationCanceledException)
        {
            _error = "Assessment was cancelled by user.";
        }
        catch (Exception ex)
        {
            _error = $"Assessment failed: {ex.Message}";
        }
        finally
        {
            _isRunning = false;
            _cancellationTokenSource?.Dispose();
            _cancellationTokenSource = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<string> GetAccessTokenAsync(string authUrl, string clientId, string clientSecret)
    {
        using var authClient = new HttpClient();

        var tokenRequest = new HttpRequestMessage(HttpMethod.Post, authUrl);
        var formData = new Dictionary<string, string>
            {
                ["grant_type"] = "client_credentials",
                ["client_id"] = clientId,
                ["client_secret"] = clientSecret
            };
        tokenRequest.Content = new FormUrlEncodedContent(formData);

        var response = await authClient.SendAsync(tokenRequest);

        if (!response.IsSuccessStatusCode)
        {
            var error = await response.Content.ReadAsStringAsync();
            throw new InvalidOperationException($"OAuth failed ({response.StatusCode}): {error}");
        }

        var json = await response.Content.ReadAsStringAsync();
        var token = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(json);

        if (token?.TryGetValue("access_token", out var accessToken) == true)
        {
            return accessToken.GetString() ?? throw new InvalidOperationException("Access token was null");
        }

        throw new InvalidOperationException("No access_token in response");
    }

    private void CancelAssessment()
    {
        _cancellationTokenSource?.Cancel();
    }

    private void Reset()
    {
        _currentProgress = null;
        _assessmentResult = null;
        _error = null;
        _validationError = null;
        _showLogs.Clear();
    }

    private void ToggleLogs(string dataElementName)
    {
        if (_showLogs.Contains(dataElementName))
            _showLogs.Remove(dataElementName);
        else
            _showLogs.Add(dataElementName);
    }

    private string GetStatusClass(AssessorStatus status) => status switch
    {
        AssessorStatus.Running => "ring-2 ring-warning ring-opacity-50",
        AssessorStatus.Completed => "border-l-4 border-success",
        AssessorStatus.Failed => "border-l-4 border-error",
        _ => ""
    };

    private string GetStatusBadgeClass(AssessorStatus status) => status switch
    {
        AssessorStatus.Pending => "badge-ghost",
        AssessorStatus.Running => "badge-warning",
        AssessorStatus.Completed => "badge-success",
        AssessorStatus.Failed => "badge-error",
        _ => "badge-ghost"
    };

    public void Dispose()
    {
        _cancellationTokenSource?.Cancel();
        _cancellationTokenSource?.Dispose();
    }
}
