@using EwFrameworkAnalysis.UI.Components

<Card Title="Last Profiling Run" Shadow="Card.ShadowSize.XLarge" NoPadding>
    <div class="space-y-2 px-5 pb-5">
        <p class="text-lg font-semibold text-blue">@(LatestProfileAt?.ToString("D") ?? "Never")</p>
    </div>
</Card>

@code {
    [Parameter, EditorRequired] public DateTimeOffset? LatestProfileAt { get; set; }
}
