@using EwFrameworkAnalysis.UI.Components
@using EwFrameworkAnalysis.UI.Services
@inject AnalysisProjectService ProjectSvc
@inject BusyService BusySvc
@inject IJSRuntime JSRuntime

<Card AdditionalClasses="mb-6" NoPadding>
    <ChildContent>
        <div class="px-4 py-5 sm:p-6">
            <div class="flex items-start justify-between gap-4">
                <!-- Left: Title and Metadata -->
                <div class="flex-1 min-w-0 space-y-1">
                    <!-- Editable Title -->
                    <EditableField Value="@(ProjectSvc.Project?.Title ?? "Untitled Project")"
                                   Placeholder="Enter project title"
                                   Variant="EditableField.FieldVariant.Title"
                                   OnSave="@HandleTitleSave"/>

                    <!-- Last Modified (Non-editable) -->
                    <p class="text-sm text-gray">@GetFormattedLastModified()</p>
                </div>

                <!-- Right: Actions -->
                <div class="flex items-center gap-3 flex-shrink-0">
                    <div class="dropdown dropdown-end"
                         data-walkthrough="@WalkthroughSteps.StepIds.ProjectFileOperations">
                        <div tabindex="0" role="button" class="btn btn-sm btn-outline gap-1">
                            <i class="fas fa-folder"></i>
                            <span>File</span>
                            <i class="fas fa-chevron-down text-xs opacity-60"></i>
                        </div>
                        <ul tabindex="0"
                            class="dropdown-content menu bg-white text-gray-700 rounded-none z-50 w-64 p-2 shadow-xl border border-gray-100">
                            <li><button class="w-full text-left" @onclick="HandleNewProject"><i class="fas fa-file w-4"></i> New</button></li>
                            <li><button class="w-full text-left" @onclick="HandleSaveProject"><i class="fas fa-save w-4"></i> Save</button></li>
                            <li><button class="w-full text-left" @onclick="HandleImportSources"><i class="fas fa-file-import w-4"></i> Import Data Source</button></li>
                            <li><button class="w-full text-left" @onclick="HandleLoadProject"><i class="fas fa-folder-open w-4"></i> Load</button></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </ChildContent>
</Card>

<Modal Title="New Project" IsOpen="@NewProjectModalIsOpen" CloseRequested="HandleNewProjectCanceled">
    <Body>
        <div class="space-y-2 text-sm text-gray-600">
            <p>By creating a new project, any work you currently have in this session will be lost.</p>
            <p>Do you want to proceed?</p>
        </div>
    </Body>
    <Footer>
        <div class="modal-action">
            <button class="btn btn-ghost hover:bg-gray-200 hover:border-gray-300" @onclick="HandleNewProjectCanceled">No</button>
            <button class="btn btn-error hover:bg-red-400 hover:border-red-400" @onclick="HandleNewProjectConfirmed">Yes</button>
        </div>
    </Footer>
</Modal>

<Modal Title="Load Project" IsOpen="@LoadProjectModalIsOpen" CloseRequested="HandleLoadProjectCanceled">
    <Body>
        <div class="space-y-2 text-sm text-gray-600">
            <p>By uploading a previously saved file, any work you currently have in this session will be lost.</p>
            <p>The results from the file will overwrite any and all information you have currently input.</p>
            <p>Do you want to proceed?</p>
        </div>
    </Body>
    <Footer>
        <div class="modal-action">
            <button class="btn btn-ghost hover:bg-gray-200 hover:border-gray-300" @onclick="HandleLoadProjectCanceled">No</button>
            <button class="btn btn-error hover:bg-red-400 hover:border-red-400" @onclick="HandleLoadProjectConfirmed">Yes</button>
        </div>
    </Footer>
</Modal>

<ImportDataSourcesModal IsOpen="@ImportSourcesModalIsOpen"
                        IsOpenChanged="@((v) => ImportSourcesModalIsOpen = v)"
                        OnImportComplete="@HandleImportComplete" />

<!-- Hidden file input for loading projects -->
<input type="file"
       accept=".json"
       @ref="_fileInput"
       @onchange="OnFileSelected"
       style="display: none;"/>

@code {

    [Parameter]
    public int ActiveSourceCount { get; set; }

    private bool NewProjectModalIsOpen { get; set; }
    private bool LoadProjectModalIsOpen { get; set; }
    private bool ImportSourcesModalIsOpen { get; set; }

    private ElementReference _fileInput;
    private string? _importError;

    private async Task OnFileSelected(ChangeEventArgs e)
    {
        _importError = null;
        using var _ = await BusySvc.BeginAsync("Loading project…");
        var file = await JSRuntime.InvokeAsync<string>("ProjectHeaderHelpers.readFileAsText", _fileInput);
        if (!string.IsNullOrWhiteSpace(file))
        {
            var result = await ProjectSvc.ImportProjectAsync(file);
            if (!result.Success)
                _importError = result.ErrorMessage;
        }
    }

    private async Task HandleTitleSave(string? title)
    {
        if (!string.IsNullOrWhiteSpace(title))
        {
            await ProjectSvc.UpdateProjectDetailsAsync(title);
        }
    }

    private async Task HandleNewProject()
    {
        await JSRuntime.InvokeVoidAsync("eval", "document.activeElement.blur()");
        NewProjectModalIsOpen = true;
    }

    private async Task HandleImportSources()
    {
        await JSRuntime.InvokeVoidAsync("eval", "document.activeElement.blur()");
        ImportSourcesModalIsOpen = true;
    }

    private async Task HandleLoadProject()
    {
        await JSRuntime.InvokeVoidAsync("eval", "document.activeElement.blur()");
        LoadProjectModalIsOpen = true;
    }

    private void HandleNewProjectCanceled() => NewProjectModalIsOpen = false;

    private async Task HandleNewProjectConfirmed()
    {
        NewProjectModalIsOpen = false;
        await ProjectSvc.CreateNewProjectAsync();
    }

    private async Task HandleSaveProject()
    {
        using var _ = await BusySvc.BeginAsync("Saving…");
        var json = await ProjectSvc.ExportProjectAsync();
        var fileName = $"{ProjectSvc.Project?.Title?.Replace(" ", "_") ?? "project"}_{DateTimeOffset.Now:yyyyMMdd_HHmmss}.json";
        await JSRuntime.InvokeVoidAsync("ProjectHeaderHelpers.downloadFile", fileName, json, "application/json");
        await JSRuntime.InvokeVoidAsync("eval", "document.activeElement.blur()");
    }

    private void HandleLoadProjectCanceled() => LoadProjectModalIsOpen = false;

    private async Task HandleLoadProjectConfirmed()
    {
        LoadProjectModalIsOpen = false;
        try
        {
            await JSRuntime.InvokeVoidAsync("ProjectHeaderHelpers.triggerFileInput", _fileInput);
        }
        finally
        {
            await JSRuntime.InvokeVoidAsync("ProjectHeaderHelpers.resetFileInput", _fileInput);
        }
    }

    private string GetFormattedLastModified()
    {
        if (ProjectSvc.Project?.LastModifiedAt == null) return "Last modified: Never";
        var lastModified = ProjectSvc.Project.LastModifiedAt;
        var timeSpan = DateTimeOffset.Now - lastModified;

        var timeAgo = timeSpan.TotalHours < 1
            ? $"{(int)timeSpan.TotalMinutes} minutes ago"
            : timeSpan.TotalDays < 1
                ? $"{(int)timeSpan.TotalHours} hours ago"
                : lastModified.ToString("MMMM d, yyyy 'at' h:mm tt");

        return $"Last modified: {timeAgo}";
    }

    private void HandleImportComplete(int count)
    {
        // The service already notified, but we could show a toast here if desired.
        // For now the dashboard will re-render via ProjectSvc.Changed automatically.
    }

}
