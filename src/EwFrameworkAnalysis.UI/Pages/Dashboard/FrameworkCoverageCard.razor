@using EwFrameworkAnalysis.UI.Components
@using EwFrameworkAnalysis.UI
@using EwFrameworkAnalysis.Common.Models.Scoring

<Card Title="Framework Coverage" Shadow="Card.ShadowSize.XLarge" NoPadding>
    <div class="px-5 pb-5 flex flex-col gap-3">
        @if (HasCoverageData)
        {
            <p class="text-xs text-gray-400 uppercase tracking-wide">Top Essential Questions</p>
            <div class="flex flex-col gap-2">
                @foreach (var q in TopQuestions)
                {
                    <div class="flex flex-col gap-1">
                        <div class="flex justify-between text-sm">
                            <span class="text-gray-600">EQ-@q.QuestionNumber</span>
                            <span class="font-semibold text-blue">@q.CoverageScore.ToString("0.##%")</span>
                        </div>
                        <progress class="progress @GetProgressBarColor(q.CoverageScore) bg-gray-200 h-2"
                                  value="@(q.CoverageScore * 100)"
                                  max="100"></progress>
                    </div>
                }
            </div>

            <a href="@AppRoutes.Analysis" class="text-xs text-blue hover:underline self-end">
                View full analysis →
            </a>
        }
        else
        {
            <p class="text-sm text-gray-400">No profiling data available.</p>
        }
    </div>
</Card>

@code {
    [Parameter, EditorRequired] public List<QuestionCoverageScore> QuestionScores { get; set; } = [];

    private bool HasCoverageData => QuestionScores.Any(q => q.CoverageScore > 0);

    private IEnumerable<QuestionCoverageScore> TopQuestions =>
        QuestionScores
            .OrderByDescending(q => q.CoverageScore)
            .Take(3);

    private string GetProgressBarColor(decimal score) =>
        score switch
        {
            >= 0.70m => "progress-success",
            >= 0.50m => "progress-warning",
            > 0m => "progress-error",
            _ => "bg-gray-200"
        };
}
