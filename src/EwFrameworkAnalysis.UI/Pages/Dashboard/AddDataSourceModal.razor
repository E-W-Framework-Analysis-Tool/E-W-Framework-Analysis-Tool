@using EwFrameworkAnalysis.Common.Models.Project
@using EwFrameworkAnalysis.UI.Components

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
        <div class="absolute inset-0 bg-black/40 backdrop-blur-sm transition-opacity duration-200 ease-out"
             @onclick="Close"
             aria-hidden="true">
        </div>
        <div class="relative w-full bg-white rounded-2xl shadow-2xl ring-1 ring-black/10
                        transition-all duration-200 ease-out @(_showLlmView ? "max-w-2xl" : "max-w-lg")">

            @if (_showLlmView)
            {
                <LlmAssistedEntryView OnBack="() => _showLlmView = false"
                                      OnCancel="Close" />
            }
            else
            {
                <!-- Default type-selection view -->
                <!-- Header -->
                <div class="px-6 pt-6 pb-2">
                    <div class="flex items-start gap-4">
                        <div class="flex h-12 w-12 items-center justify-center rounded-full bg-blue/20">
                            <i class="fas fa-plus text-blue text-xl"></i>
                        </div>
                        <div class="flex-1">
                            <h3 class="font-title text-lg font-semibold text-blue">Add Data Source</h3>
                            <p class="mt-1 text-sm text-gray">Choose the type of data source you want to add.</p>
                        </div>
                    </div>
                </div>
                <!-- Body -->
                <div class="px-6 pb-6 space-y-3">
                    <!-- Manual/Custom Option -->
                    <div class="border border-gray-200 rounded-xl overflow-hidden">
                        <button @onclick="() => HandleSelected(DataSourceType.Custom, null)"
                                class="w-full text-left p-4 hover:border-blue hover:bg-blue/5
                                               focus:outline-none focus:ring-2 focus:ring-blue focus:ring-offset-2 transition-all">
                            <div class="flex items-center gap-3">
                                <DataSourceIcon Type="DataSourceType.Custom" />
                                <div class="flex-1">
                                    <h4 class="text-sm font-medium text-blue">Manual Entry</h4>
                                    <p class="mt-1 text-xs text-gray">Add a data source that does not have automated connections and manually enter a profile</p>
                                    <p class="mt-1 text-xs text-blue font-medium">Manual | Flexible</p>
                                </div>
                                <i class="fas fa-chevron-right text-gray"></i>
                            </div>
                        </button>
                        <!-- LLM-Assisted sub-action -->
                        <div class="border-t border-gray-100 bg-gray-50/60 px-4 py-2 flex items-center justify-between">
                            <p class="text-xs text-gray">Have a schema or data dictionary? Let AI give you a head start.</p>
                            <button @onclick="() => _showLlmView = true"
                                    type="button"
                                    class="inline-flex items-center gap-1.5 rounded-md bg-white border border-blue/30
                                                   px-2.5 py-1 text-xs font-medium text-blue shadow-sm
                                                   hover:bg-blue/5 transition-colors whitespace-nowrap ml-3">
                                <i class="fas fa-robot text-xs"></i>
                                LLM-Assisted
                            </button>
                        </div>
                    </div>

                    <!-- Ed-Fi API Option -->
                    <button @onclick="() => HandleSelected(DataSourceType.EdFiApi, null)"
                            class="w-full text-left p-4 border border-gray-200 rounded-xl hover:border-blue hover:bg-blue/5
                                           focus:outline-none focus:ring-2 focus:ring-blue focus:ring-offset-2 transition-all">
                        <div class="flex items-center gap-3">
                            <DataSourceIcon Type="DataSourceType.EdFiApi" />
                            <div class="flex-1">
                                <h4 class="text-sm font-medium text-blue">Ed-Fi ODS API</h4>
                                <p class="mt-1 text-xs text-gray">Automated discovery & profiling via API connection</p>
                                <p class="mt-1 text-xs text-blue font-medium">Automated | Real-time</p>
                            </div>
                            <i class="fas fa-chevron-right text-gray"></i>
                        </div>
                    </button>

                    <!-- CEDS Data Warehouse — one button per known version -->
                    @foreach (var version in CedsDWVersions.All)
                    {
                        var v = version;
                        <button @onclick="() => HandleSelected(DataSourceType.CedsDw, v)"
                                class="w-full text-left p-4 border border-gray-200 rounded-xl hover:border-blue hover:bg-blue/5
                                                   focus:outline-none focus:ring-2 focus:ring-blue focus:ring-offset-2 transition-all">
                            <div class="flex items-center gap-3">
                                <DataSourceIcon Type="DataSourceType.CedsDw" />
                                <div class="flex-1">
                                    <h4 class="text-sm font-medium text-blue">CEDS Data Warehouse <span class="text-gray-400 font-normal">(@v)</span></h4>
                                    <p class="mt-1 text-xs text-gray">Profile your CEDS Data Warehouse locally using SQL scripts and file upload</p>
                                    <p class="mt-1 text-xs text-blue font-medium">SQL-based | File load</p>
                                </div>
                                <i class="fas fa-chevron-right text-gray"></i>
                            </div>
                        </button>
                    }

                    <!-- ECS State Data Option -->
                    <button @onclick="() => HandleSelected(DataSourceType.EcsState, null)"
                            class="w-full text-left p-4 border border-gray-200 rounded-xl hover:border-blue hover:bg-blue/5
                                           focus:outline-none focus:ring-2 focus:ring-blue focus:ring-offset-2 transition-all">
                        <div class="flex items-center gap-3">
                            <DataSourceIcon Type="DataSourceType.EcsState" />
                            <div class="flex-1">
                                <h4 class="text-sm font-medium text-blue">ECS State Data</h4>
                                <p class="mt-1 text-xs text-gray">Load a state-specific reference profile compiled by the Education Commission of the States</p>
                                <p class="mt-1 text-xs text-blue font-medium">Built-in | Select state</p>
                            </div>
                            <i class="fas fa-chevron-right text-gray"></i>
                        </div>
                    </button>
                </div>
                <!-- Footer -->
                <div class="bg-gray-50/80 px-6 py-4 rounded-b-2xl">
                    <div class="flex justify-end">
                        <button @onclick="Close"
                                type="button"
                                class="inline-flex items-center justify-center rounded-md border border-gray-300
                                               bg-white px-4 py-2 text-sm font-medium text-gray-700
                                               hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-blue focus:ring-offset-2">
                            Cancel
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter] public EventCallback<(DataSourceType Type, string? Version)> OnDataSourceTypeSelected { get; set; }

    private bool _showLlmView = false;

    private async Task Close()
    {
        _showLlmView = false;
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(IsOpen);
    }

    private async Task HandleSelected(DataSourceType type, string? version)
    {
        await Close();
        await OnDataSourceTypeSelected.InvokeAsync((type, version));
    }
}
