@using EwFrameworkAnalysis.Common.Models.Project

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
        <div class="absolute inset-0 bg-black/40 backdrop-blur-sm transition-opacity duration-200 ease-out"
             @onclick="Close"
             aria-hidden="true">
        </div>
        <div class="relative w-full max-w-lg bg-white rounded-2xl shadow-2xl ring-1 ring-black/10
                        transition-all duration-200 ease-out">
            <!-- Header -->
            <div class="px-6 pt-6 pb-2">
                <div class="flex items-start gap-4">
                    <div class="flex h-12 w-12 items-center justify-center rounded-full bg-blue/20">
                        <i class="fas fa-plus text-blue text-xl"></i>
                    </div>
                    <div class="flex-1">
                        <h3 class="font-title text-lg font-semibold text-blue">Add Data Source</h3>
                        <p class="mt-1 text-sm text-gray">Choose the type of data source you want to add.</p>
                    </div>
                </div>
            </div>
            <!-- Body -->
            <div class="px-6 pb-6 space-y-3">
                <!-- Ed-Fi API Option -->
                <button @onclick="() => HandleDataSourceTypeSelected(DataSourceType.EdFiApi)"
                        class="w-full text-left p-4 border border-gray-200 rounded-xl hover:border-blue hover:bg-blue/5
                                   focus:outline-none focus:ring-2 focus:ring-blue focus:ring-offset-2 transition-all">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-blue/20 rounded-lg grid place-items-center">
                            <i class="fas fa-network-wired text-blue"></i>
                        </div>
                        <div class="flex-1">
                            <h4 class="text-sm font-medium text-blue">Ed-Fi ODS API</h4>
                            <p class="mt-1 text-xs text-gray">Automated discovery & analysis</p>
                            <p class="mt-1 text-xs text-blue font-medium">Automated • Real-time</p>
                        </div>
                        <i class="fas fa-chevron-right text-gray"></i>
                    </div>
                </button>
                <!-- CEDS Data Warehouse Option -->
                <button @onclick="() => HandleDataSourceTypeSelected(DataSourceType.CedsDw)"
                        class="w-full text-left p-4 border border-gray-200 rounded-xl hover:border-blue hover:bg-blue/5
                                   focus:outline-none focus:ring-2 focus:ring-blue focus:ring-offset-2 transition-all">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-blue/20 rounded-lg grid place-items-center">
                            <i class="fas fa-warehouse text-blue"></i>
                        </div>
                        <div class="flex-1">
                            <h4 class="text-sm font-medium text-blue">CEDS Data Warehouse</h4>
                            <p class="mt-1 text-xs text-gray">Upload SQL result sets from CEDS DW</p>
                            <p class="mt-1 text-xs text-blue font-medium">SQL-based • Upload</p>
                        </div>
                        <i class="fas fa-chevron-right text-gray"></i>
                    </div>
                </button>
                <!-- ECS State Comparison Option -->
                <button @onclick="() => HandleDataSourceTypeSelected(DataSourceType.EcsState)"
                        class="w-full text-left p-4 border border-gray-200 rounded-xl hover:border-blue hover:bg-blue/5
                                   focus:outline-none focus:ring-2 focus:ring-blue focus:ring-offset-2 transition-all">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-blue/20 rounded-lg grid place-items-center">
                            <i class="fas fa-map text-blue"></i>
                        </div>
                        <div class="flex-1">
                            <h4 class="text-sm font-medium text-blue">ECS State Comparison</h4>
                            <p class="mt-1 text-xs text-gray">Compare against ECS state-level data</p>
                            <p class="mt-1 text-xs text-blue font-medium">Built-in &bull; Select state</p>
                        </div>
                        <i class="fas fa-chevron-right text-gray"></i>
                    </div>
                </button>
                <!-- Manual/Custom Option -->
                <button @onclick="() => HandleDataSourceTypeSelected(DataSourceType.Custom)"
                        class="w-full text-left p-4 border border-gray-200 rounded-xl hover:border-blue hover:bg-blue/5
                                   focus:outline-none focus:ring-2 focus:ring-blue focus:ring-offset-2 transition-all">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-green/20 rounded-lg grid place-items-center">
                            <i class="fas fa-list-check text-green-700"></i>
                        </div>
                        <div class="flex-1">
                            <h4 class="text-sm font-medium text-blue">Manual Assessment</h4>
                            <p class="mt-1 text-xs text-gray">Flexible checklist for manual review</p>
                            <p class="mt-1 text-xs text-blue font-medium">Manual • Flexible</p>
                        </div>
                        <i class="fas fa-chevron-right text-gray"></i>
                    </div>
                </button>
            </div>
            <!-- Footer -->
            <div class="bg-gray-50/80 px-6 py-4 rounded-b-2xl">
                <div class="flex justify-end">
                    <button @onclick="Close"
                            type="button"
                            class="inline-flex items-center justify-center rounded-md border border-gray-300
                                       bg-white px-4 py-2 text-sm font-medium text-gray-700
                                       hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-blue focus:ring-offset-2">
                        Cancel
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback<DataSourceType> OnDataSourceTypeSelected { get; set; }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(IsOpen);
    }

    private async Task HandleDataSourceTypeSelected(DataSourceType dataSourceType)
    {
        await Close();
        await OnDataSourceTypeSelected.InvokeAsync(dataSourceType);
    }
}
