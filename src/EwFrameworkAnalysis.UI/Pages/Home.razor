    private List<ListItem> faqs = new()
    {
        new ListItem
        {
            Title = "How do I automatically interrogate my Ed-Fi ODS?",
            Content = @"
                <ul class=""list-disc pl-6 space-y-4"">
                    <li>Select Ed-Fi ODS as a Data Source.</li>
                    <li>Input the appropriate connection details for your ODS.</li>
                    <li>“Interrogate Data” to have the E-W Analysis Tool connect to and interrogate your ODS for E-W data availability.</li>
                    <li>Upon successful completion of the interrogation, you will see statistics such as the count of records found, and the impact of your updated data readiness results will immediately display in the Quick View.</li>
                    <li>You can provide additional information about each data element by clicking into the Details and manually scoring each data element and providing additional notes.</li>
                    <li>Multiple historical versions of this data source can be supported.</li>
                </ul>
            "},
        new ListItem {
            Title = "Is the automatic interrogation of my Ed-Fi ODS safe and secure?",
            Content = @"
                <ul class=""list-disc pl-6 space-y-4"">
                    <li>
                        The interaction with the API will be between the user’s browser and their API, and the E-W Analysis Tool website server will never receive
                        the entered credentials nor will it be in the middle of the API traffic. The E-W Analysis Tool website server will only receive the results
                        metadata, to include the fields for which data exists and some profiling of the nature of that data.
                    </li>
                </ul>
            " },
        new ListItem {
            Title = "What if I have a non-standard implementation of an Ed-Fi ODS?",
            Content = @"
                <ul class=""list-disc pl-6 space-y-4"">
                    <li>
                        Any modifications made to the standard implementation of an Ed-Fi ODS may disrupt the automated interrogation of the API call.
                    </li>
                </ul>
            " },
        new ListItem {
            Title = "What if my Ed-Fi ODS uses a different version of Ed-Fi than version 5 of the data standard and version 7 of the API?",
            Content = @"
                <ul class=""list-disc pl-6 space-y-4"">
                    <li>
                        The tool is developed and tested against Ed-Fi ODS API version 7.3 (Data Standard v5).
                        Because many of the Ed-Fi API specifications overlap across versions, some checks may
                        still work with other versions, but compatibility is not guaranteed.
                    </li>
                    <li>
                        If a check produces an inaccurate or missing result due to version differences, you can
                        override the result within the tool or provide the needed information as a Custom data source.
                        These options help ensure the analysis remains accurate even if your ODS is running a different Ed-Fi version.
                    </li>
                </ul>
            " },
        new ListItem {
            Title = "How do I automatically interrogate my CEDS Data Warehouse?",
            Content = @"
                <ul class=""list-disc pl-6 space-y-4"">
                    <li> To interrogate a CEDS Data Warehouse, download the CEDS DW SQL Interrogation Scripts.</li>
                    <li> Run the SQL Interrogation Scripts in your own environment.</li>
                    <li>
                        The Scripts are designed to interrogate the appropriate standard CEDS DW tables for the data
                        elements that are necessary to create E-W Indicators to answer E-W Essential Questions.
                    </li>
                    <li> Once the Scripts complete, they will generate a Results File that can be saved to your computer.</li>
                    <li> Upload the Results File to the E-W Analysis Tool.</li>
                    <li>
                        Upon successful upload of the Results File, you will see statistics such as the count of records found,
                        and the impact of your updated data readiness results will immediately display in the Quick View.
                    </li>
                    <li> Multiple historical versions of this data source can be supported.</li>
                </ul>
            " },
        new ListItem {
            Title = "Is the automatic interrogation of my CEDS Data Warehouse safe and secure?",
            Content = @"
                <ul class=""list-disc pl-6 space-y-4"">
                    <li>
                        The E-W Analysis Tool provides SQL scripts for the user to execute locally.
                        Results can be exported to a plaintext file that can be reviewed for sensitive data before
                        uploading to the publicly hosted application. This method maintains user control, aligns with
                        security best practices, and accommodates air-gapped systems isolated from the public Internet.
                    </li>
                    <li>
                        By decoupling data profiling from the hosted application, the tool ensures compliance with
                        security and accessibility standards without compromising functionality or ease of use.
                    </li>
                </ul>
            " },
        new ListItem {
            Title = "What if my CEDS Data Warehouse is different from Version 11?",
            Content = @"
                <ul class=""list-disc pl-6 space-y-4"">
                    <li>[Answer pending]</li>
                </ul>
            " },
        new ListItem {
            Title = "What data does the E-W Analysis Tool collect and store?",
            Content = @"
                <ul class=""list-disc pl-6 space-y-4"">
                    <li> Results of a user’s browser session are only stored for the duration of the session. </li>
                    <li> The E-W Analysis Tool website server will only receive results metadata from automated data system interrogations, to include the fields for which data exists and some profiling of the nature of that data. </li>
                    <li> User input of data sources is limited to similar metadata descriptions, such as additional scoring criteria and data source notes. </li>
                    <li> The E-W Analysis Tool does not have the capacity to store any other types of data such as sensitive information. </li>
                    <li> Data inventory results can be saved to a file on the user’s computer, and can be subsequently re-uploaded. </li>
                </ul>
            " },
        new ListItem {
            Title = "How does your Data Readiness scoring work?",
            Content = @"
                <ul class=""list-disc pl-6 space-y-4"">
                    <li> The automated data interrogation process (i.e., Ed-Fi ODS API and CEDS DW SQL queries) queries the respective databases about the presence of particular data in the standard tables that have been mapped to E-W Framework Indicators and Metrics.  In addition to Counts of records, the tool looks at other characteristics that may indicate quality of data, such as checking for non-Numeric values where the data element is of Numeric type. </li>
                    <li> The manual data input process allows the user to add additional data sources and to modify the results of automated data interrogations.  Part of the input process enables the user to score each data element for Availability (does the data exist), Accessibility (is the data accessible to the parties that need it), and Quality (is the data of high quality). </li>
                    <li> The E-W Analysis Tool takes the results of the automated data interrogation and manual inputs and applies a scoring rubric to each data element.  Each data element then rolls up into one or more Indicators as a necessary component of readiness, and each Indicator then rolls up to one or more Essential Question as a necessary component of readiness. </li>
                </ul>
            " },
