@page "/"
@using System.Collections
@using EwFrameworkAnalysis.Common.Models

<PageTitle>E-W Framework Analysis Tool</PageTitle>

<div class="min-h-screen bg-base-100">

    <section class="relative items-center py-24">
        <div class="container mx-auto items-center flex flex-wrap* justify-center">
            <div class="w-full md:w-8/12 lg:w-10/12 xl:w-10/12 px-4">
                <div class="pt-32* sm:pt-0">
                    <h2 class="font-semibold text-4xl text-secondary pb-4">
                        What is the EW Framework?
                    </h2>
                    <p class="mt-4 text-lg leading-relaxed font-semibold text-secondary/80">
                        The <a href="https://educationtoworkforce.org/" class="link link-hover font-bold hover:text-primary/80">Education-to-Workforce Indicator Framework</a>
                        (or E-W Framework) is an extensive framework developed with input from leading experts from over 20 national and community organizations.
                        It highlights key connections needed between systems to support students as they progress from early education through their career.
                        
                    </p>
                    <button class="btn btn-secondary hover:btn-primary hover:text-primary-content mt-12">Get Started!</button>                    
                </div>
            </div>
        </div>

        <div class="container mx-auto items-center flex justify-center mt-20">
            <div class="w-full md:w-8/12 lg:w-10/12 xl:w-10/12 px-4">

                <h2 class="font-semibold text-4xl text-secondary pb-4">
                    The E-W Framework includes
                </h2>

                <ul class="list-disc px-6">
                    <li>
                        <h2 class="text-xl mb-4 font-semibold text-secondary">Essential Questions</h2>
                        <p class="mb-4 text-secondary">
                            Twenty questions essential for E-W data systems to answer about how students are
                            progressing from early education through career—and using the answers to guide action.
                        </p>
                    </li>
                    <li>
                        <h6 class="text-xl mb-4 font-semibold text-secondary">Indicators</h6>
                        <p class="mb-4 text-secondary">
                            Student outcomes and milestones and related system conditions
                            associated with economic mobility and security, plus guidance
                            on how to measure them (Metrics).
                        </p>
                    </li>
                    <li>
                        <h6 class="text-xl mb-4 font-semibold text-secondary">Disaggregates</h6>
                        <p class="mb-4 text-secondary">
                            Characteristics that E-W systems should use to break down
                            data, plus guidance on how to collect them.
                        </p>
                    </li>
                    <li>
                        <h6 class="text-xl mb-4 font-semibold text-secondary">Evidence-Based Practices</h6>
                        <p class="mb-4 text-secondary">
                            The framework is centered around equity-based
                            principles and also provides evidence based practices.
                        </p>
                    </li>
                </ul>


                @* <div class="flex p-4 justify-center align-middle border-2 border-neutral bg-neutral/20">
                    <h6 class="text-xl mb-4 font-semibold text-secondary">Essential Questions</h6>
                    <p class="mb-4 text-secondary">
                        Twenty questions essential for E-W data systems to answer about how students are
                        progressing from early education through career—and using the answers to guide action.
                    </p>
                </div>
                <div class="flex-1 p-4 justify-center align-middle border-2 border-accent bg-accent/20">
                    <h6 class="text-xl mb-4 font-semibold text-secondary">Indicators</h6>
                    <p class="mb-4 text-secondary">
                        Student outcomes and milestones and related system conditions
                        associated with economic mobility and security, plus guidance
                        on how to measure them (Metrics).
                    </p>
                </div>
                <div class="flex-1 p-4 justify-center align-middle border-2 border-secondary bg-secondary/20">
                    <h6 class="text-xl mb-4 font-semibold text-secondary">Disaggregates</h6>
                    <p class="mb-4 text-secondary">
                        Characteristics that E-W systems should use to break down
                        data, plus guidance on how to collect them.
                    </p>
                </div>
                <div class="flex-1 p-4 justify-center align-middle border-2 border-primary bg-primary/20">
                    <h6 class="text-xl mb-4 font-semibold text-secondary">Evidence-Based Practices</h6>
                    <p class="mb-4 text-secondary">
                        The framework is centered around equity-based
                        principles and also provides evidence based practices.
                    </p>
                </div> *@
            </div>
        </div>

        <div class="container mx-auto items-center flex justify-center mt-8 ">
            <div class="w-full md:w-10/12 xl:w-8/12 px-4 ">
                <img alt="A depiction of the E-W Framework components, such as Essential Questions and Evidence-based practices, and the general lifecycle of how they are interacted with" src="images/ew-diagram.png" class="w-full align-middle shadow rounded-lg bg-white p-5" />
            </div>
        </div>
    </section>

    <!-- What EW Tool Does Section -->
    <section class="relative items-center pb-24">
        <div class="container mx-auto items-center flex flex-wrap justify-center">
            <div class="w-full md:w-8/12 lg:w-10/12 xl:w-10/12 px-4 ">
                <h2 class="font-semibold text-4xl text-secondary pb-4">
                    What does the E-W Analysis Tool do?
                </h2>
                <p class="mt-4 text-lg leading-relaxed font-semibold text-secondary/80">
                    This Analysis Tool was developed by Double Line to build upon the rich information in the
                    E-W Framework and enable you to understand which indicators your data systems are prepared for.
                    It then calculates how well your data satisfies the recommended metrics for each Indicator,
                    giving you a visual representation of your system's readiness by Indicator and by Essential Question.
                </p>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section class="py-24 bg-gray-100/60 inset-shadow-sm border-b border-t border-gray-300/40">
        <div class="container mx-auto items-center flex flex-wrap justify-center">
            <div class="w-full md:w-10/12 lg:w-10/12 xl:w-10/12 px-4 justify-center ">
                <h2 class="font-semibold text-4xl text-secondary pb-4 text-center">
                    How To Use the E-W Analysis Tool
                </h2>
            </div>
        </div>

        <div class="grid md:grid-cols-3 gap-6 max-w-6xl mx-auto px-6">
            <div class="card">
                <div class="card-body text-center">
                    <h3 class="font-bold text-white bg-gray-400 rounded-lg py-18 mb-2">Data Input Illustration</h3>
                    <p class="font-semibold">Input Your Data Inventory</p>
                    <p class="text-sm text-gray-600">
                        Provide details about your current data sources and elements through manual or automated methods.
                    </p>
                </div>
            </div>
            <div class="card">
                <div class="card-body text-center">
                    <h3 class="font-bold text-white bg-gray-400 rounded-lg py-18 mb-2">Readiness Scores Chart</h3>
                    <p class="font-semibold">View Readiness Scores</p>
                    <p class="text-sm text-gray-600">
                        See instant feedback and visualize how well your data currently supports the E-W Framework’s indicators.
                    </p>
                </div>
            </div>
            <div class="card">
                <div class="card-body text-center">
                    <h3 class="font-bold text-white bg-gray-400 rounded-lg py-18 mb-2">Roadmap Planning</h3>
                    <p class="font-semibold">Plan your roadmap</p>
                    <p class="text-sm text-gray-600">
                        Use the insights to understand gaps and prioritize efforts.
                    </p>
                </div>
            </div>
        </div>

        <div class="pt-24 container mx-auto items-center flex flex-wrap justify-center">
            <div class="w-full max-w-6xl lg:w-8/12* px-6">

                <h2 class="font-semibold text-3xl text-secondary font-bold mb-10">
                    Input your Data Inventory
                </h2>

                @foreach (var item in inventory)
                {
                    <div class="collapse collapse-arrow *join-item border-b rounded-none">
                        <input type="checkbox" name="data-inventory-list" class="peer" aria-label="data-inventory-list" />
                        <div class="collapse-title text-lg font-semibold peer-checked:text-primary">
                            @item.Title
                        </div>
                        <div class="collapse-content font-semibold text-secondary/80">@((MarkupString)item.Content)</div>
                    </div>
                }
            </div>
        </div>

        <div class="pt-24 container mx-auto items-center flex flex-wrap justify-center">
            <div class="w-full max-w-6xl px-4">

                <h2 class="font-semibold text-3xl text-secondary font-bold mb-10">
                    View Readiness Scores and Plan your Roadmap
                </h2>

                @foreach (var item in readinessScore)
                {
                    <div class="collapse collapse-arrow border-b rounded-none">
                        <input type="checkbox" name="readiness-score-list" class="peer" aria-label="readiness-score-list" />
                        <div class="collapse-title text-lg font-semibold peer-checked:text-primary">
                            @item.Title
                        </div>
                        <div class="collapse-content font-semibold text-secondary/80">@((MarkupString)item.Content)</div>
                    </div>
                }

                <div class="hidden join join-vertical w-full text-secondary/80 ">
                    <!-- Step 1 -->
                    <div class="collapse collapse-arrow join-item border-b">
                        <input type="checkbox" class="peer" />
                        <div class="collapse-title text-lg font-semibold peer-checked:text-primary transition ">
                            Navigate to the Reports and Analysis page for detailed insight into your E-W data readiness
                        </div>
                        <div class="collapse-content font-semibold transition duration">
                            <ul class="list-disc pl-6 space-y-2">
                                <li>Create an E-W data readiness inventory directly from the dashboard.</li>
                            </ul>
                        </div>
                    </div>

                    <!-- Step 2 -->
                    <div class="collapse collapse-arrow join-item border-b">
                        <input type="checkbox" class="peer" />
                        <div class="collapse-title text-lg font-semibold peer-checked:text-primary transition ">
                            View Overall Summary Scores of Data Readiness
                        </div>
                        <div class="collapse-content font-semibold text-secondary/80 transition duration">
                            <ul class="list-disc pl-6 space-y-2 opacity-70* font-semibold">
                                <li>
                                    The Analysis Tool takes the results of the Data Source Inventory and runs an analysis
                                    of data availability against each Essential Question and Indicator, displaying
                                    Readiness Scores and enabling the user to drill down into the details to the data element level
                                </li>
                            </ul>
                        </div>
                    </div>

                    <!-- Step 3 -->
                    <div class="collapse collapse-arrow join-item border-b">
                        <input type="checkbox" class="peer" />
                        <div class="collapse-title text-lg font-semibold peer-checked:text-primary transition ">
                            View Essential Question readiness scoring
                        </div>
                        <div class="collapse-content font-semibold text-secondary/80 transition duration">
                            <ul class="list-disc pl-6 space-y-2">
                                <li>Each Essential Question (EQ) will be listed, with a readiness score based on the availability and quality of the data in your data inventory.</li>
                                <li>Click on an EQ to see a more detailed breakdown of data readiness by the associated Indicators.</li>
                                <li>Click on an Indicator to see a more detailed breakdown of data readiness by the associated data elements.</li>
                                <li>EQ’s can be sorted by various factors.</li>
                            </ul>
                        </div>
                    </div>

                    <!-- Step 4 -->
                    <div class="collapse collapse-arrow join-item border-b">
                        <input type="checkbox" class="peer" />
                        <div class="collapse-title text-lg font-semibold peer-checked:text-primary transition ">
                            View Indicator readiness scoring
                        </div>
                        <div class="collapse-content font-semibold text-secondary/80 transition duration">
                            <ul class="list-disc pl-6 space-y-2">
                                <li>
                                    Each Indicator will be listed, with a readiness score based on the availability
                                    and quality of the data in your data inventory.
                                </li>
                                <li>Click on an Indicator to see a more detailed breakdown of data readiness by the associated data elements.</li>
                                <li>Indicators can be sorted by various factors.</li>
                            </ul>
                        </div>
                    </div>

                    <!-- Step 5 -->
                    <div class="collapse collapse-arrow join-item ">
                        <input type="checkbox" class="peer" />
                        <div class="collapse-title text-lg font-semibold peer-checked:text-primary transition ">
                            Print a one-page summary to use in discussions with stakeholders
                        </div>
                        <div class="collapse-content font-semibold text-secondary/80 transition duration">
                            <ul class="list-disc pl-6 space-y-2">
                                <li>
                                    The Analysis Tool generates various Readiness and Benchmarking reports to
                                    help support discussions at the Data / Policy / Agency level.
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ Section-->
    <section class="relative pt-24 items-center flex">
        <div class="container mx-auto items-center flex flex-wrap justify-center">
            <div class="w-full xl:w-11/12 px-4 sm:px-0">
                <h2 class="font-semibold text-4xl text-secondary mb-12">
                    Frequently Asked Questions
                </h2>
                <div class="my-8 "></div>
                @foreach (var faq in faqs)
                {
                    <div class="collapse collapse-arrow collapse-left pb-4 list-[square] rounded-lg">
                        <input type="checkbox" name="faq-list" class="peer" aria-label="faq-list" />
                        <div class="collapse-title bg-gray-100 rounded-lg font-semibold text-secondary/80 text-xl hover:cursor-pointer peer-checked:text-primary transition">
                            @faq.Title
                        </div>
                        <div class="collapse-content font-semibold text-secondary/80 transition duration">@((MarkupString)faq.Content)</div>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- Call to Action -->
    <section class="pb-24 text-center">
        <div class="container mx-auto items-center flex flex-wrap justify-center ">
            <div class="w-full xl:w-8/12 ">
                <div class="pt-32 sm:pt-24">

                    <h2 class="font-semibold text-4xl pb-12">Ready to Get Started?</h2>
                    <p class="mb-6 font-semibold text-gray-600">
                        Begin your data readiness assessment today with the E-W Framework Analysis Tool.
                    </p>
                    <button class="btn btn-secondary">Input Data Inventory</button>

                </div>
            </div>
        </div>
    </section>
</div>


@code {

