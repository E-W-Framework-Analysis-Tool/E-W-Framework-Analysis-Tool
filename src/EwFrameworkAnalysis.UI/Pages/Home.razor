@page "/"

<PageTitle>E-W Framework Analysis Tool</PageTitle>

<div class="min-h-screen bg-base-100">
    <!-- Hero Section -->
    <div class="hero min-h-[60vh] bg-gradient-to-br from-base-100 to-base-200">
        <div class="hero-content text-center max-w-4xl">
            <div>
                <!-- Logo/Icon placeholder -->
                <div class="mb-8">
                    <div class="w-20 h-20 mx-auto bg-primary rounded-2xl flex items-center justify-center shadow-lg">
                        <svg class="w-10 h-10 text-secondary" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                </div>

                <h1 class="text-5xl font-bold text-base-content font-title mb-6">
                    E-W Framework Analysis Tool
                </h1>

                <p class="text-xl text-gray mb-8 max-w-2xl mx-auto leading-relaxed">
                    Helping organizations use data to drive policy and practices that promote
                    <span class="text-accent font-semibold">equity</span> and
                    <span class="text-accent font-semibold">economic security</span> through the
                    Education-to-Workforce Indicator Framework.
                </p>
            </div>
        </div>
    </div>

    <!-- Features Section -->
    <div class="py-16 px-4">
        <div class="max-w-6xl mx-auto">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-bold text-base-content font-title mb-4">
                    Data-Driven Framework Analysis
                </h2>
                <p class="text-lg text-gray max-w-2xl mx-auto">
                    Discover which Framework indicators your organization is best positioned to implement
                </p>
            </div>

            <div class="grid md:grid-cols-3 gap-8">
                <!-- Feature 1 -->
                <div class="card bg-base-100 shadow-lg border border-base-200">
                    <div class="card-body">
                        <div class="w-12 h-12 bg-accent rounded-lg flex items-center justify-center mb-4">
                            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                            </svg>
                        </div>
                        <h3 class="card-title text-base-content font-title">Data Standards Integration</h3>
                        <p class="text-gray">
                            Maps Framework metrics to Ed-Fi API calls and CEDS Data Warehouse queries for comprehensive analysis.
                        </p>
                    </div>
                </div>

                <!-- Feature 2 -->
                <div class="card bg-base-100 shadow-lg border border-base-200">
                    <div class="card-body">
                        <div class="w-12 h-12 bg-primary rounded-lg flex items-center justify-center mb-4">
                            <svg class="w-6 h-6 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                            </svg>
                        </div>
                        <h3 class="card-title text-base-content font-title">Automated Scoring</h3>
                        <p class="text-gray">
                            Algorithmic assessment of each Indicator and Essential Question based on your data capabilities.
                        </p>
                    </div>
                </div>

                <!-- Feature 3 -->
                <div class="card bg-base-100 shadow-lg border border-base-200">
                    <div class="card-body">
                        <div class="w-12 h-12 bg-secondary rounded-lg flex items-center justify-center mb-4">
                            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            </svg>
                        </div>
                        <h3 class="card-title text-base-content font-title">Implementation Roadmap</h3>
                        <p class="text-gray">
                            Generate reports identifying data gaps and building pathways for BI visualizations and partnerships.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Status Banner -->
    <div class="bg-base-200 py-8 px-4">
        <div class="max-w-4xl mx-auto text-center">
            <div class="flex items-center justify-center gap-3 mb-4">
                <div class="badge badge-warning badge-lg">In Development</div>
                <div class="badge badge-accent badge-lg">Open Source</div>
            </div>
            <p class="text-black">
                This tool is currently under development and will be released as an open-source project.
                Built with Blazor WASM for browser-only operation.
            </p>
        </div>
    </div>
</div>
