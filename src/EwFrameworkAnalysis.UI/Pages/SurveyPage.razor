@page "/survey"
@using CsvHelper
@using CsvHelper.Configuration.Attributes
@using EwFrameworkAnalysis.Common.FrameworkReferenceData
@using EwFrameworkAnalysis.UI.Pages.Survey
@inject IJSRuntime JSRuntime
@inject SurveyBreakdownService BreakdownSvc
@inject NavigationManager Nav

<PageTitle>Data Survey</PageTitle>

<div class="flex flex-col h-screen bg-base-200">

    <!-- Page Header -->
    <div class="flex-shrink-0 bg-base-100 border-b border-gray-200 px-6 py-4">
        <div class="max-w-7xl mx-auto flex items-center justify-between gap-4 flex-wrap">
            <div>
                <h1 class="text-xl font-bold">Data Survey</h1>
                <p class="text-sm text-gray-500 mt-0.5">
                    For each data element, indicate your availability, interest level, and whether you can query and share the data.
                </p>
            </div>
            <div class="flex items-center gap-2 flex-wrap">
                <button class="btn btn-sm btn-ghost gap-1" @onclick="ResetSurvey" title="Clear all responses">
                    <i class="fas fa-undo text-xs"></i> Reset
                </button>
                <button class="btn btn-sm btn-outline gap-1" @onclick="@(() => Nav.NavigateTo("/survey/breakdown"))">
                    <i class="fas fa-chart-bar text-xs"></i> Load Results
                </button>
                <button class="btn btn-sm btn-primary gap-1" @onclick="DownloadCsv">
                    <i class="fas fa-download text-xs"></i> Download CSV
                </button>
            </div>
        </div>

        <!-- Summary Stats -->
        <div class="max-w-7xl mx-auto mt-3">
            <SurveyStats Responses="_responses" TotalElements="TotalElements" />
        </div>
    </div>

    <!-- Body -->
    <div class="flex-1 overflow-hidden px-6 py-4">
        <div class="max-w-7xl mx-auto h-full bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden flex flex-col">
            <SurveyElementList Responses="_responses"
                               ResponsesChanged="OnResponsesChanged" />
        </div>
    </div>
</div>

<!-- Reset Confirmation -->
@if (_showResetConfirmation)
{
    <div class="modal modal-open">
        <div class="modal-box">
            <h3 class="font-bold text-lg">Reset Survey?</h3>
            <p class="py-4 text-gray-600">
                All responses will be permanently cleared. This cannot be undone.
            </p>
            <div class="modal-action">
                <button class="btn btn-ghost" @onclick="() => _showResetConfirmation = false">Cancel</button>
                <button class="btn btn-error" @onclick="ConfirmReset">
                    <i class="fas fa-trash mr-2"></i>Reset All
                </button>
            </div>
        </div>
    </div>
}

@code {
    private const string STORAGE_KEY = "survey_response";

    private Dictionary<string, SurveyResponse> _responses = new();
    private bool _showResetConfirmation = false;

    private int TotalElements => EwFrameworkDataElements.Elements.Count;

    protected override async Task OnInitializedAsync()
    {
        await LoadFromStorage();
    }

    private async Task LoadFromStorage()
    {
        try
        {
            var json = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", STORAGE_KEY);
            if (!string.IsNullOrEmpty(json))
            {
                var loaded = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, SurveyResponse>>(json);
                if (loaded != null)
                    _responses = loaded;
            }
        }
        catch { }
    }

    private async Task SaveToStorage()
    {
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(_responses);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", STORAGE_KEY, json);
        }
        catch { }
    }

    private async Task OnResponsesChanged(Dictionary<string, SurveyResponse> updated)
    {
        _responses = updated;
        await SaveToStorage();
        StateHasChanged();
    }

    private void ResetSurvey() => _showResetConfirmation = true;

    private async Task ConfirmReset()
    {
        _showResetConfirmation = false;
        _responses.Clear();
        await JSRuntime.InvokeVoidAsync("localStorage.removeItem", STORAGE_KEY);
    }

    private async Task DownloadCsv()
    {
        var records = EwFrameworkDataElements.Elements.Values
            .OrderBy(e => e.DataElementCategory)
            .ThenBy(e => e.Name)
            .Select(e =>
            {
                _responses.TryGetValue(e.Name, out var r);
                return new SurveyCsvRow
                {
                    DataElement = e.Name,
                    Category = e.DataElementCategory,
                    EwCluster = e.ClusterOnlyCategory,
                    Availability = r?.Availability.HasValue == true ? r.Availability.Value.GetDisplayName() : "",
                    InterestLevel = r?.Interest.HasValue == true ? r.Interest.Value.GetDisplayName() : "",
                    CanQueryAndShare = r?.CanQueryAndShare.HasValue == true ? (r.CanQueryAndShare.Value ? "Yes" : "No") : ""
                };
            })
            .ToList();

        using var ms = new System.IO.MemoryStream();
        using var writer = new System.IO.StreamWriter(ms);
        using var csv = new CsvWriter(writer, System.Globalization.CultureInfo.InvariantCulture);
        csv.WriteRecords(records);
        writer.Flush();

        var base64 = Convert.ToBase64String(ms.ToArray());
        var fileName = $"data-survey-{DateTimeOffset.Now:yyyy-MM-dd}.csv";

        await JSRuntime.InvokeVoidAsync("eval", $@"
            (function() {{
                var bytes = Uint8Array.from(atob('{base64}'), c => c.charCodeAt(0));
                var blob = new Blob([bytes], {{ type: 'text/csv' }});
                var url = URL.createObjectURL(blob);
                var a = document.createElement('a');
                a.href = url;
                a.download = '{fileName}';
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
            }})();
        ");
    }

    private class SurveyCsvRow
    {
        [Name("Data Element")] public string DataElement { get; set; } = "";
        [Name("Category")] public string Category { get; set; } = "";
        [Name("EW Cluster")] public string EwCluster { get; set; } = "";
        [Name("Availability")] public string Availability { get; set; } = "";
        [Name("Interest Level")] public string InterestLevel { get; set; } = "";
        [Name("Can Query and Share")] public string CanQueryAndShare { get; set; } = "";
    }
}
