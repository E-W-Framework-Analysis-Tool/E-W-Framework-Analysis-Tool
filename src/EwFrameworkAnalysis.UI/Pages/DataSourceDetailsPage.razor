@page "/data-sources/{Id:guid}"
@using EwFrameworkAnalysis.Common.Models.Project
@using EwFrameworkAnalysis.Common.Services
@using EwFrameworkAnalysis.UI.Components
@using EwFrameworkAnalysis.UI.Pages.DataSourceDetails
@using EwFrameworkAnalysis.UI.Pages.DataSourceDetails.ProfilerModals
@inject AnalysisProjectService ProjectSvc
@inject NavigationManager Nav
@inject EdFiAssessmentOrchestrator EdFiOrchestrator
@inject CedsDWAssessmentOrchestrator CedsOrchestrator
@inject HttpClient HttpClient

@if (_dataSource is null)
{
    <div class="container mx-auto max-w-4xl p-6">
        <Card Overflow>
            <ChildContent>
                <div class="text-center">
                    <h2 class="text-2xl font-title font-bold text-blue mb-2">Data Source not found</h2>
                    <p class="text-gray mb-4">We couldn't locate a data source with ID "@Id".</p>
                    <div class="flex justify-center">
                        <button class="btn btn-primary" @onclick="@(() => Nav.NavigateTo(AppRoutes.Dashboard))">
                            Back to Dashboard
                        </button>
                    </div>
                </div>
            </ChildContent>
        </Card>
    </div>
}
else
{
    <!-- Notification Toast -->
    @if (_showNotification && !string.IsNullOrEmpty(_notificationMessage))
    {
        <div class="toast toast-top toast-end z-50">
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i>
                <span>@_notificationMessage</span>
                <button class="btn btn-sm btn-circle btn-ghost" @onclick="() => _showNotification = false">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        </div>
    }

    <div class="container mx-auto max-w-7xl p-4 lg:p-8">
        <DataSourceHeader DataSource="@_dataSource"
                          OnSave="@HandleSaveDataSource"
                          OnRunAssessment="@ShowAssessmentRunner" />

        <!-- Profiler Modals — always mounted, IsOpen controls visibility -->
        <EdFiProfilerModal IsOpen="@(_showAssessmentRunner && _dataSource.Type == DataSourceType.EdFiApi)"
                           IsOpenChanged="@((value) => _showAssessmentRunner = value)"
                           DataSource="@_dataSource"
                           OnAssessmentComplete="@HandleAssessmentComplete" />

        <CedsDWProfilerModal IsOpen="@(_showAssessmentRunner && _dataSource.Type == DataSourceType.CedsDw)"
                             IsOpenChanged="@((value) => _showAssessmentRunner = value)"
                             DataSource="@_dataSource"
                             OnAssessmentComplete="@HandleAssessmentComplete" />

        <EcsStateProfilerModal IsOpen="@(_showAssessmentRunner && _dataSource.Type == DataSourceType.EcsState)"
                               IsOpenChanged="@((value) => _showAssessmentRunner = value)"
                               DataSource="@_dataSource"
                               OnAssessmentComplete="@HandleAssessmentComplete" />

        <ManualProfilerModal IsOpen="@(_showAssessmentRunner && _dataSource.Type == DataSourceType.Custom)"
                                      IsOpenChanged="@((value) => _showAssessmentRunner = value)"
                                      DataSource="@_dataSource"
                                      OnAssessmentComplete="@HandleAssessmentComplete" />

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- LEFT COLUMN (desktop) — history card only; management moves to bottom on mobile -->
            <div class="lg:col-span-1 lg:space-y-6">
                <AssessmentHistoryCard Assessments="@_dataSourceAssessments"
                                       SelectedAssessment="@_selectedAssessment"
                                       OnSelectAssessment="@SelectAssessment"
                                       DataSourceType="@_dataSource.Type" />

                <!-- Management card: hidden here on mobile, shown below details -->
                <div class="hidden lg:block">
                    <DataSourceManagementCard DataSource="@_dataSource"
                                              OnToggleEnabled="@ToggleEnabled"
                                              OnDelete="@ShowDeleteConfirmation" />
                </div>
            </div>

            <!-- RIGHT COLUMN — details -->
            <div class="lg:col-span-2">
                <AssessmentDetailsView Assessment="@_selectedAssessment"
                                       DataSource="@_dataSource"
                                       Version="@GetAssessmentVersion(_selectedAssessment)"
                                       OnSetActive="@HandleSetActiveAssessment"
                                       OnRename="@HandleRenameAssessment"
                                       OnDelete="@HandleDeleteAssessment" />
            </div>

            <!-- Management card: shown below details on mobile only -->
            <div class="lg:hidden">
                <DataSourceManagementCard DataSource="@_dataSource"
                                          OnToggleEnabled="@ToggleEnabled"
                                          OnDelete="@ShowDeleteConfirmation" />
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
<Modal IsOpen="@_showDeleteModal"
       IsOpenChanged="v => _showDeleteModal = v"
       Title="Delete Data Source"
       Icon="fa-trash"
       CloseOnBackdrop="false"
       ShowCloseButton="false">
    <Body>
        <p class="text-gray">
            Are you sure you want to delete
            "<span class="font-semibold text-blue">@_dataSource?.Name</span>"?
            This action cannot be undone. Note that profiles will remain in the project history.
        </p>
    </Body>
    <Footer>
        <div class="flex justify-end gap-2">
            <button class="btn btn-ghost" @onclick="CancelDelete">Cancel</button>
            <button class="btn btn-error" @onclick="ConfirmDelete">
                <i class="fas fa-trash mr-2"></i>Delete Data Source
            </button>
        </div>
    </Footer>
</Modal>

@code {
    [Parameter] public Guid Id { get; set; }

    private DataSource? _dataSource;
    private List<DataSourceAssessment>? _dataSourceAssessments;
    private DataSourceAssessment? _selectedAssessment;
    private bool _showDeleteModal;
    private string? _notificationMessage;
    private bool _showNotification;
    private bool _showAssessmentRunner;

    protected override async Task OnInitializedAsync()
    {
        ProjectSvc.Changed += OnProjectChanged;
        LoadDataSource();
        await Task.CompletedTask;
    }

    protected override void OnParametersSet()
    {
        LoadDataSource();
    }

    private void OnProjectChanged()
    {
        LoadDataSource();
        InvokeAsync(StateHasChanged);
    }

    private void LoadDataSource()
    {
        _dataSource = ProjectSvc.GetDataSource(Id);

        if (_dataSource != null)
        {
            _dataSourceAssessments = ProjectSvc.GetAssessmentsForDataSource(_dataSource.Id).ToList();

            if (_dataSourceAssessments?.Any() == true && _selectedAssessment == null)
                _selectedAssessment = _dataSourceAssessments.OrderByDescending(a => a.ConductedAt).First();
        }
    }

    private void SelectAssessment(DataSourceAssessment assessment) =>
        _selectedAssessment = assessment;

    private void ShowAssessmentRunner() =>
        _showAssessmentRunner = true;

    private async Task HandleAssessmentComplete(DataSourceAssessment assessment)
    {
        await ProjectSvc.AddAssessmentAsync(assessment, _dataSource!.Id);
        _selectedAssessment = assessment;
        LoadDataSource();
        ShowNotification("Profile completed and saved");
    }

    private async Task ToggleEnabled()
    {
        if (_dataSource is null) return;
        await ProjectSvc.SetEnabledAsync(_dataSource.Id, !_dataSource.Enabled);
        LoadDataSource();
        ShowNotification($"Data source {(_dataSource.Enabled ? "enabled" : "disabled")}");
    }

    private void ShowNotification(string message)
    {
        _notificationMessage = message;
        _showNotification = true;
        StateHasChanged();

        _ = Task.Run(async () =>
        {
            await Task.Delay(3000);
            _showNotification = false;
            await InvokeAsync(StateHasChanged);
        });
    }

    private void ShowDeleteConfirmation() => _showDeleteModal = true;
    private void CancelDelete() => _showDeleteModal = false;

    private async Task ConfirmDelete()
    {
        if (_dataSource is null) return;
        await ProjectSvc.DeleteDataSourceAsync(_dataSource.Id);
        _showDeleteModal = false;
        Nav.NavigateTo(AppRoutes.Dashboard);
    }

    private async Task HandleSaveDataSource((string name, string? description) data)
    {
        if (_dataSource is null) return;

        var updatedDs = new DataSource
        {
            Id = _dataSource.Id,
            Name = data.name,
            Description = data.description,
            Type = _dataSource.Type,
            Enabled = _dataSource.Enabled,
            Assessments = _dataSource.Assessments
        };

        await ProjectSvc.UpdateDataSourceAsync(updatedDs);
        LoadDataSource();
        ShowNotification("Updated successfully");
    }

    private int GetAssessmentVersion(DataSourceAssessment? assessment)
    {
        if (assessment == null || _dataSourceAssessments == null) return 0;
        return _dataSourceAssessments.OrderBy(a => a.ConductedAt).ToList().IndexOf(assessment) + 1;
    }

    private async Task HandleSetActiveAssessment()
    {
        if (_selectedAssessment is null) return;
        await ProjectSvc.SetActiveAssessmentAsync(_selectedAssessment.Id);
        LoadDataSource();
        ShowNotification("Profile set as active successfully");
    }

    private async Task HandleRenameAssessment(string newName)
    {
        if (_selectedAssessment is null) return;
        _selectedAssessment.Name = newName;
        await ProjectSvc.UpdateAssessmentAsync(_selectedAssessment);
        LoadDataSource();
        ShowNotification("Profile renamed successfully");
    }

    private async Task HandleDeleteAssessment()
    {
        if (_selectedAssessment is null) return;

        await ProjectSvc.DeleteAssessmentAsync(_selectedAssessment.Id);
        LoadDataSource();
        _selectedAssessment = _dataSourceAssessments?.Any() == true
            ? _dataSourceAssessments.OrderByDescending(a => a.ConductedAt).First()
            : null;

        ShowNotification("Profile deleted successfully");
    }

    public void Dispose()
    {
        ProjectSvc.Changed -= OnProjectChanged;
    }
}
