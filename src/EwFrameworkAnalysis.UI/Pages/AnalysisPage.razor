@page "/analysis"
@using EwFrameworkAnalysis.Common.FrameworkReferenceData
@using EwFrameworkAnalysis.Common.Models.Project
@using EwFrameworkAnalysis.Common.Models.Scoring
@using EwFrameworkAnalysis.Common.Services
@using EwFrameworkAnalysis.UI.Components
@using EwFrameworkAnalysis.UI.Pages.Analysis
@using EwFrameworkAnalysis.UI.Services
@inject AnalysisProjectService ProjectSvc
@inject DataElementScoringService ScoringSvc
@inject PdfReportService PdfReportSvc

<div class="container mx-auto max-w-7xl p-4 lg:p-8">
    <!-- Header -->
    <AnalysisHeader OnGenerateReport="GenerateReportAsync"/>

    <!-- EQ Readiness Summary -->
    <EqReadinessSummary QuestionScores="_questionScores"
                        SectorReadinessScores="_sectorReadinessScores"
                        OverallReadinessScores="_overallReadinessScores"
                        ActiveDataSources="ActiveDataSources"/>

    <!-- Overall and Readiness Assessment -->
    <OverallReadinessAssessment SectorReadinessScores="_sectorReadinessScores" OverallReadinessScores="_overallReadinessScores" />

    <!-- Tabs -->
    <div class="tabs tabs-border !rounded-none">

        <!-- Essential Questions Grid -->
        <input type="radio" name="my_tabs_3" class="tab text-lg bg-white !rounded-b-none !rounded-tr-none !border-l-0 font-title font-semibold text-blue" aria-label="Essential Questions" checked="checked"/>
        <EssentialQuestionGrid QuestionScores="_questionScores"/>

        <!-- Indicators Grid -->
        <input type="radio" name="my_tabs_3" class="tab text-lg  bg-white !rounded-none font-title font-semibold text-blue" aria-label="Indicators"/>
        <IndicatorGrid IndicatorScores="_indicatorScores"/>

        <!-- Disaggregates Grid -->
        <input type="radio" name="my_tabs_3" class="tab text-lg  bg-white !rounded-b-none !rounded-tl-none font-title font-semibold text-blue" aria-label="Disaggregates"/>
        <Card Shadow="Card.ShadowSize.XLarge" AdditionalClasses="tab-content rounded-tl-none">Not implemented.</Card>
        @* <DisaggregateGrid DisaggregateScore="_disaggregateScores" /> *@

    </div>
</div>

@code {
    private List<DataSource> ActiveDataSources => ProjectSvc.DataSources.Where(x => x.Enabled).ToList();

    private List<DataSourceAssessmentWithSource> Assessments => ActiveDataSources.SelectMany(ds => ds.Assessments.Select(a => new
    DataSourceAssessmentWithSource
    {
        // base properties
        Id = a.Id,
        Name = a.Name,
        ConductedAt = a.ConductedAt,
        Notes = a.Notes,
        DataElementAssessments = a.DataElementAssessments,
        Active = a.Active,

        // datasource metadata
        DataSourceId = ds.Id,
        DataSourceType = ds.Type
    }))
    .ToList();

    private List<QuestionScore> _questionScores = [];
    private List<IndicatorScore> _indicatorScores = [];
    private OverallReadinessResults _overallReadinessScores = new();
    private List<SectorReadinessResult> _sectorReadinessScores = [];

    protected override async Task OnInitializedAsync()
    {
        await ProjectSvc.InitializeAsync();
        CalculateScores();
    }

    private async Task GenerateReportAsync()
    {
        await PdfReportSvc.GenerateReportAsync(_questionScores, _sectorReadinessScores, _overallReadinessScores, ActiveDataSources);
    }

    private void CalculateScores()
    {
        _questionScores = ScoringSvc.CalculateScoresForActiveData(Assessments);

        _indicatorScores = _questionScores.SelectMany(qs => qs.IndicatorScores).ToList();

        _overallReadinessScores = ScoringSvc.CalculateOverallReadinessScores(Assessments);

        _sectorReadinessScores = ScoringSvc.CalculateSectorReadiness(_questionScores);
    }
}
