@page "/analysis"
@using EwFrameworkAnalysis.Common.Models.Scoring
@using EwFrameworkAnalysis.Common.Services
@using EwFrameworkAnalysis.UI.Pages.Analysis
@using EwFrameworkAnalysis.UI.Services
@inject AnalysisProjectService ProjectSvc
@inject FrameworkCoverageService CoverageSvc
@inject PdfReportService PdfReportSvc
@inject BusyService BusySvc

<div class="container mx-auto max-w-7xl p-4 lg:p-8">
    <AnalysisHeader OnGenerateReport="GenerateReportAsync" />

    <AnalysisStatistics Coverage="_coverage" />

    <!-- Tabs -->
    <div>
        <div class="flex border-b border-gray-300">
            <button class="px-4 py-2 font-title font-semibold text-sm sm:text-lg transition-colors rounded-t-lg
                @(_activeTab == 0
                        ? "border border-b-white border-gray-300 bg-white text-blue -mb-px"
                        : "text-gray hover:text-blue")"
                    @onclick="() => _activeTab = 0"
                    data-walkthrough="@WalkthroughSteps.StepIds.ScoreGridSelector">
                <span class="@(_activeTab == 0 ? "hidden" : "sm:hidden")">EQ</span>
                <span class="@(_activeTab == 0 ? "" : "hidden sm:inline")">Essential Questions</span>
            </button>
            <button class="px-4 py-2 font-title font-semibold text-sm sm:text-lg transition-colors rounded-t-lg
                @(_activeTab == 1
                        ? "border border-b-white border-gray-300 bg-white text-blue -mb-px"
                        : "text-gray hover:text-blue")"
                    @onclick="() => _activeTab = 1">
                <span class="@(_activeTab == 1 ? "hidden" : "sm:hidden")">Ind</span>
                <span class="@(_activeTab == 1 ? "" : "hidden sm:inline")">Indicators</span>
            </button>
            <button class="px-4 py-2 font-title font-semibold text-sm sm:text-lg transition-colors rounded-t-lg
                @(_activeTab == 2
                        ? "border border-b-white border-gray-300 bg-white text-blue -mb-px"
                        : "text-gray hover:text-blue")"
                    @onclick="() => _activeTab = 2">
                <span class="@(_activeTab == 2 ? "hidden" : "sm:hidden")">Disagg</span>
                <span class="@(_activeTab == 2 ? "" : "hidden sm:inline")">Disaggregates</span>
            </button>
        </div>

        @if (_activeTab == 0)
        {
            <EssentialQuestionGrid QuestionScores="_coverage.QuestionScores" />
        }
        else if (_activeTab == 1)
        {
            <IndicatorGrid IndicatorScores="_coverage.IndicatorScores" />
        }
        else
        {
            <DisaggregateGrid DisaggregateScores="_coverage.DisaggregateScores" />
        }
    </div>
</div>

@code {
    private FrameworkCoverage _coverage = new();
    private int _activeTab = 0;

    protected override void OnInitialized()
    {
        ProjectSvc.Changed += OnProjectChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        using var _ = await BusySvc.BeginAsync("Loading…");
        RecalculateCoverage();
        StateHasChanged();
    }

    public void Dispose()
    {
        ProjectSvc.Changed -= OnProjectChanged;
    }

    private void OnProjectChanged()
    {
        RecalculateCoverage();
        InvokeAsync(StateHasChanged);
    }

    private void RecalculateCoverage()
    {
        _coverage = CoverageSvc.CalculateFrameworkCoverage(ProjectSvc.GetActiveAssessmentsWithSource());
    }

    private async Task GenerateReportAsync()
    {
        await BusySvc.WhileBusyAsync(async () =>
        {
            var dataSourceScores = ProjectSvc.DataSources
                .Where(ds => ds.Enabled)
                .Select(ds =>
                {
                    var sourceAssessments = ProjectSvc.GetActiveAssessmentsWithSource()
                        .Where(a => a.DataSourceId == ds.Id)
                        .ToList();
                    var sourceCoverage = CoverageSvc.CalculateFrameworkCoverage(sourceAssessments);
                    return new DataSourceScore(ds.Name, (double)sourceCoverage.OverallCoverage);
                })
                .ToList();

            await PdfReportSvc.GenerateReportAsync(_coverage,
                ProjectSvc.Project.Title,
                dataSourceScores);
        }, "Generating report…");
    }
}
