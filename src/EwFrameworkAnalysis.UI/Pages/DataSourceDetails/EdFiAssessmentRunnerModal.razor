@using System.Text.Json
@using System.Net.Http.Headers
@using EwFrameworkAnalysis.UI.Components
@using EwFrameworkAnalysis.UI.Options
@using Microsoft.Extensions.Options
@using EwFrameworkAnalysis.Common.Models.Project
@using EwFrameworkAnalysis.Common.Services
@inject EdFiAssessmentOrchestrator Orchestrator
@inject IOptions<DemoEdFiApiOptions> DemoApiOptions

@if (IsOpen)
{
    <div class="modal modal-open">
        <div class="modal-box max-h-5/6 @(_currentProgress != null ? "min-w-3/4" : "") pb-0">
            <h3 class="font-bold text-lg mb-4">Run Automated Scan</h3>

            @if (_showAssessmentRunner && DataSource.Type == DataSourceType.EdFiApi)
            {
                @if (_isRunning && _validationError == "") { }
            }

            @if (_currentProgress == null)
            {
                @if (DemoApiOptions.Value.IsConfigured)
                {
                    <div class="alert bg-base-200 border-2 border-blue mb-4">
                        <i class="fas fa-info-circle"></i>
                        <span>A read-only demo Ed-Fi API is available for testing</span>
                        <button class="btn btn-sm btn-primary" @onclick="UseDemoCredentials">
                            <i class="fas fa-flask mr-2"></i>Use Demo API
                        </button>
                    </div>
                }

                <div class="form-control mb-3">
                    <label class="label">
                        <span class="label-text">Client ID</span>
                    </label>
                    <input @bind="_clientId" type="text" placeholder="Enter client ID" class="input input-bordered w-full" />
                </div>

                <div class="form-control mb-3">
                    <label class="label">
                        <span class="label-text">Client Secret</span>
                    </label>
                    <input @bind="_clientSecret" type="password" placeholder="Enter client secret" class="input input-bordered w-full" />
                </div>

                <div class="form-control mb-6">
                    <label class="label">
                        <span class="label-text">API URL</span>
                    </label>
                    <input @bind="_rootUrl" type="text" placeholder="https://api.example.com" class="input input-bordered w-full" />
                </div>
            }


            @if (_currentProgress != null)
            {
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4 ">
                    <Card Shadow="Card.ShadowSize.Default" AdditionalClasses="p-4">
                        <h3 class="text-sm text-gray mb-2">Overall Progress</h3>
                        <div class="text-3xl font-bold text-blue">@_currentProgress.PercentComplete%</div>
                        <progress class="progress progress-primary w-full h-2 mt-2" value="@_currentProgress.PercentComplete" max="100"></progress>
                    </Card>
                    <Card Shadow="Card.ShadowSize.Default" AdditionalClasses="p-4">
                        <h3 class="text-sm text-gray mb-2">Profilers Complete</h3>
                        <div class="text-3xl font-bold text-blue">@_currentProgress.CompletedAssessors / @_currentProgress.TotalAssessors</div>
                    </Card>
                    <Card Shadow="Card.ShadowSize.Default" AdditionalClasses="p-4">
                        <h3 class="text-sm text-gray mb-2">Status</h3>
                        <div class="space-y-1 text-sm">
                            <div class="flex justify-between">
                                <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-yellow-500"></span>Running</span>
                                <span class="font-bold">@_currentProgress.AssessorProgresses.Count(a => a.Status == AssessorStatus.Running)</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-success"></span>Completed</span>
                                <span class="font-bold">@_currentProgress.AssessorProgresses.Count(a => a.Status == AssessorStatus.Completed)</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-red-500"></span>Failed</span>
                                <span class="font-bold">@_currentProgress.AssessorProgresses.Count(a => a.Status == AssessorStatus.Failed)</span>
                            </div>
                        </div>
                    </Card>
                </div>

                <Card Shadow="Card.ShadowSize.Default" NoPadding AdditionalClasses="mb-4">
                    <div class="px-4 py-3 border-b border-gray-200">
                        <h3 class="font-semibold text-blue">Profiler Progress</h3>
                    </div>
                    <div class="p-4 space-y-2 max-h-96 overflow-y-auto">
                        @foreach (var assessor in _currentProgress.AssessorProgresses)
                        {
                            <Card Background="@GetAssessorBackground(assessor.Status)"
                                  Border="new Card.BorderStyle(GetAssessorBorderColor(assessor.Status), Card.BorderPosition.Left)"
                                  Shadow="Card.ShadowSize.None">
                                <div class="flex items-start justify-between gap-3">
                                    <div class="flex-1 min-w-0">
                                        <div class="flex items-center gap-2 mb-1">
                                            @if (assessor.Status == AssessorStatus.Running)
                                            {
                                                <span class="loading loading-spinner loading-sm text-yellow-500"></span>
                                            }
                                            else if (assessor.Status == AssessorStatus.Completed)
                                            {
                                                <i class="fas fa-check-circle text-success"></i>
                                            }
                                            else if (assessor.Status == AssessorStatus.Failed)
                                            {
                                                <i class="fas fa-times-circle text-red-500"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-clock text-gray"></i>
                                            }
                                            <span class="font-semibold text-sm text-blue truncate">@assessor.DataElementName</span>
                                        </div>
                                        @if (assessor.Status == AssessorStatus.Completed && assessor.Result != null)
                                        {
                                            <div class="ml-6 mt-2 space-y-2">
                                                <div class="text-xs text-success">@assessor.Result.Characteristics?.Count characteristic(s) collected</div>
                                                @if (assessor.Result.Characteristics?.Any() == true)
                                                {
                                                    <div class="space-y-1 pl-2 border-l-2 border-success">
                                                        @foreach (var characteristic in assessor.Result.Characteristics)
                                                        {
                                                            @if (characteristic is RecordCount rc)
                                                            {
                                                                <div class="text-xs text-gray-700">
                                                                    <span class="font-medium">Records:</span> @rc.Value.ToString("N0")
                                                                </div>
                                                            }
                                                            else if (characteristic is ReportedAvailability ra)
                                                            {
                                                                <div class="text-xs text-gray-700">
                                                                    <span class="font-medium">Availability:</span>
                                                                    <span class="badge badge-xs @GetAvailabilityBadge(ra.Value)">@ra.Value</span>
                                                                </div>
                                                            }
                                                            else if (characteristic is Completeness c)
                                                            {
                                                                <div class="text-xs text-gray-700">
                                                                    <span class="font-medium">@c.AttributeName:</span> @c.Percentage.ToString("F1")% complete
                                                                </div>
                                                            }
                                                            else if (characteristic is IntegerRange ir)
                                                            {
                                                                <div class="text-xs text-gray-700">
                                                                    <span class="font-medium">@ir.Label:</span> @ir.Minimum - @ir.Maximum
                                                                </div>
                                                            }
                                                            else if (characteristic is Distribution dist)
                                                            {
                                                                <div class="text-xs text-gray-700">
                                                                    <span class="font-medium">@dist.Label:</span> @dist.TotalCount.ToString("N0") items
                                                                </div>
                                                            }
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else if (assessor.Status == AssessorStatus.Running)
                                        {
                                            <div class="ml-6 text-xs text-yellow-600">@(assessor.StatusMessage ?? "Processing...")</div>
                                        }
                                        else if (assessor.Status == AssessorStatus.Failed)
                                        {
                                            <div class="ml-6 text-xs text-red-500">@assessor.ErrorMessage</div>
                                        }

                                        @if (assessor.LogMessages?.Any() == true)
                                        {
                                            <CollapsibleSection Title="@($"{assessor.LogMessages.Count} log message(s)")"
                                                                SectionClasses="bg-gray-50 border border-gray-200 rounded"
                                                                TitleClasses="text-xs text-blue"
                                                                AdditionalClasses="ml-6 mt-2">
                                                <div class="font-mono text-xs space-y-1 max-h-48 overflow-y-auto">
                                                    @foreach (var log in assessor.LogMessages)
                                                    {
                                                        <div class="text-gray-700">@log</div>
                                                    }
                                                </div>
                                            </CollapsibleSection>
                                        }
                                    </div>
                                    <div class="badge badge-sm @GetStatusBadgeClass(assessor.Status)">@assessor.Status.ToString()</div>
                                </div>
                            </Card>
                        }
                    </div>
                </Card>
            }


            @if (_error != null)
            {
                <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i><span>@_error</span></div>
            }


            @if (_assessmentResult != null)
            {
                <div class="alert alert-success">
                    <i class="fas fa-check-circle"></i>
                    <div>
                        <h3 class="font-bold">Automated Scan Complete!</h3>
                        <div class="text-sm">Scanned @_assessmentResult.DataElementAssessments.Count data elements producing @_assessmentResult.DataElementAssessments.Sum(a => a.Characteristics.Count) total characteristics</div>
                    </div>
                </div>
            }


            <div class="modal-action sticky bottom-0 bg-base-100 py-6 px-2">
                @if (_isRunning)
                {
                    <button class="btn btn-error" @onclick="CancelAssessment">
                        <i class="fas fa-stop mr-2"></i>Cancel Scan
                    </button>
                }
                else if (_assessmentResult != null)
                {
                    <button class="btn btn-ghost" @onclick="ShowDiscardConfirmation">
                        <i class="fas fa-times mr-2"></i>Discard
                    </button>
                    <button class="btn btn-primary" @onclick="SaveResults">
                        <i class="fas fa-save mr-2"></i>Save
                    </button>
                }
                else
                {
                    <button class="btn btn-ghost" @onclick="Close">Cancel</button>
                    <button class="btn btn-secondary" @onclick="StartAssessment">
                        <i class="fas fa-play mr-2"></i>Start Scan
                    </button>
                }
            </div>
        </div>
    </div>
    <!-- Discard Confirmation Modal -->
    @if (_showDiscardConfirmation)
    {
        <div class="modal modal-open">
            <div class="modal-box">
                <h3 class="font-bold text-lg text-blue">Discard Scan Results?</h3>
                <p class="py-4 text-gray">
                    Are you sure you want to discard these scan results? All collected metadata will be lost.
                </p>
                <div class="modal-action">
                    <button class="btn btn-ghost" @onclick="CancelDiscard">Cancel</button>
                    <button class="btn btn-error" @onclick="ConfirmDiscard">
                        <i class="fas fa-trash mr-2"></i>Discard
                    </button>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public required DataSource DataSource { get; set; }
    [Parameter] public EventCallback<DataSourceAssessment> OnAssessmentComplete { get; set; }

    private bool _showAssessmentRunner = false;
    private bool _isRunning = false;
    private bool _showDiscardConfirmation = false;

    private string _clientId = "";
    private string _clientSecret = "";
    private string _rootUrl = "";

    private string DataApiUrl => EnsureTrailingSlash(_rootUrl) + "data/v3/";
    private string AuthUrl => EnsureTrailingSlash(_rootUrl) + "oauth/token";

    private AssessmentProgress? _currentProgress;
    private DataSourceAssessment? _assessmentResult;
    private string? _error;
    private string? _validationError;
    private CancellationTokenSource? _cancellationTokenSource;
    private Timer? _renderTimer;
    private volatile bool _pendingRender;

    private void UseDemoCredentials()
    {
        var demoApi = DemoApiOptions.Value;

        _rootUrl = demoApi.BaseUrl ?? "";
        _clientId = demoApi.ClientId ?? "";
        _clientSecret = demoApi.ClientSecret ?? "";

        StateHasChanged();
    }

    private async Task StartAssessment()
    {
        _validationError = null;
        _error = null;

        if (!Uri.TryCreate(DataApiUrl, UriKind.Absolute, out var baseUri))
        {
            _validationError = "Invalid Root URL";
            return;
        }

        try
        {
            _isRunning = true;
            _cancellationTokenSource = new CancellationTokenSource();

            var httpClient = new HttpClient { BaseAddress = baseUri };

            var token = await GetAccessTokenAsync(AuthUrl, _clientId, _clientSecret);
            httpClient.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);

            var progress = new Progress<AssessmentProgress>(OnProgressUpdate);

            _assessmentResult = await Orchestrator.RunAssessmentsAsync(
                httpClient,
                DataSource!,
                $"Automated Scan {DateTimeOffset.Now:yyyy-MM-dd HH:mm}",
                progress,
                true,
                _cancellationTokenSource.Token
            );

            httpClient.Dispose();
        }
        catch (OperationCanceledException)
        {
            _error = "Scan was cancelled by user.";
        }
        catch (Exception ex)
        {
            _error = $"Scan failed: {ex.Message}";
        }
        finally
        {
            _isRunning = false;
            _cancellationTokenSource?.Dispose();
            _cancellationTokenSource = null;
            await InvokeAsync(StateHasChanged);
        }
    }


    private async Task<string> GetAccessTokenAsync(string authUrl, string clientId, string clientSecret)
    {
        using var authClient = new HttpClient();

        var tokenRequest = new HttpRequestMessage(HttpMethod.Post, authUrl);
        var formData = new Dictionary<string, string>
        {
            ["grant_type"] = "client_credentials",
            ["client_id"] = clientId,
            ["client_secret"] = clientSecret
        };
        tokenRequest.Content = new FormUrlEncodedContent(formData);

        var response = await authClient.SendAsync(tokenRequest);

        if (!response.IsSuccessStatusCode)
        {
            var error = await response.Content.ReadAsStringAsync();
            throw new InvalidOperationException($"OAuth failed ({response.StatusCode}): {error}");
        }

        var json = await response.Content.ReadAsStringAsync();
        var token = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(json);

        if (token?.TryGetValue("access_token", out var accessToken) == true)
        {
            return accessToken.GetString() ?? throw new InvalidOperationException("Access token was null");
        }

        throw new InvalidOperationException("No access_token in response");
    }

    private void OnProgressUpdate(AssessmentProgress p)
    {
        _currentProgress = p;
        _pendingRender = true;

        _renderTimer ??= new Timer(_ =>
        {
            if (_pendingRender)
            {
                _pendingRender = false;
                InvokeAsync(StateHasChanged);
            }
        }, null, 0, 500);
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(IsOpen);
    }

    private static string EnsureTrailingSlash(string url)
    {
        if (string.IsNullOrWhiteSpace(url))
            return url;
        return url.EndsWith("/") ? url : url + "/";
    }

    private async Task CancelAssessment()
    {
        _cancellationTokenSource?.Cancel();
        await Close();
    }

    private void ShowDiscardConfirmation()
    {
        _showDiscardConfirmation = true;
    }

    private void CancelDiscard()
    {
        _showDiscardConfirmation = false;
    }

    private async Task ConfirmDiscard()
    {
        _showDiscardConfirmation = false;
        ResetAssessmentRunner();
        await Close();
    }

    private async Task SaveResults()
    {
        if (_assessmentResult != null)
        {
            await OnAssessmentComplete.InvokeAsync(_assessmentResult);
        }
        await Close();
    }

    private void ResetAssessmentRunner()
    {
        _currentProgress = null;
        _assessmentResult = null;
        _error = null;
        _validationError = null;
    }

    private string GetStatusBadgeClass(AssessorStatus status) => status switch
    {
        AssessorStatus.Pending => "badge-ghost",
        AssessorStatus.Running => "badge-warning",
        AssessorStatus.Completed => "badge-success",
        AssessorStatus.Failed => "badge-error",
        _ => "badge-ghost"
    };

    private string GetAvailabilityBadge(AvailabilityJudgment judgment) => judgment switch
    {
        AvailabilityJudgment.Available => "badge-success",
        AvailabilityJudgment.PartiallyAvailable => "badge-warning",
        AvailabilityJudgment.NotAvailable => "badge-error",
        AvailabilityJudgment.InsufficientData => "badge-ghost",
        _ => "badge-ghost"
    };

    private Card.BackgroundColor GetAssessorBackground(AssessorStatus status) => status switch
    {
        AssessorStatus.Running => Card.BackgroundColor.Yellow,
        AssessorStatus.Completed => Card.BackgroundColor.Green,
        AssessorStatus.Failed => Card.BackgroundColor.Red,
        _ => Card.BackgroundColor.Gray
    };

    private Card.BorderColor GetAssessorBorderColor(AssessorStatus status) => status switch
    {
        AssessorStatus.Running => Card.BorderColor.Yellow,
        AssessorStatus.Completed => Card.BorderColor.Green,
        AssessorStatus.Failed => Card.BorderColor.Red,
        _ => Card.BorderColor.Gray
    };
}
