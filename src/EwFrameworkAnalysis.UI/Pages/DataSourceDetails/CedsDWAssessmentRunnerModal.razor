@using System.Text
@using EwFrameworkAnalysis.UI.Components
@using EwFrameworkAnalysis.UI.Options
@using Microsoft.Extensions.Options
@using EwFrameworkAnalysis.Common.Models.Project
@using EwFrameworkAnalysis.Common.Services
@using static EwFrameworkAnalysis.UI.Components.BorderedInfoCard
@using Microsoft.AspNetCore.Components.Forms
@inject AnalysisProjectService ProjectSvc
@inject CedsDWAssessmentOrchestrator Orchestrator
@inject IOptions<DemoCedsOptions> DemoOptions
@inject IJSRuntime JSRuntime

@if (IsOpen)
{
    <div class="modal modal-open">
        <div class="modal-box max-h-5/6 @(_assessmentResult != null ? "min-w-3/4" : "") pb-0">
            <h3 class="font-bold text-lg mb-4">CEDS Data Warehouse Assessment</h3>

            @if (_assessmentResult == null)
            {
                <div class="space-y-4">
                    <p class="text-sm">
                        This assessment uses a secure airgapped workflow. Your data never leaves your environment,
                        giving you complete control and visibility into what's being assessed.
                    </p>

                    <ol class="text-sm space-y-2 list-decimal list-inside">
                        <li>
                            <button @onclick="DownloadScript" class="link link-primary">
                                Download the SQL assessment script
                            </button>
                            <span class="text-xs text-gray-500 ml-1">(@_assessorCount assessments included)</span>
                        </li>
                        <li>Run the script on your CEDS Data Warehouse database</li>
                        <li>Export the results as CSV (instructions are in the script)</li>
                        <li>Upload the CSV file below</li>
                    </ol>

                    @if (DemoOptions.Value.IsConfigured)
                    {
                        <div class="alert bg-base-200 border-2 border-blue">
                            <i class="fas fa-flask"></i>
                            <span>A sample results file is available for testing</span>
                            <button class="btn btn-sm btn-primary" @onclick="DownloadSampleResults">
                                <i class="fas fa-download mr-2"></i>Download Sample Results
                            </button>
                        </div>
                    }

                    @if (_error != null)
                    {
                        <div class="alert alert-error">
                            <i class="fas fa-exclamation-circle"></i>
                            <span>@_error</span>
                        </div>
                    }

                    <div class="form-control">
                        <label class="label">
                            <span class="label-text">Upload Results CSV</span>
                        </label>
                        <InputFile OnChange="HandleFileSelected"
                                   accept=".csv"
                                   @ref="_fileInput"
                                   class="file-input file-input-bordered w-full mb-3" />
                        <button class="btn btn-primary w-full"
                                @onclick="ProcessFile"
                                disabled="@(_selectedFile == null || _isProcessing)">
                            @if (_isProcessing)
                            {
                                <span class="loading loading-spinner loading-sm"></span>
                                <span>Processing...</span>
                            }
                            else
                            {
                                <i class="fas fa-upload mr-2"></i>
                                <span>Process CSV</span>
                            }
                        </button>
                    </div>
                </div>
            }
            else
            {
                <!-- Review Results -->
                <div class="space-y-4">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="bg-white border border-gray-200 rounded-lg p-4 shadow">
                            <h3 class="text-sm text-gray mb-2">Data Elements</h3>
                            <div class="text-3xl font-bold text-blue">@_assessmentResult.DataElementAssessments.Count</div>
                        </div>
                        <div class="bg-white border border-gray-200 rounded-lg p-4 shadow">
                            <h3 class="text-sm text-gray mb-2">Total Characteristics</h3>
                            <div class="text-3xl font-bold text-blue">@_assessmentResult.DataElementAssessments.Sum(a => a.Characteristics.Count)</div>
                        </div>
                        <div class="bg-white border border-gray-200 rounded-lg p-4 shadow">
                            <h3 class="text-sm text-gray mb-2">Assessment Date</h3>
                            <div class="text-sm font-semibold text-blue">@_assessmentResult.ConductedAt.ToString("MMM d, yyyy h:mm tt")</div>
                        </div>
                    </div>

                    <div class="bg-white border border-gray-200 rounded-lg shadow">
                        <div class="px-4 py-3 border-b border-gray-200">
                            <h3 class="font-semibold text-blue">Assessment Results Preview</h3>
                        </div>
                        <div class="p-4 space-y-2 max-h-96 overflow-y-auto">
                            @foreach (var element in _assessmentResult.DataElementAssessments.OrderBy(e => e.DataElementName))
                            {
                                <BorderedInfoCard Color="CardColor.Green" AdditionalClasses="p-3">
                                    <div class="space-y-2">
                                        <div class="flex items-center gap-2">
                                            <i class="fas fa-check-circle text-success"></i>
                                            <span class="font-semibold text-sm text-blue">@element.DataElementName</span>
                                            <span class="badge badge-sm badge-ghost">@element.Characteristics.Count characteristic(s)</span>
                                        </div>

                                        <div class="ml-6 space-y-1 pl-2 border-l-2 border-success">
                                            @foreach (var characteristic in element.Characteristics)
                                            {
                                                @if (characteristic is RecordCount rc)
                                                {
                                                    <div class="text-xs text-gray-700">
                                                        <span class="font-medium">Records:</span> @rc.Value.ToString("N0")
                                                    </div>
                                                }
                                                else if (characteristic is ReportedAvailability ra)
                                                {
                                                    <div class="text-xs text-gray-700">
                                                        <span class="font-medium">Availability:</span>
                                                        <span class="badge badge-xs @GetAvailabilityBadge(ra.Value)">@ra.Value</span>
                                                    </div>
                                                }
                                                else if (characteristic is Completeness c)
                                                {
                                                    <div class="text-xs text-gray-700">
                                                        <span class="font-medium">@c.AttributeName:</span> @c.Percentage.ToString("F1")% complete
                                                    </div>
                                                }
                                                else if (characteristic is IntegerRange ir)
                                                {
                                                    <div class="text-xs text-gray-700">
                                                        <span class="font-medium">@ir.Label:</span> @ir.Minimum - @ir.Maximum
                                                    </div>
                                                }
                                                else if (characteristic is Distribution dist)
                                                {
                                                    <div class="text-xs text-gray-700">
                                                        <span class="font-medium">@dist.Label:</span> @dist.TotalCount.ToString("N0") items
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </div>
                                </BorderedInfoCard>
                            }
                        </div>
                    </div>

                    <div class="alert alert-success">
                        <i class="fas fa-check-circle"></i>
                        <div>
                            <h3 class="font-bold">Assessment Processed Successfully</h3>
                            <div class="text-sm">Review the results above and save to add to your project</div>
                        </div>
                    </div>
                </div>
            }

            <div class="modal-action sticky bottom-0 bg-base-100 py-6 px-2">
                @if (_assessmentResult == null)
                {
                    <button class="btn btn-ghost" @onclick="Close">Cancel</button>
                }
                else
                {
                    <button class="btn btn-ghost" @onclick="ShowDiscardConfirmation">
                        <i class="fas fa-times mr-2"></i>Discard Results
                    </button>
                    <button class="btn btn-primary" @onclick="SaveResults">
                        <i class="fas fa-save mr-2"></i>Save Results
                    </button>
                }
            </div>
        </div>
    </div>
}

<!-- Discard Confirmation Modal -->
@if (_showDiscardModal)
{
    <div class="modal modal-open" style="z-index: 1001;">
        <div class="modal-box">
            <h3 class="font-bold text-lg text-blue font-title">Discard Assessment Results?</h3>
            <p class="py-4 text-gray">
                Are you sure you want to discard these assessment results? This action cannot be undone.
            </p>
            <div class="modal-action">
                <button class="btn btn-ghost" @onclick="CancelDiscard">Keep Results</button>
                <button class="btn btn-error" @onclick="ConfirmDiscard">
                    <i class="fas fa-trash mr-2"></i>
                    Discard Results
                </button>
            </div>
        </div>
    </div>
}

<script>
    window.CedsAssessmentHelpers = {
        downloadFile: function(filename, content, contentType) {
            const blob = new Blob([content], { type: contentType });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = filename;
            a.click();
            URL.revokeObjectURL(url);
        }
    };
</script>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public required DataSource DataSource { get; set; }
    [Parameter] public EventCallback<DataSourceAssessment> OnAssessmentComplete { get; set; }

    private DataSourceAssessment? _assessmentResult;
    private string? _error;
    private bool _isProcessing = false;
    private bool _showDiscardModal = false;
    private int _assessorCount = 0;
    private IBrowserFile? _selectedFile;
    private InputFile? _fileInput;

    protected override void OnInitialized()
    {
        var assessors = Orchestrator.DiscoverAssessors();
        _assessorCount = assessors.Count;
    }

    private async Task DownloadScript()
    {
        try
        {
            var script = Orchestrator.GenerateUnionedQuery();
            var fileName = $"CEDS_Assessment_{DateTimeOffset.Now:yyyyMMdd_HHmmss}.sql";

            await JSRuntime.InvokeVoidAsync(
                "CedsAssessmentHelpers.downloadFile",
                fileName,
                script,
                "text/plain"
            );
        }
        catch (Exception ex)
        {
            _error = $"Failed to generate script: {ex.Message}";
        }
    }

    private async Task DownloadSampleResults()
    {
        var sampleCsv = GenerateSampleResultsCsv();
        var fileName = $"CEDS_Sample_Results_{DateTimeOffset.Now:yyyyMMdd_HHmmss}.csv";

        await JSRuntime.InvokeVoidAsync(
            "CedsAssessmentHelpers.downloadFile",
            fileName,
            sampleCsv,
            "text/csv"
        );
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
        _error = null;
    }

    private async Task ProcessFile()
    {
        if (_selectedFile == null) return;

        _error = null;
        _isProcessing = true;

        try
        {
            if (_selectedFile.Size > 10 * 1024 * 1024) // 10MB limit
            {
                _error = "File size exceeds 10MB limit";
                return;
            }

            using var stream = _selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);

            var parser = new DataSourceAssessmentFileParser();
            _assessmentResult = await parser.ParseAssessmentStreamAsync(
                stream,
                DataSource.Id,
                hasHeaderRow: true
            );

            _assessmentResult.Name = $"Assessment from {_selectedFile.Name}";
            _assessmentResult.ConductedAt = DateTimeOffset.Now;
        }
        catch (Exception ex)
        {
            _error = $"Failed to process file: {ex.Message}";
            _assessmentResult = null;
        }
        finally
        {
            _isProcessing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SaveResults()
    {
        if (_assessmentResult == null) return;

        await ProjectSvc.AddAssessmentAsync(_assessmentResult);
        await OnAssessmentComplete.InvokeAsync(_assessmentResult);
        await Close();
    }

    private void ShowDiscardConfirmation()
    {
        _showDiscardModal = true;
    }

    private void CancelDiscard()
    {
        _showDiscardModal = false;
    }

    private async Task ConfirmDiscard()
    {
        _showDiscardModal = false;
        _assessmentResult = null;
        await Close();
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(IsOpen);

        // Reset state
        _assessmentResult = null;
        _error = null;
        _isProcessing = false;
        _selectedFile = null;
    }

    private string GetAvailabilityBadge(AvailabilityJudgment judgment) => judgment switch
    {
        AvailabilityJudgment.Available => "badge-success",
        AvailabilityJudgment.PartiallyAvailable => "badge-warning",
        AvailabilityJudgment.NotAvailable => "badge-error",
        AvailabilityJudgment.InsufficientData => "badge-ghost",
        _ => "badge-ghost"
    };

    private string GenerateSampleResultsCsv()
    {
        // Simple sample data based on the test file
        return @"DataElementName,CharacteristicType,Value,SubItemLabel,Remarks
Suspensions and Expulsions (Grades 1 and 2),RecordCount,5,,
Suspensions and Expulsions (K-12),RecordCount,1020,,""No data found for the following grades: 10,11,12""
Student Age Range,IntegerRange,5,Minimum,Age of enrolled students
Student Age Range,IntegerRange,21,Maximum,
Student Contact Information,Completeness,850,PopulatedRecords,ElectronicMailAddress
Student Contact Information,Completeness,1000,TotalRecords,
Discipline Action Types,Distribution,450,In-School Suspension,Distribution of disciplinary actions taken
Discipline Action Types,Distribution,320,Out-of-School Suspension,
Discipline Action Types,Distribution,125,Expulsion with Services,
Discipline Action Types,Distribution,95,Expulsion without Services,
Special Education Services,ReportedAvailability,Available,,Availability based on record count thresholds
Gifted and Talented Programs,ReportedAvailability,PartiallyAvailable,,Only available for grades 3-8";
    }
}
