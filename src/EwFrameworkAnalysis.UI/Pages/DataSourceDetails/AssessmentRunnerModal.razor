@using EwFrameworkAnalysis.Common.Models.Project

@if (IsOpen)
{
    <div class="modal modal-open">
        <div class="modal-box max-h-5/6 @(ShowProgress ? "min-w-3/4" : "") pb-0">
            <h3 class="font-bold text-lg mb-4">@Title</h3>

            @* Render type-specific setup UI *@
            @if (!ShowProgress && !ShowResults)
            {
                @SetupContent
            }

            @* Render progress UI *@
            @if (ShowProgress)
            {
                @ProgressContent
            }

            @* Render error messages *@
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="alert alert-error mb-4">
                    <i class="fas fa-exclamation-circle"></i>
                    <span>@ErrorMessage</span>
                </div>
            }

            @* Render results UI *@
            @if (ShowResults)
            {
                @ResultsContent
            }

            @* Modal Actions *@
            <div class="modal-action sticky bottom-0 bg-base-100 py-6 px-2">
                @if (IsRunning)
                {
                    <button class="btn btn-error" @onclick="HandleCancel">
                        <i class="fas fa-stop mr-2"></i>Cancel
                    </button>
                }
                else if (ShowResults)
                {
                    <button class="btn btn-ghost" @onclick="HandleDiscard">
                        <i class="fas fa-times mr-2"></i>Discard
                    </button>
                    <button class="btn btn-primary" @onclick="HandleSave">
                        <i class="fas fa-save mr-2"></i>Save
                    </button>
                }
                else
                {
                    <button class="btn btn-ghost" @onclick="HandleClose">Cancel</button>
                    @ActionButtons
                }
            </div>
        </div>
    </div>
}

@* Discard Confirmation Modal *@
@if (_showDiscardConfirmation)
{
    <div class="modal modal-open">
        <div class="modal-box">
            <h3 class="font-bold text-lg text-blue font-title">Discard Results?</h3>
            <p class="py-4 text-gray">
                Are you sure you want to discard this data profile? This action cannot be undone.
            </p>
            <div class="modal-action">
                <button class="btn btn-ghost" @onclick="CancelDiscard">Cancel</button>
                <button class="btn btn-error" @onclick="ConfirmDiscard">
                    <i class="fas fa-trash mr-2"></i>Discard
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public string Title { get; set; } = "Run Data Profiler";

    [Parameter] public bool IsRunning { get; set; }
    [Parameter] public bool ShowProgress { get; set; }
    [Parameter] public bool ShowResults { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }

    [Parameter] public RenderFragment? SetupContent { get; set; }
    [Parameter] public RenderFragment? ProgressContent { get; set; }
    [Parameter] public RenderFragment? ResultsContent { get; set; }
    [Parameter] public RenderFragment? ActionButtons { get; set; }

    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnDiscard { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private bool _showDiscardConfirmation = false;

    private async Task HandleCancel()
    {
        await OnCancel.InvokeAsync();
    }

    private async Task HandleSave()
    {
        await OnSave.InvokeAsync();
    }

    private void HandleDiscard()
    {
        _showDiscardConfirmation = true;
    }

    private void CancelDiscard()
    {
        _showDiscardConfirmation = false;
    }

    private async Task ConfirmDiscard()
    {
        _showDiscardConfirmation = false;
        await OnDiscard.InvokeAsync();
    }

    private async Task HandleClose()
    {
        await OnClose.InvokeAsync();
    }
}
