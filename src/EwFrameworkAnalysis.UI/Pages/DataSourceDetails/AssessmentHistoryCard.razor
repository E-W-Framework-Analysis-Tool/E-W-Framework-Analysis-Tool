@using EwFrameworkAnalysis.Common.Models.Project
@using EwFrameworkAnalysis.UI.Components

<Card Shadow="Card.ShadowSize.XLarge">
    <ChildContent>
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-title font-semibold text-blue">Assessment History</h3>
            <span class="text-sm font-semibold text-gray">
                @(Assessments?.Count ?? 0) total
            </span>
        </div>

        @if (Assessments?.Any() == true)
        {
            <div class="space-y-3">
                @foreach (var a in Assessments.OrderByDescending(x => x.ConductedAt))
                {
                    var isViewing = a.Id == SelectedAssessment?.Id;
                    <div class="card bg-white border border-gray-200 shadow-md hover:bg-tan hover:shadow-[2px_4px_8px_0px_rgba(0,0,0,0.1),2px_2px_0px_0px_theme(colors.blue)] hover:-translate-y-1 hover:-translate-x-0.5 transform transition-all duration-200 cursor-pointer @(isViewing ? "ring-2 ring-blue ring-opacity-30 bg-tan" : "")"
                         @onclick="() => OnSelectAssessment.InvokeAsync(a)">
                        <div class="card-body p-4">
                            <div class="flex items-center justify-between">
                                <div class="flex-1 min-w-0 pr-2">
                                    <div class="flex items-start gap-2">
                                        <div class="text-sm font-semibold text-blue break-words flex-1 min-w-0">
                                            @(a.Name ?? "Unnamed Assessment")
                                        </div>

                                        @if (isViewing)
                                        {
                                            <div class="badge badge-sm bg-blue text-white">
                                                Viewing
                                            </div>
                                        }

                                        @if (a.Active ?? false)
                                        {
                                            <div class="badge badge-sm badge-success">
                                                Active
                                            </div>
                                        }
                                    </div>
                                    <div class="text-xs text-gray mt-1 break-words">@a.ConductedAt.ToString("g")</div>
                                    @if (a.DataElementAssessments?.Any() == true)
                                    {
                                        <div class="text-xs text-gray mt-1 break-words">@a.DataElementAssessments.Count data elements assessed</div>
                                    }
                                </div>
                                <div class="flex items-center gap-2 flex-shrink-0">
                                    <i class="fas fa-chevron-right text-gray"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-8 text-gray">
                <i class="fas fa-clock text-4xl mb-4 opacity-50"></i>
                <p class="font-semibold">No assessments yet</p>
                <p class="text-xs mt-2">Click "Run New Assessment" to get started.</p>
            </div>
        }
    </ChildContent>
</Card>

@code {
    [Parameter] public List<DataSourceAssessment>? Assessments { get; set; }
    [Parameter] public DataSourceAssessment? SelectedAssessment { get; set; }
    [Parameter] public EventCallback<DataSourceAssessment> OnSelectAssessment { get; set; }
}
