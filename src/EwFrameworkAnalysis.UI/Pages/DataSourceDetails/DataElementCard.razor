@using EwFrameworkAnalysis.Common.Models.Project
@using EwFrameworkAnalysis.Common.Models.Scoring
@using EwFrameworkAnalysis.UI.Components

<CollapsibleSection IsExpanded="@IsExpanded" AdditionalClasses="shadow-md hover:shadow-lg transition-shadow duration-200" AriaLabel="@($"Expand to view details for {Element.DataElementName} Data Element")">
    <TitleContent>
        <div class="flex-1 min-w-0">
            <h5 class="font-semibold text-blue">@Element.DataElementName</h5>
            @if (Element.Characteristics?.Any() == true)
            {
                <div class="flex items-center gap-2 mt-1">
                    <span class="text-xs text-gray">@Element.Characteristics.Count characteristic@(Element.Characteristics.Count != 1 ? "s" : "")</span>
                    <div class="flex gap-1">
                        @foreach (var characteristic in Element.Characteristics)
                        {
                            <span class="inline-block w-2 h-2 rounded-full @GetCharacteristicDotColor(characteristic)"></span>
                        }
                    </div>
                </div>
            }
        </div>
    </TitleContent>
    <ChildContent>
        @if (Element.Characteristics?.Any() == true)
        {
            <div class="space-y-3">
                @foreach (var characteristic in Element.Characteristics)
                {
                    @if (characteristic is RecordCount rc)
                    {
                        <Card Background="Card.BackgroundColor.Blue"
                              Border="new Card.BorderStyle(Card.BorderColor.Blue, Card.BorderPosition.Left)">
                            <div class="flex items-center justify-between">
                                <span class="text-sm text-gray-700 font-medium">Record Count</span>
                                <span class="text-lg font-bold text-gray-900">@rc.Value.ToString("N0")</span>
                            </div>
                        </Card>
                    }
                    else if (characteristic is ReportedAvailability ra)
                    {
                        <Card Background="Card.BackgroundColor.Green"
                              Border="new Card.BorderStyle(Card.BorderColor.Green, Card.BorderPosition.Left)">
                            <div class="flex items-center justify-between">
                                <span class="text-sm text-gray-700 font-medium">Availability</span>
                                <span class="badge @GetAvailabilityBadge(ra.Value)">@ra.Value</span>
                            </div>
                        </Card>
                    }
                    else if (characteristic is Completeness c)
                    {
                        <Card Background="Card.BackgroundColor.Yellow"
                              Border="new Card.BorderStyle(Card.BorderColor.Yellow, Card.BorderPosition.Left)">
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-sm font-medium text-gray-700">@c.AttributeName Completeness</span>
                                <span class="text-sm font-bold text-gray-900">@c.Percentage.ToString("F1")%</span>
                            </div>
                            <div class="w-full bg-gray-200 rounded-full h-2">
                                <div class="bg-yellow h-2 rounded-full transition-all" style="width: @(c.Percentage.ToString("F1"))%"></div>
                            </div>
                            <div class="text-xs text-gray-600 mt-1">@c.PopulatedRecords.ToString("N0") / @c.TotalRecords.ToString("N0") records</div>
                        </Card>
                    }
                    else if (characteristic is NumericalRange ir)
                    {
                        <Card Background="Card.BackgroundColor.Tan"
                              Border="new Card.BorderStyle(Card.BorderColor.Tan, Card.BorderPosition.Left)">
                            <span class="text-sm font-medium text-gray-700">@ir.Label:</span>
                            <span class="text-sm font-bold text-gray-900 ml-2">@ir.Minimum - @ir.Maximum</span>
                        </Card>
                    }
                    else if (characteristic is Distribution dist)
                    {
                        <Card Background="Card.BackgroundColor.Gray"
                              Border="new Card.BorderStyle(Card.BorderColor.Gray, Card.BorderPosition.Left)">
                            <div class="text-sm font-medium text-gray-700 mb-2">@dist.Label Distribution (@dist.TotalCount.ToString("N0") total)</div>
                            <div class="space-y-2">
                                @foreach (var kvp in dist.Counts.OrderByDescending(k => k.Value).Take(10))
                                {
                                    var percentage = dist.TotalCount > 0 ? (kvp.Value * 100.0 / dist.TotalCount) : 0;
                                    <div>
                                        <div class="flex items-center justify-between text-xs mb-1">
                                            <span class="font-medium text-gray-700 truncate mr-2">@kvp.Key</span>
                                            <span class="font-mono text-gray-900 whitespace-nowrap">@kvp.Value.ToString("N0") (@percentage.ToString("F1")%)</span>
                                        </div>
                                        <div class="w-full bg-gray-200 rounded-full h-1.5">
                                            <div class="bg-gray h-1.5 rounded-full transition-all" style="width: @(percentage.ToString("F1"))%"></div>
                                        </div>
                                    </div>
                                }
                            </div>
                            @if (dist.Counts.Count > 10)
                            {
                                <div class="text-xs text-gray-600 mt-2">Showing top 10 of @dist.Counts.Count items</div>
                            }
                        </Card>
                    }
                }
            </div>
            <div class="text-xs text-gray mt-3">Profiled: @Element.AssessedAt.ToString("g")</div>
        }
        else
        {
            <p class="text-sm text-gray">No characteristics recorded</p>
        }
    </ChildContent>
</CollapsibleSection>

@code {
    [Parameter, EditorRequired] public DataElementAssessment Element { get; set; } = null!;
    [Parameter] public bool IsExpanded { get; set; }

    private static readonly Dictionary<Type, Card.BorderColor> CharacteristicColorMap = new()
    {
        [typeof(RecordCount)] = Card.BorderColor.Blue,
        [typeof(ReportedAvailability)] = Card.BorderColor.Green,
        [typeof(Completeness)] = Card.BorderColor.Yellow,
        [typeof(NumericalRange)] = Card.BorderColor.Tan,
        [typeof(Distribution)] = Card.BorderColor.Gray
    };

    private string GetAvailabilityBadge(AvailabilityJudgment judgment) => judgment switch
    {
        AvailabilityJudgment.Available => "badge-success",
        AvailabilityJudgment.PartiallyAvailable => "badge-warning",
        AvailabilityJudgment.NotAvailable => "badge-error",
        AvailabilityJudgment.InsufficientData => "badge-ghost",
        _ => "badge-ghost"
    };

    private string GetCharacteristicDotColor(DataCharacteristicBase characteristic)
    {
        var borderColor = CharacteristicColorMap.GetValueOrDefault(characteristic.GetType(), Card.BorderColor.Gray);
        return borderColor switch
        {
            Card.BorderColor.Blue => "bg-blue",
            Card.BorderColor.Green => "bg-green",
            Card.BorderColor.Yellow => "bg-yellow",
            Card.BorderColor.Gray => "bg-gray",
            Card.BorderColor.Tan => "bg-tan",
            Card.BorderColor.Red => "bg-red",
            _ => "bg-gray"
        };
    }
}
