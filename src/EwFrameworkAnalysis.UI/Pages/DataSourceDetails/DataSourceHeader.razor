@using EwFrameworkAnalysis.Common.Models.Project
@using EwFrameworkAnalysis.UI.Components

<Card Overflow Shadow="Card.ShadowSize.XLarge" AdditionalClasses="mb-6" NoPadding>
    <ChildContent>
        <div class="px-4 py-5 sm:p-6">
            <div class="flex items-start justify-between gap-4">
                <!-- Left: Title and Description -->
                <div class="flex-1 min-w-0 space-y-3">
                    <!-- Editable Name -->
                    <EditableField Value="@DataSource.Name"
                                   Placeholder="Enter data source name"
                                   Variant="EditableField.FieldVariant.Title"
                                   OnSave="@HandleNameSave" />

                    <!-- Editable Description -->
                    <EditableField Value="@DataSource.Description"
                                   Placeholder="Enter description (optional)"
                                   EmptyStateText="Add description"
                                   Variant="EditableField.FieldVariant.Text"
                                   Multiline
                                   Rows="3"
                                   OnSave="@HandleDescriptionSave" />

                    <!-- Status and Stats row -->
                    <div class="flex items-center gap-4 text-sm">
                        <div class="flex items-center gap-2">
                            @if (DataSource.Enabled)
                            {
                                <span class="badge badge-success gap-1">
                                    <i class="fas fa-check-circle"></i>
                                    Enabled
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-error gap-1">
                                    <i class="fas fa-times-circle"></i>
                                    Disabled
                                </span>
                            }
                        </div>

                        <div class="divider divider-horizontal mx-0"></div>

                        <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-medium bg-blue text-white">
                            @DataSource.Type.GetDisplayName()
                        </span>
                    </div>
                </div>

                <!-- Right: Actions -->
                <div class="flex items-center space-x-3 flex-shrink-0">
                    @if (DataSource.Type == DataSourceType.EdFiApi || DataSource.Type == DataSourceType.CedsDw || DataSource.Type == DataSourceType.Custom || DataSource.Type == DataSourceType.EcsExcel)
                    {
                        <button class="btn btn-primary gap-2" @onclick="OnRunAssessment">
                            <i class="fas fa-play"></i>
                            Run New Assessment
                        </button>
                    }
                </div>
            </div>
        </div>
    </ChildContent>
</Card>

@code {
    [Parameter, EditorRequired] public DataSource DataSource { get; set; } = null!;
    [Parameter] public int AssessmentCount { get; set; }
    [Parameter] public EventCallback<(string name, string? description)> OnSave { get; set; }
    [Parameter] public EventCallback OnRunAssessment { get; set; }

    private async Task HandleNameSave(string? name)
    {
        if (!string.IsNullOrWhiteSpace(name))
        {
            await OnSave.InvokeAsync((name, DataSource.Description));
        }
    }

    private async Task HandleDescriptionSave(string? description)
    {
        await OnSave.InvokeAsync((DataSource.Name, description));
    }
}
