@using EwFrameworkAnalysis.Common.FrameworkReferenceData
@using EwFrameworkAnalysis.Common.Models.Framework
@using EwFrameworkAnalysis.Common.Models.Project
@using EwFrameworkAnalysis.UI.Components
@inject IJSRuntime JSRuntime

<div class="flex flex-col h-full">
    <!-- Fixed Filter / Control Area -->
    <div class="sticky bg-white top-0 flex-shrink-0 pb-2 @(ShowFilterPadding ? "p-4" : "p-0 pt-0")">

        <!-- Row 1: Search + Options toggle + Expand -->
        <div class="flex items-center gap-2">
            <label class="input input-bordered input-sm flex items-center gap-2 flex-1">
                <i class="fas fa-search opacity-50"></i>
                <input type="search"
                       placeholder="Search data elements..."
                       class="grow"
                       @bind="_searchQuery"
                       @bind:event="oninput" />
            </label>

            <button class="btn btn-sm btn-ghost gap-1 @(_showOptions ? "btn-active" : "")"
                    @onclick="() => _showOptions = !_showOptions"
                    aria-expanded="@_showOptions"
                    aria-label="Toggle options">
                <i class="fas fa-sliders-h"></i>
                <span>Options</span>
                @if (HasAnyFilters())
                {
                    <span class="badge badge-primary badge-xs">@GetActiveFilterCount()</span>
                }
            </button>

            <ExpandCollapseAllToggle IsExpanded="@_allExpanded"
                                     IsExpandedChanged="OnAllExpandedChanged" />
        </div>

        <!-- Row 2: Sliding options panel -->
        @* overflow-hidden is only needed to hide/animate the collapsed (max-h-0) state; once
           expanded it must switch to visible or the FilterDropdown popups get clipped at this
           box's bottom edge instead of floating over the element list below. *@
        <div class="transition-all duration-200 ease-in-out @(_showOptions ? "max-h-64 opacity-100 mt-2 overflow-visible" : "max-h-0 opacity-0 overflow-hidden")">
            <div class="flex flex-wrap gap-x-6 gap-y-3 pt-2 pb-1 border-t border-gray-200">

                <!-- Group By -->
                <div class="flex flex-col gap-1">
                    <span class="text-xs font-semibold text-gray-600">Group By</span>
                    <div class="flex items-center gap-1 border border-gray-200 rounded-lg px-2 py-1 bg-base-100">
                        <i class="fas fa-layer-group text-xs text-gray-400"></i>
                        <input type="radio"
                               name="category-view"
                               class="btn btn-xs btn-ghost hover:bg-transparent @(_categoryMode == CategoryMode.EWFramework ? "font-bold underline" : "opacity-50")"
                               aria-label="E-W Clusters"
                               checked="@(_categoryMode == CategoryMode.EWFramework)"
                               @onchange="async () => await SetCategoryMode(CategoryMode.EWFramework)" />
                        <input type="radio"
                               name="category-view"
                               class="btn btn-xs btn-ghost hover:bg-transparent @(_categoryMode == CategoryMode.DataElement ? "font-bold underline" : "opacity-50")"
                               aria-label="Data Categories"
                               checked="@(_categoryMode == CategoryMode.DataElement)"
                               @onchange="async () => await SetCategoryMode(CategoryMode.DataElement)" />
                    </div>
                </div>

                <!-- Sector / Cluster / Domain / Type / Availability filters -->
                <div class="flex flex-col gap-1">
                    <span class="text-xs font-semibold text-gray-600">Filter By</span>
                    <div class="flex flex-wrap items-center gap-1">
                        <FilterDropdown TValue="Sector" Label="Sector" Options="Enum.GetValues<Sector>()"
                                        SelectedValues="_selectedSectors" OnChanged="StateHasChanged"
                                        Description="The sector(s) this element itself is tagged with." />
                        <FilterDropdown TValue="IndicatorCluster" Label="Cluster" Options="Enum.GetValues<IndicatorCluster>()"
                                        SelectedValues="_selectedClusters" OnChanged="StateHasChanged"
                                        Description="Clusters of the indicators that use this element — a property of those indicators, not the element itself." />
                        <FilterDropdown TValue="IndicatorDomain" Label="Domain" Options="Enum.GetValues<IndicatorDomain>()"
                                        SelectedValues="_selectedDomains" OnChanged="StateHasChanged"
                                        Description="Domains of the indicators that use this element — a property of those indicators, not the element itself." />
                        <FilterDropdown TValue="IndicatorType" Label="Type" Options="Enum.GetValues<IndicatorType>()"
                                        SelectedValues="_selectedTypes" OnChanged="StateHasChanged"
                                        Description="Types of the indicators that use this element — a property of those indicators, not the element itself." />
                        <FilterDropdown TValue="AvailabilityJudgment" Label="Availability Status" Options="_availabilityOptions"
                                        SelectedValues="_selectedAvailabilities" OnChanged="StateHasChanged"
                                        ExtraCount="@(_showUnreported ? 1 : 0)" OnClearExtra="@(() => _showUnreported = false)"
                                        Description="The availability judgment recorded for this element in this data source, if any.">
                            <ExtraContent>
                                @if (!HideUnreported)
                                {
                                    <label class="flex items-center gap-2 py-1 px-1 rounded hover:bg-base-200 cursor-pointer w-full">
                                        <input type="checkbox" class="checkbox checkbox-xs shrink-0"
                                               checked="@_showUnreported"
                                               @onchange="() => _showUnreported = !_showUnreported" />
                                        <span class="text-sm whitespace-normal break-words">Not Yet Reported</span>
                                    </label>
                                }
                            </ExtraContent>
                        </FilterDropdown>

                        @if (HasAnyFilters())
                        {
                            <button class="btn btn-xs btn-ghost gap-1" type="button" @onclick="ResetAllFilters">
                                <i class="fas fa-times"></i>
                                Reset all filters
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scrollable Data Element Categories -->
    <div class="flex-1 overflow-y-auto mt-2 rounded-lg border-1 border-gray-300 shadow-inner">
        <div class="bg-white divide-y divide-gray-200 @ContainerClass">
            @foreach (var category in GetFilteredCategories())
            {
                <div class="border-b border-gray-200 last:border-b-0">
                    <!-- Category Header -->
                    <div class="flex items-center gap-2 p-3 bg-base-100 hover:bg-base-200 cursor-pointer"
                         @onclick="() => ToggleCategoryExpanded(category.Name)">
                        <i class="fas @(IsCategoryExpanded(category.Name) ? "fa-chevron-down" : "fa-chevron-right") text-xs text-gray-500"></i>

                        <div class="flex-1 flex items-center gap-2 flex-wrap">
                            <i class="fas @category.Icon text-blue"></i>
                            <span class="font-semibold text-blue">@category.Name</span>
                            <span class="text-xs text-gray-500">
                                (@GetCategoryReportedCount(category) of @category.Elements.Count elements reported)
                            </span>
                        </div>

                        @if (IsEditable)
                        {
                            <div class="flex gap-1" @onclick:stopPropagation="true">
                                @foreach (var judgment in _availabilityOptions)
                                {
                                    <button class="btn btn-xs @GetCategoryButtonClass(category, judgment)"
                                            @onclick="() => SetCategoryAvailability(category, judgment)"
                                            title="@judgment.GetDisplayName()">
                                        @GetAvailabilityIcon(judgment)
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    <!-- Collapsible Elements -->
                    @if (IsCategoryExpanded(category.Name))
                    {
                        <div class="bg-gray-100">
                            @foreach (var element in category.Elements)
                            {
                                <div class="flex items-center gap-2 p-3 pl-10 border-t border-gray-200 hover:bg-gray-200">
                                    <div class="flex-1">
                                        <div class="font-medium text-sm text-gray-800 @(element.AdditionalNotes != null ? "cursor-help" : "")"
                                             title="@element.AdditionalNotes">
                                            @element.Name
                                            @if (!string.IsNullOrWhiteSpace(element.AdditionalNotes))
                                            {
                                                <i class="fas fa-info-circle text-xs text-gray-400 ml-1"></i>
                                            }
                                            @{ var usedByIndicators = IndicatorsUsingElement(element.Name); }
                                            @if (usedByIndicators.Count > 0)
                                            {
                                                <i class="fas fa-diagram-project text-xs text-gray-400 ml-1 cursor-help"
                                                   title="@("Used by " + usedByIndicators.Count + " indicator(s): " + string.Join(", ", usedByIndicators))"></i>
                                            }
                                        </div>
                                    </div>

                                    @if (IsEditable)
                                    {
                                        <div class="flex gap-1">
                                            @foreach (var judgment in _availabilityOptions)
                                            {
                                                <button class="btn btn-xs @GetElementButtonClass(element, judgment)"
                                                        @onclick="() => SetElementAvailability(element, judgment)"
                                                        title="@judgment.GetDisplayName()">
                                                    @GetAvailabilityIcon(judgment)
                                                </button>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        @if (ElementAvailability.TryGetValue(element.Name, out var availability))
                                        {
                                            <div class="badge @GetAvailabilityBadgeClass(availability) badge-sm"
                                                 title="@availability.GetDisplayName()">
                                                @GetAvailabilityIcon(availability) @availability.GetDisplayName()
                                            </div>
                                        }
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            @if (!GetFilteredCategories().Any())
            {
                <div class="p-8 text-center text-gray-500">
                    <i class="fas fa-search text-3xl mb-2"></i>
                    <div>No data elements match your filters</div>
                </div>
            }
        </div>
    </div>
</div>


@code {
    [Parameter] public Dictionary<string, AvailabilityJudgment> ElementAvailability { get; set; } = new();
    [Parameter] public EventCallback<Dictionary<string, AvailabilityJudgment>> ElementAvailabilityChanged { get; set; }
    [Parameter] public bool IsEditable { get; set; } = false;
    [Parameter] public bool HideUnreported { get; set; } = false;
    [Parameter] public string ContainerClass { get; set; } = "";
    [Parameter] public bool ShowFilterPadding { get; set; } = true;

    private string _searchQuery = string.Empty;
    private HashSet<string> _expandedCategories = new();
    private HashSet<Sector> _selectedSectors = new();
    private HashSet<IndicatorCluster> _selectedClusters = new();
    private HashSet<IndicatorDomain> _selectedDomains = new();
    private HashSet<IndicatorType> _selectedTypes = new();
    private HashSet<AvailabilityJudgment> _selectedAvailabilities = new();
    private bool _showUnreported = false;
    private bool _allExpanded = false;
    private bool _showOptions = false;
    private CategoryMode _categoryMode = CategoryMode.EWFramework;
    private const string CATEGORY_MODE_STORAGE_KEY = "ewframework_analysis_category_preference";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var savedMode = await JSRuntime.InvokeAsync<string>("localStorage.getItem", CATEGORY_MODE_STORAGE_KEY);
            if (!string.IsNullOrEmpty(savedMode) && Enum.TryParse<CategoryMode>(savedMode, out var mode))
                _categoryMode = mode;
        }
        catch { }

        BuildCategories();
    }

    private enum CategoryMode
    {
        EWFramework,
        DataElement
    }

    private async Task SetCategoryMode(CategoryMode mode)
    {
        _categoryMode = mode;
        _expandedCategories.Clear();
        _allExpanded = false;
        BuildCategories();
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", CATEGORY_MODE_STORAGE_KEY, mode.ToString());
    }

    private void OnAllExpandedChanged(bool expanded)
    {
        _allExpanded = expanded;
        _expandedCategories = expanded
            ? _categories.Select(c => c.Name).ToHashSet()
            : new HashSet<string>();
    }

    private readonly List<AvailabilityJudgment> _availabilityOptions = new()
    {
        AvailabilityJudgment.Available,
        AvailabilityJudgment.PartiallyAvailable,
        AvailabilityJudgment.NotAvailable
    };

    private readonly Dictionary<string, string> _categoryIcons = new()
    {
        // E-W Framework Clusters (transitive from Indicator.Cluster)
        ["Kindergarten Readiness"] = "fa-seedling",
        ["Postsecondary Success"] = "fa-graduation-cap",
        ["Postsecondary Transitions"] = "fa-route",
        ["School Climate"] = "fa-school",
        ["Social-Emotional Learning"] = "fa-smile",
        ["Teaching Effectiveness"] = "fa-chalkboard-teacher",
        ["Workforce Success"] = "fa-briefcase",
        ["Workforce Transitions"] = "fa-exchange-alt",
        ["Unclustered"] = "fa-question-circle",
        // Data Element Categories
        ["Academic Coursework"] = "fa-book",
        ["Academic Performance"] = "fa-chart-line",
        ["Assessments"] = "fa-clipboard-check",
        ["Attendance & Enrollment"] = "fa-user-check",
        ["Career & Technical Education (CTE)"] = "fa-tools",
        ["Community Context"] = "fa-users",
        ["Demographics"] = "fa-chart-pie",
        ["Discipline & Behavior"] = "fa-gavel",
        ["Early Learning"] = "fa-seedling",
        ["Employment & Earnings"] = "fa-briefcase",
        ["Finance & Resources"] = "fa-coins",
        ["Financial Aid & Affordability"] = "fa-hand-holding-usd",
        ["Health & Wellness"] = "fa-heartbeat",
        ["Postsecondary Outcomes"] = "fa-graduation-cap",
        ["School Climate"] = "fa-school",
        ["Social-Emotional Learning (SEL)"] = "fa-smile",
        ["Staff & Educators"] = "fa-chalkboard-teacher",
        ["Transportation"] = "fa-bus",
    };

    private List<DataElementCategory> _categories = new();

    private const string UnclusteredLabel = "Unclustered";

    private void BuildCategories()
    {
        // Cluster mode is a many-to-many fan-out: an element with no clustered indicators
        // yet lands in "Unclustered"; an element spanning clusters appears under each one.
        IEnumerable<(string Name, DataElement Element)> pairs = _categoryMode == CategoryMode.EWFramework
            ? EwFrameworkDataElements.Elements.Values.SelectMany(e => e.RelatedIndicatorClusters.Count > 0
                ? e.RelatedIndicatorClusters.Select(c => (c.GetDisplayName(), e))
                : [(UnclusteredLabel, e)])
            : EwFrameworkDataElements.Elements.Values.Select(e => (e.DataElementCategory, e));

        _categories = pairs
            .GroupBy(p => p.Name)
            .Select(g => new DataElementCategory
            {
                Name = g.Key,
                Icon = _categoryIcons.GetValueOrDefault(g.Key, "fa-folder"),
                Elements = g.Select(p => p.Element).ToList()
            })
            .OrderBy(c => c.Name)
            .ToList();
    }

    private void ToggleSector(Sector sector)
    {
        if (_selectedSectors.Contains(sector)) _selectedSectors.Remove(sector);
        else _selectedSectors.Add(sector);
    }

    private void ClearSectorFilter() => _selectedSectors.Clear();

    private void ToggleCluster(IndicatorCluster cluster)
    {
        if (_selectedClusters.Contains(cluster)) _selectedClusters.Remove(cluster);
        else _selectedClusters.Add(cluster);
    }

    private void ClearClusterFilter() => _selectedClusters.Clear();

    private void ToggleDomain(IndicatorDomain domain)
    {
        if (_selectedDomains.Contains(domain)) _selectedDomains.Remove(domain);
        else _selectedDomains.Add(domain);
    }

    private void ClearDomainFilter() => _selectedDomains.Clear();

    private void ToggleType(IndicatorType type)
    {
        if (_selectedTypes.Contains(type)) _selectedTypes.Remove(type);
        else _selectedTypes.Add(type);
    }

    private void ClearTypeFilter() => _selectedTypes.Clear();

    private List<string> IndicatorsUsingElement(string elementName) =>
        EwFrameworkIndicators.Indicators.Values
            .Where(i => i.DataElementNames.Contains(elementName))
            .Select(i => i.Name)
            .OrderBy(n => n)
            .ToList();

    private void ToggleAvailability(AvailabilityJudgment availability)
    {
        if (_selectedAvailabilities.Contains(availability)) _selectedAvailabilities.Remove(availability);
        else _selectedAvailabilities.Add(availability);
    }

    private void ClearAvailabilityFilter()
    {
        _selectedAvailabilities.Clear();
        _showUnreported = false;
    }

    private bool HasAvailabilityFilters() => _selectedAvailabilities.Any() || _showUnreported;

    private bool HasAnyFilters() =>
        _selectedSectors.Any() || _selectedClusters.Any() || _selectedDomains.Any() || _selectedTypes.Any() || HasAvailabilityFilters();

    private int GetActiveFilterCount() =>
        _selectedSectors.Count + _selectedClusters.Count + _selectedDomains.Count + _selectedTypes.Count
        + _selectedAvailabilities.Count + (_showUnreported ? 1 : 0);

    private void ResetAllFilters()
    {
        _selectedSectors.Clear();
        _selectedClusters.Clear();
        _selectedDomains.Clear();
        _selectedTypes.Clear();
        _selectedAvailabilities.Clear();
        _showUnreported = false;
    }

    private List<DataElementCategory> GetFilteredCategories()
    {
        var categories = _categories.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            var query = _searchQuery.ToLowerInvariant();
            categories = categories
                .Select(c => new DataElementCategory
                {
                    Name = c.Name,
                    Icon = c.Icon,
                    Elements = c.Elements
                        .Where(e => e.Name.ToLowerInvariant().Contains(query) ||
                            (e.AdditionalNotes?.ToLowerInvariant().Contains(query) ?? false))
                        .ToList()
                })
                .Where(c => c.Elements.Any() || c.Name.ToLowerInvariant().Contains(query));
        }

        if (_selectedSectors.Any())
        {
            categories = categories
                .Select(c => new DataElementCategory
                {
                    Name = c.Name,
                    Icon = c.Icon,
                    Elements = c.Elements
                        .Where(e => e.RelatedSectors.Any(s => _selectedSectors.Contains(s)))
                        .ToList()
                })
                .Where(c => c.Elements.Any());
        }

        if (_selectedClusters.Any())
        {
            categories = categories
                .Select(c => new DataElementCategory
                {
                    Name = c.Name,
                    Icon = c.Icon,
                    Elements = c.Elements
                        .Where(e => e.RelatedIndicatorClusters.Any(x => _selectedClusters.Contains(x)))
                        .ToList()
                })
                .Where(c => c.Elements.Any());
        }

        if (_selectedDomains.Any())
        {
            categories = categories
                .Select(c => new DataElementCategory
                {
                    Name = c.Name,
                    Icon = c.Icon,
                    Elements = c.Elements
                        .Where(e => e.RelatedIndicatorDomains.Any(x => _selectedDomains.Contains(x)))
                        .ToList()
                })
                .Where(c => c.Elements.Any());
        }

        if (_selectedTypes.Any())
        {
            categories = categories
                .Select(c => new DataElementCategory
                {
                    Name = c.Name,
                    Icon = c.Icon,
                    Elements = c.Elements
                        .Where(e => e.RelatedIndicatorTypes.Any(x => _selectedTypes.Contains(x)))
                        .ToList()
                })
                .Where(c => c.Elements.Any());
        }

        if (_selectedAvailabilities.Any() || _showUnreported)
        {
            categories = categories
                .Select(c => new DataElementCategory
                {
                    Name = c.Name,
                    Icon = c.Icon,
                    Elements = c.Elements
                        .Where(e =>
                        {
                            var hasAvailability = ElementAvailability.TryGetValue(e.Name, out var availability);
                            if (!hasAvailability) return _showUnreported;
                            return _selectedAvailabilities.Contains(availability);
                        })
                        .ToList()
                })
                .Where(c => c.Elements.Any());
        }

        if (HideUnreported)
        {
            categories = categories
                .Select(c => new DataElementCategory
                {
                    Name = c.Name,
                    Icon = c.Icon,
                    Elements = c.Elements
                        .Where(e => ElementAvailability.ContainsKey(e.Name))
                        .ToList()
                })
                .Where(c => c.Elements.Any());
        }

        return categories.ToList();
    }

    private void ToggleCategoryExpanded(string categoryName)
    {
        if (_expandedCategories.Contains(categoryName)) _expandedCategories.Remove(categoryName);
        else _expandedCategories.Add(categoryName);
    }

    private bool IsCategoryExpanded(string categoryName) => _expandedCategories.Contains(categoryName);

    private void SetCategoryAvailability(DataElementCategory category, AvailabilityJudgment judgment)
    {
        if (!IsEditable) return;
        var allMatch = category.Elements.All(e =>
            ElementAvailability.TryGetValue(e.Name, out var val) && val == judgment);
        if (allMatch)
            foreach (var element in category.Elements) ElementAvailability.Remove(element.Name);
        else
            foreach (var element in category.Elements) ElementAvailability[element.Name] = judgment;
        ElementAvailabilityChanged.InvokeAsync(ElementAvailability);
    }

    private void SetElementAvailability(DataElement element, AvailabilityJudgment judgment)
    {
        if (!IsEditable) return;
        if (ElementAvailability.TryGetValue(element.Name, out var current) && current == judgment)
            ElementAvailability.Remove(element.Name);
        else
            ElementAvailability[element.Name] = judgment;
        ElementAvailabilityChanged.InvokeAsync(ElementAvailability);
    }

    private string GetCategoryButtonClass(DataElementCategory category, AvailabilityJudgment judgment)
    {
        var allMatch = category.Elements.All(e =>
            ElementAvailability.TryGetValue(e.Name, out var val) && val == judgment);
        var baseClass = judgment switch
        {
            AvailabilityJudgment.Available => "btn-success",
            AvailabilityJudgment.PartiallyAvailable => "btn-warning",
            AvailabilityJudgment.NotAvailable => "btn-error",
            _ => "btn-ghost"
        };
        return allMatch ? baseClass : "btn-ghost btn-outline";
    }

    private string GetElementButtonClass(DataElement element, AvailabilityJudgment judgment)
    {
        var isSelected = ElementAvailability.TryGetValue(element.Name, out var current) && current == judgment;
        return judgment switch
        {
            AvailabilityJudgment.Available => isSelected ? "btn-success" : "btn-ghost btn-outline",
            AvailabilityJudgment.PartiallyAvailable => isSelected ? "btn-warning" : "btn-ghost btn-outline",
            AvailabilityJudgment.NotAvailable => isSelected ? "btn-error" : "btn-ghost btn-outline",
            _ => "btn-ghost"
        };
    }

    private string GetAvailabilityBadgeClass(AvailabilityJudgment judgment) => judgment switch
    {
        AvailabilityJudgment.Available => "badge-success",
        AvailabilityJudgment.PartiallyAvailable => "badge-warning",
        AvailabilityJudgment.NotAvailable => "badge-error",
        _ => "badge-ghost"
    };

    private string GetAvailabilityIcon(AvailabilityJudgment judgment) => judgment switch
    {
        AvailabilityJudgment.Available => "✓",
        AvailabilityJudgment.PartiallyAvailable => "◐",
        AvailabilityJudgment.NotAvailable => "✗",
        _ => "?"
    };

    private int GetCategoryReportedCount(DataElementCategory category) =>
        category.Elements.Count(e => ElementAvailability.ContainsKey(e.Name));

    private class DataElementCategory
    {
        public string Name { get; set; } = "";
        public string Icon { get; set; } = "";
        public List<DataElement> Elements { get; set; } = new();
    }
}
