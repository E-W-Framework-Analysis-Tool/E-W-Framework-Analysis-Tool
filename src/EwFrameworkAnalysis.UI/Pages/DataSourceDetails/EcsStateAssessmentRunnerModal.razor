@using EwFrameworkAnalysis.UI.Components
@using EwFrameworkAnalysis.Common.Models.Project
@using EwFrameworkAnalysis.Common.Services
@inject EcsStateDataParser Parser
@inject EcsStateDataProvider StateDataProvider

@if (IsOpen)
{
    <div class="modal modal-open">
        <div class="modal-box max-h-5/6 @(_assessmentResult != null ? "min-w-3/4" : "") pb-0">
            <h3 class="font-bold text-lg mb-4">ECS State Data</h3>

            @if (_assessmentResult == null)
            {
                <!-- Step 1: Select State & Column -->
                <div class="space-y-4">
                    <p class="text-sm">
                        Select your state and a data column to import state-level data readiness 
                        as researched by Education Commission of the States.
                    </p>

                    <div class="form-control">
                        <label class="label">
                            <span class="label-text">Select State</span>
                        </label>
                        <select class="select select-bordered w-full" @bind="_selectedState">
                            <option value="">-- Select a state --</option>
                            @foreach (var state in _availableStates)
                            {
                                <option value="@state">@state</option>
                            }
                        </select>
                    </div>

                    <div class="form-control">
                        <label class="label">
                            <span class="label-text">Data Column</span>
                        </label>
                        <div class="space-y-4 space-x-4">
                            <label class="label cursor-pointer justify-start gap-3">
                                <input type="radio" name="dataColumn" class="radio radio-primary"
                                       checked="@(_selectedDataColumn == EcsDataColumn.Collected && !_importBoth)"
                                       @onchange="@(() => { _selectedDataColumn = EcsDataColumn.Collected; _importBoth = false; })" />
                                <div>
                                    <span class="label-text font-medium">Collected</span>
                                    <span class="label-text text-xs text-gray block">Data collected by the state</span>
                                </div>
                            </label>
                            <label class="label cursor-pointer justify-start gap-3">
                                <input type="radio" name="dataColumn" class="radio radio-primary"
                                       checked="@(_selectedDataColumn == EcsDataColumn.Reported && !_importBoth)"
                                       @onchange="@(() => { _selectedDataColumn = EcsDataColumn.Reported; _importBoth = false; })" />
                                <div>
                                    <span class="label-text font-medium">Reported</span>
                                    <span class="label-text text-xs text-gray block">Data reported publicly by the state</span>
                                </div>
                            </label>
                            <label class="label cursor-pointer justify-start gap-3">
                                <input type="radio" name="dataColumn" class="radio radio-primary"
                                       checked="@_importBoth"
                                       @onchange="@(() => _importBoth = true)" />
                                <div>
                                    <span class="label-text font-medium">Both</span>
                                    <span class="label-text text-xs text-gray block">Create two assessments, one for each column</span>
                                </div>
                            </label>
                        </div>
                    </div>

                    @if (_error != null)
                    {
                        <div class="alert alert-error">
                            <i class="fas fa-exclamation-circle"></i>
                            <span>@_error</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- Step 2: Review Results -->
                <div class="space-y-4">
                    <div class="text-sm text-gray">
                        <span class="font-semibold text-blue">@_selectedState</span>
                        &mdash;
                        @(_importBoth ? "Collected & Reported" : _selectedDataColumn.ToString())
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="bg-white border border-gray-200 rounded-lg p-4 shadow">
                            <h3 class="text-sm text-gray mb-2">Data Elements Mapped</h3>
                            <div class="text-3xl font-bold text-blue">@_assessmentResult!.DataElementAssessments.Count</div>
                        </div>
                        <div class="bg-white border border-gray-200 rounded-lg p-4 shadow">
                            <h3 class="text-sm text-gray mb-2">Rows Processed</h3>
                            <div class="text-3xl font-bold text-blue">@_parsingStats!.DataElementsProcessed</div>
                        </div>
                        <div class="bg-white border border-gray-200 rounded-lg p-4 shadow">
                            <h3 class="text-sm text-gray mb-2">Rows Skipped</h3>
                            <div class="text-3xl font-bold @(_parsingStats!.DataElementsSkipped > 0 ? "text-warning" : "text-blue")">@_parsingStats.DataElementsSkipped</div>
                        </div>
                    </div>

                    @if (_parsingStats.HasWarnings)
                    {
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle"></i>
                            <div class="flex-1">
                                <h3 class="font-bold">Some Data Could Not Be Mapped</h3>
                                <div class="text-sm">
                                    @if (_parsingStats.DataElementsSkipped > 0)
                                    {
                                        <p>@_parsingStats.DataElementsSkipped row(s) were skipped due to missing data.</p>
                                    }
                                    <button class="link link-primary text-xs mt-1" @onclick="() => _showDetails = !_showDetails">
                                        @(_showDetails ? "Hide" : "Show") details
                                    </button>
                                </div>
                            </div>
                        </div>

                        @if (_showDetails)
                        {
                            <div class="bg-base-200 rounded-lg p-4 space-y-2">
                                <h4 class="font-semibold text-sm">Parsing Details</h4>
                                <div class="text-xs space-y-1">
                                    <div class="flex justify-between">
                                        <span>Total data element rows:</span>
                                        <span class="font-mono">@_parsingStats.TotalRowsRead</span>
                                    </div>
                                    <div class="flex justify-between">
                                        <span>Processed:</span>
                                        <span class="font-mono">@_parsingStats.DataElementsProcessed</span>
                                    </div>
                                    <div class="flex justify-between">
                                        <span>Skipped:</span>
                                        <span class="font-mono">@_parsingStats.DataElementsSkipped</span>
                                    </div>
                                </div>

                                @if (_parsingStats.SkippedReasons.Count > 0)
                                {
                                    <div class="mt-3">
                                        <h5 class="font-semibold text-xs mb-1">Skip Reasons:</h5>
                                        <ul class="text-xs space-y-1 list-disc list-inside max-h-48 overflow-y-auto">
                                            @foreach (var reason in _parsingStats.SkippedReasons)
                                            {
                                                <li>@reason</li>
                                            }
                                        </ul>
                                    </div>
                                }
                            </div>
                        }
                    }

                    <div class="bg-white border border-gray-200 rounded-lg shadow">
                        <div class="px-4 py-3 border-b border-gray-200">
                            <h3 class="font-semibold text-blue">Assessment Results Preview</h3>
                        </div>
                        <div class="p-4 space-y-2 max-h-96 overflow-y-auto">
                            @foreach (var element in _assessmentResult.DataElementAssessments.OrderBy(e => e.DataElementName))
                            {
                                var availability = element.Characteristics.OfType<ReportedAvailability>().FirstOrDefault();
                                var badgeClass = availability?.Value switch
                                {
                                    AvailabilityJudgment.Available => "badge-success",
                                    AvailabilityJudgment.PartiallyAvailable => "badge-warning",
                                    AvailabilityJudgment.NotAvailable => "badge-error",
                                    _ => "badge-ghost"
                                };
                                var borderColor = availability?.Value switch
                                {
                                    AvailabilityJudgment.Available => Card.BorderColor.Green,
                                    AvailabilityJudgment.PartiallyAvailable => Card.BorderColor.Yellow,
                                    _ => Card.BorderColor.Red
                                };
                                var bgColor = availability?.Value switch
                                {
                                    AvailabilityJudgment.Available => Card.BackgroundColor.Green,
                                    AvailabilityJudgment.PartiallyAvailable => Card.BackgroundColor.Yellow,
                                    _ => Card.BackgroundColor.Red
                                };
                                <Card Background="@bgColor"
                                      Border="new Card.BorderStyle(borderColor, Card.BorderPosition.Left)"
                                      Shadow="Card.ShadowSize.None">
                                    <div class="flex items-center gap-2">
                                        <span class="font-semibold text-sm text-blue">@element.DataElementName</span>
                                        <span class="badge badge-sm @badgeClass">@availability?.Value</span>
                                    </div>
                                </Card>
                            }
                        </div>
                    </div>

                    <div class="alert alert-success">
                        <i class="fas fa-check-circle"></i>
                        <div>
                            <h3 class="font-bold">Assessment Processed Successfully</h3>
                            <div class="text-sm">Review the results above and save to add to your project</div>
                        </div>
                    </div>
                </div>
            }

            <div class="modal-action sticky bottom-0 bg-base-100 py-6 px-2">
                @if (_assessmentResult == null)
                {
                    <button class="btn btn-ghost" @onclick="Close">Cancel</button>
                    <button class="btn btn-primary"
                            @onclick="RunAssessment"
                            disabled="@(string.IsNullOrEmpty(_selectedState) || _isProcessing)">
                        @if (_isProcessing)
                        {
                            <span class="loading loading-spinner loading-sm"></span>
                            <span>Processing...</span>
                        }
                        else
                        {
                            <i class="fas fa-cogs mr-2"></i>
                            <span>Run Assessment</span>
                        }
                    </button>
                }
                else
                {
                    <button class="btn btn-ghost" @onclick="ShowDiscardConfirmation">
                        <i class="fas fa-times mr-2"></i>Discard Results
                    </button>
                    <button class="btn btn-primary" @onclick="SaveResults">
                        <i class="fas fa-save mr-2"></i>Save Results
                    </button>
                }
            </div>
        </div>
    </div>
}

<!-- Discard Confirmation Modal -->
@if (_showDiscardModal)
{
    <div class="modal modal-open" style="z-index: 1001;">
        <div class="modal-box">
            <h3 class="font-bold text-lg text-blue font-title">Discard Assessment Results?</h3>
            <p class="py-4 text-gray">
                Are you sure you want to discard these assessment results? This action cannot be undone.
            </p>
            <div class="modal-action">
                <button class="btn btn-ghost" @onclick="CancelDiscard">Keep Results</button>
                <button class="btn btn-error" @onclick="ConfirmDiscard">
                    <i class="fas fa-trash mr-2"></i>
                    Discard Results
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter, EditorRequired] public required DataSource DataSource { get; set; }
    [Parameter] public EventCallback<DataSourceAssessment> OnAssessmentComplete { get; set; }

    private DataSourceAssessment? _assessmentResult;
    private DataSourceAssessment? _secondAssessmentResult;
    private EcsParsingStats? _parsingStats;
    private string? _error;
    private bool _isProcessing;
    private bool _showDiscardModal;
    private bool _showDetails;

    private List<string> _availableStates = [];
    private string _selectedState = "";
    private EcsDataColumn _selectedDataColumn = EcsDataColumn.Collected;
    private bool _importBoth;

    protected override void OnInitialized()
    {
        _availableStates = StateDataProvider.GetAvailableStates();
    }

    private async Task RunAssessment()
    {
        if (string.IsNullOrEmpty(_selectedState)) return;

        _error = null;
        _isProcessing = true;
        StateHasChanged();
        await Task.Delay(1);

        try
        {
            var records = StateDataProvider.GetStateData(_selectedState);

            if (_importBoth)
            {
                var (assessment1, stats1) = Parser.ProcessStateData(records, EcsDataColumn.Collected);
                assessment1.Name = $"{_selectedState} - Collected";
                assessment1.ConductedAt = DateTimeOffset.Now;

                var (assessment2, _) = Parser.ProcessStateData(records, EcsDataColumn.Reported);
                assessment2.Name = $"{_selectedState} - Reported";
                assessment2.ConductedAt = DateTimeOffset.Now;

                _assessmentResult = assessment1;
                _secondAssessmentResult = assessment2;
                _parsingStats = stats1;
            }
            else
            {
                var (assessment, stats) = Parser.ProcessStateData(records, _selectedDataColumn);
                assessment.Name = $"{_selectedState} - {_selectedDataColumn}";
                assessment.ConductedAt = DateTimeOffset.Now;

                _assessmentResult = assessment;
                _parsingStats = stats;
            }
        }
        catch (Exception ex)
        {
            _error = $"Failed to process data: {ex.Message}";
            _assessmentResult = null;
            _parsingStats = null;
        }
        finally
        {
            _isProcessing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SaveResults()
    {
        if (_assessmentResult == null) return;

        await OnAssessmentComplete.InvokeAsync(_assessmentResult);

        if (_secondAssessmentResult != null)
        {
            await OnAssessmentComplete.InvokeAsync(_secondAssessmentResult);
        }

        await Close();
    }

    private void ShowDiscardConfirmation()
    {
        _showDiscardModal = true;
    }

    private void CancelDiscard()
    {
        _showDiscardModal = false;
    }

    private async Task ConfirmDiscard()
    {
        _showDiscardModal = false;
        _assessmentResult = null;
        _secondAssessmentResult = null;
        _parsingStats = null;
        await Close();
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(IsOpen);

        _assessmentResult = null;
        _secondAssessmentResult = null;
        _parsingStats = null;
        _error = null;
        _isProcessing = false;
        _selectedState = "";
        _showDetails = false;
        _importBoth = false;
    }
}
