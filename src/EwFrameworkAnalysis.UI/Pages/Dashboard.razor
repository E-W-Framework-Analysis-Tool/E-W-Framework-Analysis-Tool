@page "/dashboard"
@using EwFrameworkAnalysis.UI.Components
@inject AnalysisProjectService ProjectSvc

<div class="container mx-auto max-w-7xl p-4">

    <!-- Project Header -->
    <div class="card rounded-lg shadow-sm mb-4">
        <div class="card-body p-4 flex flex-col flex-col-reverse sm:flex-row justify-between">
            <div>
                <h2 class="card-title font-title text-3xl mb-2">@(ProjectSvc.Project?.Title ?? "Unnamed Project")</h2>
                <p class="text-gray text-sm">Last modified: January 15, 2025 at 2:30 PM</p>
            </div>

            <div class="flex items-center justify-end">
                @if (ProjectSvc.DataSources.Count > 0)
                {
                    <div class="badge border-none bg-accent/20 text-accent font-semibold">
                        <i class="fa-solid fa-circle-check"></i>
                        @ProjectSvc.DataSources.Count Sources Active
                    </div>
                }


                <a onclick="edit_project_modal.showModal()" class="link text-black opacity-50 hover:opacity-80 ml-2">
                    <i class="fa-solid fa-pen-to-square"></i>
                </a>
            </div>

        </div>
    </div>

    <!-- Dashboard Overview -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">

        <!-- Overall Score -->
        <div class="card rounded-lg shadow-sm">
            <div class="card-body p-4 font-semibold">

                <div class="flex">
                    <div class="flex w-12 h-12 bg-primary/20 text-primary rounded-lg justify-center items-center mr-4 text-lg">
                        <i class="fa-solid fa-chart-line"></i>
                    </div>

                    <div>
                        <p class="text-gray-500">Overall Framework Score</p>
                        <p class="text-xl">74%</p>
                    </div>
                </div>

                <progress class="progress progress-primary w-full mt-2" value="74" max="100"></progress>

            </div>
        </div>

        <!-- Data Sources -->
        <div class="card rounded-lg shadow-sm">
            <div class="card-body p-4 font-semibold">

                <div class="flex">
                    <div class="flex w-12 h-12 bg-secondary/20 text-secondary rounded-lg justify-center items-center mr-4 text-lg">
                        <i class="fa-solid fa-database"></i>
                    </div>

                    <div>
                        <p class="text-gray-500">Data Sources</p>
                        <p class="text-xl">4</p>
                    </div>
                </div>

                <p class="text-gray text-sm">2 automated, 2 manual</p>

            </div>
        </div>

        <!-- Last Analysis -->
        <div class="card rounded-lg shadow-sm">
            <div class="card-body p-4 font-semibold">

                <div class="flex">
                    <div class="flex w-12 h-12 bg-accent/20 text-accent rounded-lg justify-center items-center mr-4 text-lg">
                        <i class="fa-solid fa-clock"></i>
                    </div>

                    <div>
                        <p class="text-gray-500">Last Analysis Run</p>
                        <p class="text-xl">2 hours ago</p>
                    </div>
                </div>

                <a class="link link-hover font-semibold">View Details <i class="fa-solid fa-arrow-right"></i></a>

            </div>
        </div>

    </div>

    <!-- Main Content Area -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">

        <!-- Data Sources Panel -->
        <div class="lg:col-span-2">
            <DataSourcesList DataSources="ProjectSvc.DataSources" />
        </div>

        <!-- Sidebar -->
        <div class="space-y-4">
            <EssentialQuestionsSummary />

            <RecentActivity />

            <QuickActions />
        </div>

    </div>

</div>

<dialog id="edit_project_modal" class="modal">
    <div class="modal-box">
        <!-- Header -->
        <div class="pb-2">
            <div class="flex items-start gap-4">
                <div class="flex h-12 w-12 items-center justify-center rounded-full bg-blue/20">
                    <i class="fa-solid fa-file-pen text-blue text-xl"></i>
                </div>
                <div class="flex-1">
                    <h3 class="font-title text-lg font-semibold text-blue">Edit Project</h3>
                    <p class="mt-1 text-sm text-gray">Enter project title:</p>
                </div>
            </div>
        </div>

        <div class="">
            <form method="dialog" class="space-y-4">

                <!-- Name -->
                <fieldset class="fieldset">
                    <legend class="fieldset-legend">Title</legend>
                    <input type="text" class="input w-full" placeholder="Project Title ..." @bind="NewProjectTitle" />
                </fieldset>

            </form>
        </div>


        <div class="modal-action">
            <form method="dialog">
                <!-- if there is a button in form, it will close the modal -->
                <button class="btn btn-gray">Close</button>
                <button class="btn btn-primary" @onclick="HandleEditProject">Save</button>
            </form>
        </div>
    </div>
</dialog>

@code {
    private string NewProjectTitle = "";

    protected override async Task OnInitializedAsync()
    {
        await ProjectSvc.InitializeAsync();
        NewProjectTitle = ProjectSvc.Project?.Title ?? "";
    }

    private async Task HandleEditProject()
    {
        var currentTitle = ProjectSvc.Project.Title;

        if (!string.IsNullOrWhiteSpace(NewProjectTitle) && NewProjectTitle != currentTitle)
        {
            await ProjectSvc.UpdateProjectDetailsAsync(NewProjectTitle);
        }
    }
}
