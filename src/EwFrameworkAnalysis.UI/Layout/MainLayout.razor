@using EwFrameworkAnalysis.UI.Components
@using EwFrameworkAnalysis.UI.Options
@using EwFrameworkAnalysis.UI.Services
@using Microsoft.Extensions.Options
@implements IDisposable
@inherits LayoutComponentBase
@inject BusyService BusySvc
@inject WalkthroughService Walkthrough
@inject IOptions<DeploymentInfoOptions> DeploymentInfoOptions
@inject IOptions<ContactInfoOptions> ContactInfoOptions
@inject IJSRuntime JS
@inject NavigationManager Nav

<CascadingValue Value="_lightbox">
    <div class="min-h-screen flex flex-col">

        <!-- Navbar -->
        <div class="navbar bg-secondary text-secondary-content p-0 flex-col items-stretch">

            <!-- Top bar — always visible -->
            <div class="w-full max-w-7xl mx-auto flex items-center px-2 h-16">

                <!-- Logo / wordmark -->
                <a href="@AppRoutes.Home"
                   class="btn btn-ghost bg-secondary hover:text-primary shadow-none border-none px-2 flex-1 justify-start">
                    <span class="ew-navbar-wordmark">E-W Framework <span>Analysis Tool</span></span>
                </a>

                <!-- Desktop nav (hidden on mobile) -->
                <div class="hidden md:flex">
                    <ul class="menu menu-horizontal px-1 gap-1">
                        <li><a href="@AppRoutes.Dashboard" class="link link-hover">Dashboard</a></li>
                        <li data-walkthrough="@WalkthroughSteps.StepIds.AnalysisNavLink">
                            <a href="@AppRoutes.Analysis" class="link link-hover">Reports &amp; Analysis</a>
                        </li>
                        <li class="dropdown dropdown-end">
                            <div tabindex="0" role="button" class="link link-hover">Learn ▾</div>
                            <ul tabindex="0"
                                class="dropdown-content menu bg-white text-gray-700 rounded-none z-50 w-48 p-2 shadow-xl border border-gray-100">
                                <li>
                                    <button class="link link-hover cursor-pointer" @onclick="HandleTakeATour">
                                        Take a Tour
                                    </button>
                                </li>
                                <li>
                                    <a href="@AppRoutes.Docs" class="link link-hover" @onclick="CloseDropdowns">
                                        Docs
                                    </a>
                                </li>
                                <li>
                                    <a href="@AppRoutes.Faq" class="link link-hover" @onclick="CloseDropdowns">
                                        FAQ
                                    </a>
                                </li>
                                <li>
                                    <a href="@AppRoutes.Visualizations" class="link link-hover" @onclick="CloseDropdowns">
                                        Visualizations
                                    </a>
                                </li>
                                <li>
                                    <a href="@AppRoutes.MappingOverview" class="link link-hover" @onclick="CloseDropdowns">
                                        Mapping Overview
                                    </a>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>

                <!-- Mobile hamburger -->
                <button class="md:hidden btn btn-ghost btn-square"
                        @onclick="() => _mobileMenuOpen = !_mobileMenuOpen"
                        aria-label="Toggle menu">
                    <i class="fas @(_mobileMenuOpen ? "fa-times" : "fa-bars") text-lg"></i>
                </button>
            </div>

            <!-- Mobile menu — animates open/closed -->
            <div class="md:hidden w-full border-t @(_mobileMenuOpen ? "border-white/10" : "border-transparent")
                overflow-hidden transition-all duration-300 ease-in-out
                @(_mobileMenuOpen ? "max-h-96 opacity-100" : "max-h-0 opacity-0")">
                <div class="px-4 py-3 flex flex-col gap-1">
                    <a href="@AppRoutes.Dashboard"
                       class="btn btn-ghost justify-start text-secondary-content"
                       @onclick="CloseMobileMenu">
                        Dashboard
                    </a>
                    <a href="@AppRoutes.Analysis"
                       class="btn btn-ghost justify-start text-secondary-content"
                       @onclick="CloseMobileMenu"
                       data-walkthrough="@WalkthroughSteps.StepIds.AnalysisNavLink">
                        Reports &amp; Analysis
                    </a>
                    <a href="@AppRoutes.Docs"
                       class="btn btn-ghost justify-start text-secondary-content"
                       @onclick="CloseMobileMenu">
                        Docs
                    </a>
                    <a href="@AppRoutes.Faq"
                       class="btn btn-ghost justify-start text-secondary-content"
                       @onclick="CloseMobileMenu">
                        FAQ
                    </a>
                    <a href="@AppRoutes.Visualizations"
                       class="btn btn-ghost justify-start text-secondary-content"
                       @onclick="CloseMobileMenu">
                        Visualizations
                    </a>
                    <a href="@AppRoutes.MappingOverview"
                       class="btn btn-ghost justify-start text-secondary-content"
                       @onclick="CloseMobileMenu">
                        Mapping Overview
                    </a>
                    <button class="btn btn-ghost justify-start text-secondary-content"
                            @onclick="HandleTakeATour">
                        Take a Tour
                    </button>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <main class="flex-1 bg-tan relative">
            @Body
            <EwLoadingOverlay IsLoading="@BusySvc.IsBusy" />
        </main>

        <!-- Deploy info bar (lower environments only) -->
        @if (DeploymentInfoOptions.Value.ShowDetails)
        {
            <div class="bg-secondary/70 text-secondary-content/70 text-xs flex items-center justify-center gap-4 px-4 py-1.5 flex-wrap">
                @if (!string.IsNullOrEmpty(DeploymentInfoOptions.Value.EnvironmentLabel))
                {
                    <span class="badge badge-warning badge-xs">@DeploymentInfoOptions.Value.EnvironmentLabel</span>
                }
                @if (!string.IsNullOrEmpty(DeploymentInfoOptions.Value.Version))
                {
                    <span>Version: @DeploymentInfoOptions.Value.Version</span>
                }
                @if (!string.IsNullOrEmpty(DeploymentInfoOptions.Value.DeployDateTime) &&
                     !DeploymentInfoOptions.Value.DeployDateTime.Equals("NEVER", StringComparison.OrdinalIgnoreCase))
                {
                    <span>Deployed: @DeploymentInfoOptions.Value.DeployDateTime</span>
                }
            </div>
        }

        <!-- Footer -->
        <footer class="bg-secondary text-secondary-content border-t border-base-300 mt-auto">
            <div class="w-full max-w-7xl mx-auto px-6 py-8 flex flex-col items-center gap-4 text-center">
            
                <div class="text-center">
                    <p class="font-semibold">E-W Framework Analysis Tool</p>
                    <p class="font-thin text-sm mt-1 max-w-prose">
                        An open-source tool enabling you to automate your E-W Framework mapping and bridge the gap from data to insight. Free for all to use.
                    </p>
                </div>

                <hr class="w-full border-white/10" />

                @if (!string.IsNullOrWhiteSpace(ContactInfoOptions.Value.SupportEmail))
                {
                    <p class="text-sm">
                        Need help? <a href="mailto:@ContactInfoOptions.Value.SupportEmail"
                                      class="link link-hover">@ContactInfoOptions.Value.SupportEmail</a>
                    </p>
                }

                <p class="text-xs text-secondary-content/70">
                    &copy; 2026 &mdash;
                    <a href="https://wearedoubleline.com"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="link link-hover">Double Line, Inc.</a>
                </p>
            </div>
        </footer>
    </div>

    <WalkthroughOverlay />
    <Lightbox @ref="_lightbox" />
</CascadingValue>

@code {
    private bool _mobileMenuOpen = false;
    private Lightbox _lightbox = default!;

    protected override void OnInitialized()
    {
        BusySvc.Changed += OnBusyChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            StateHasChanged();
    }

    private void OnBusyChanged() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // Close mobile menu on navigation
        _mobileMenuOpen = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        BusySvc.Changed -= OnBusyChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }

    private void CloseMobileMenu() => _mobileMenuOpen = false;

    private async Task CloseDropdowns()
    {
        await JS.InvokeVoidAsync("eval", "document.activeElement.blur()");
    }

    private async Task HandleTakeATour()
    {
        _mobileMenuOpen = false;
        await JS.InvokeVoidAsync("eval", "document.activeElement.blur()");
        await Walkthrough.StartAsync();
    }
}
