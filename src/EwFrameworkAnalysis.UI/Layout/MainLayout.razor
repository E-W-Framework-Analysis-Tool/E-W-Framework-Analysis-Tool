@using EwFrameworkAnalysis.UI.Components
@using EwFrameworkAnalysis.UI.Options
@using EwFrameworkAnalysis.UI.Services
@using Microsoft.Extensions.Configuration
@using Microsoft.Extensions.Options
@implements IDisposable
@inherits LayoutComponentBase
@inject BusyService BusySvc
@inject WalkthroughService Walkthrough
@inject IOptions<DeploymentInfoOptions> DeploymentInfoOptions
@inject IOptions<ContactInfoOptions> ContactInfoOptions
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="min-h-screen flex flex-col">

    <div class="navbar bg-secondary text-secondary-content justify-center p-0">
        <div class="w-full max-w-7xl flex items-center justify-center">
            <div class="flex-1">
                <a href="@AppRoutes.Home" class="btn btn-ghost bg-secondary hover:text-primary shadow-none border-none">
                    <span class="ew-navbar-wordmark">E-W Framework <span>Analysis Tool</span></span>
                </a>
            </div>

            <div class="flex-none">
                <ul class="menu menu-horizontal px-1">
                    <li><a href="@AppRoutes.Dashboard" class="link link-hover">Dashboard</a></li>
                    <li data-walkthrough="@WalkthroughSteps.StepIds.AnalysisNavLink"><a href="@AppRoutes.Analysis" class="link link-hover">Reports & Analysis</a></li>
                    <li class="dropdown dropdown-end">
                        <div tabindex="0" role="button" class="link link-hover" id="learn-dropdown">
                            Learn ▾
                        </div>
                        <ul tabindex="0" class="dropdown-content menu bg-white text-gray-700 rounded-none z-50 w-48 p-2 shadow-xl border border-gray-100">
                            <li>
                                <button class="link link-hover cursor-pointer" @onclick="HandleTakeATour">
                                    Take a Tour
                                </button>
                            </li>
                            <li><a href="@AppRoutes.MappingOverview" class="link link-hover">Mapping Overview</a></li>
                            <li><a href="@AppRoutes.Visualizations" class="link link-hover">Visualizations</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <main class="flex-1 bg-tan relative">
        @Body
        <EwLoadingOverlay IsLoading="@BusySvc.IsBusy" />
    </main>

    <!-- Footer -->
    <footer class="bg-secondary text-secondary-content border-t border-base-300 mt-auto">
        <div class="w-full max-w-7xl mx-auto px-6 py-8 flex flex-col items-center gap-4 text-center">

            <!-- Tagline row — flanked by deploy info when ShowDetails is true -->
            <div class="flex items-center justify-between w-full gap-4 text-sm">

                <!-- Left: Version + Deploy date -->
                @if (DeploymentInfoOptions.Value.ShowDetails)
                {
                    <div class="flex flex-col gap-1 text-left shrink-0">
                        <span>Version: @DeploymentInfoOptions.Value.Version</span>
                        @if (!string.IsNullOrEmpty(DeploymentInfoOptions.Value.DeployDateTime) &&
                                            !DeploymentInfoOptions.Value.DeployDateTime.Equals("NEVER", StringComparison.OrdinalIgnoreCase))
                        {
                            <span>Deployed: @DeploymentInfoOptions.Value.DeployDateTime</span>
                        }
                    </div>
                }
                else
                {
                    <div class="shrink-0 w-0" />
                }

                <!-- Center: Title + description -->
                <div class="text-center">
                    <p class="font-semibold">E-W Framework Analysis Tool</p>
                    <p class="font-thin text-sm mt-1 max-w-prose">
                        An open-source tool enabling you to automate your E-W Framework mapping and bridge the gap from data to insight. Free for all to use.
                    </p>
                </div>

                <!-- Right: Environment badge -->
                @if (DeploymentInfoOptions.Value.ShowDetails)
                {
                    <div class="flex flex-col items-end gap-1 shrink-0">
                        @if (!string.IsNullOrEmpty(DeploymentInfoOptions.Value.EnvironmentLabel))
                        {
                            <span>Environment:</span>
                            <div class="badge badge-accent badge-sm">
                                @DeploymentInfoOptions.Value.EnvironmentLabel
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="shrink-0 w-0" />
                }

            </div>

            <hr class="w-full border-white/10" />

            <!-- Support -->
            @if (!string.IsNullOrWhiteSpace(ContactInfoOptions.Value.SupportEmail))
            {
                <p class="text-sm">
                    Need help? <a href="mailto:@ContactInfoOptions.Value.SupportEmail"
                                  class="link link-hover">@ContactInfoOptions.Value.SupportEmail</a>
                </p>
            }

            <!-- Legal -->
            <p class="text-xs text-secondary-content/70">
                &copy; 2026 E-W Framework Analysis Tool &mdash;
                <span class="whitespace-nowrap">
                    Built by
                    <a href="https://wearedoubleline.com"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="link link-hover">Double Line</a>
                </span>
                with support from the Gates Foundation.
            </p>

        </div>
    </footer>
</div>

<WalkthroughOverlay />

@code {
    // private IDisposable? _navToken;

    protected override void OnInitialized()
    {
        BusySvc.Changed += OnBusyChanged;
    }

    private void OnBusyChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        BusySvc.Changed -= OnBusyChanged;
    }

    private async Task HandleTakeATour()
    {
        await JS.InvokeVoidAsync("eval", "document.activeElement.blur()");
        await Walkthrough.StartAsync();
    }
}
