<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TailwindMinifyFlag>--minify</TailwindMinifyFlag>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' != 'Release'">
    <TailwindMinifyFlag></TailwindMinifyFlag>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Blazor-ApexCharts" Version="6.1.0" />
    <PackageReference Include="Blazored.LocalStorage" Version="4.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.8" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EwFrameworkAnalysis.Common\EwFrameworkAnalysis.Common.csproj" />
  </ItemGroup>

  <Target Name="EnsureNodeModules" BeforeTargets="Build">
    <Message Text="Checking npm setup..." Importance="high" />

    <Error Condition="!Exists('node_modules')" Text="Node modules not found. Run 'npm install' in $(MSBuildProjectDirectory) first." />
    <Error Condition="!Exists('wwwroot/css/input.css')" Text="Missing wwwroot/css/input.css." />

    <!-- Tailwind -->
    <Exec Command="npx @tailwindcss/cli -i ./wwwroot/css/input.css -o ./wwwroot/css/app.css $(TailwindMinifyFlag)"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ContinueOnError="false" />

    <!-- Font Awesome: copy webfonts + CSS -->
    <ItemGroup>
      <FA_CSS Include="node_modules/@fortawesome/fontawesome-free/css/all.min.css" />
      <FA_Webfonts Include="node_modules/@fortawesome/fontawesome-free/webfonts/**/*" />
    </ItemGroup>

    <Copy SourceFiles="@(FA_CSS)" DestinationFolder="wwwroot/css" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(FA_Webfonts)" DestinationFiles="@(FA_Webfonts->'wwwroot/webfonts/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />

    <!-- jsPDF + autotable -->
    <ItemGroup>
      <JsPDF Include="node_modules/jspdf/dist/jspdf.umd.min.js" />
      <JsPDFTable Include="node_modules/jspdf-autotable/dist/jspdf.plugin.autotable.min.js" />
    </ItemGroup>

    <Copy SourceFiles="@(JsPDF)" DestinationFolder="wwwroot/js/vendor" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(JsPDFTable)" DestinationFolder="wwwroot/js/vendor" SkipUnchangedFiles="true" />
  </Target>

</Project>