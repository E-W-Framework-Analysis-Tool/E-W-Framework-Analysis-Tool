@page "/"

<PageTitle>Dev Utilities</PageTitle>

<div class="min-h-screen bg-base-200 font-sans text-sm flex flex-col items-center justify-center p-8">

    <div class="mb-8 text-center">
        <h1 class="text-2xl font-bold">EW Dev Tools</h1>
        <p class="text-base-content/50 text-xs mt-1">Internal utilities — not for production use</p>
    </div>

    <div class="grid gap-4 w-full max-w-2xl">

        <a href="/framework-manager"
           class="bg-base-100 border border-base-300 rounded-box p-5 hover:border-primary hover:shadow transition-all group">
            <div class="flex items-start gap-4">
                <span class="text-2xl">⚙</span>
                <div class="flex-1">
                    <div class="font-bold text-base group-hover:text-primary transition-colors">
                        Framework Manager
                    </div>
                    <div class="text-base-content/60 mt-1 leading-relaxed">
                        Manage the framework reference data — data elements, indicators, essential questions,
                        and disaggregates. Edit element properties, maintain element-to-indicator and
                        element-to-disaggregate mappings, track review status, and export updated C# source
                        classes ready to drop back into the common project.
                    </div>
                    <div class="flex flex-wrap gap-1 mt-3">
                        <span class="badge badge-sm badge-ghost">Data Elements</span>
                        <span class="badge badge-sm badge-ghost">Indicators</span>
                        <span class="badge badge-sm badge-ghost">Essential Questions</span>
                        <span class="badge badge-sm badge-ghost">Disaggregates</span>
                        <span class="badge badge-sm badge-ghost">C# Export</span>
                    </div>
                </div>
            </div>
        </a>

        <a href="/framework-diff"
           class="bg-base-100 border border-base-300 rounded-box p-5 hover:border-primary hover:shadow transition-all group">
            <div class="flex items-start gap-4">
                <span class="text-2xl">🔀</span>
                <div class="flex-1">
                    <div class="font-bold text-base group-hover:text-primary transition-colors">
                        PR Diff Tool
                    </div>
                    <div class="text-base-content/60 mt-1 leading-relaxed">
                        Compare before/after snapshots of framework data when a standard Git diff isn't
                        enough — particularly when elements are renamed or merged. Link before/after elements
                        manually or let the fuzzy matcher suggest pairings, then generate a clean HTML diff
                        of indicator and disaggregate mapping changes suitable for PR review.
                    </div>
                    <div class="flex flex-wrap gap-1 mt-3">
                        <span class="badge badge-sm badge-ghost">Element Linking</span>
                        <span class="badge badge-sm badge-ghost">Rename / Merge Detection</span>
                        <span class="badge badge-sm badge-ghost">HTML Diff Export</span>
                    </div>
                </div>
            </div>
        </a>

    </div>

</div>
