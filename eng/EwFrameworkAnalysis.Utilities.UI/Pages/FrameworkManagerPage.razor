    static string Esc(string? s) =>
        (s ?? "").Replace("\\", "\\\\").Replace("\"", "\\\"")
                 .Replace("\r\n", "\\n").Replace("\n", "\\n").Replace("\r", "\\n");

    string GenerateReviewCsv()
    {
        using var writer = new StringWriter();
        using var csv = new CsvHelper.CsvWriter(writer, System.Globalization.CultureInfo.InvariantCulture);

        csv.WriteHeader<ReviewCsvRecord>();
        csv.NextRecord();

        foreach (var kv in _reviews.OrderBy(k => k.Key))
        {
            var parts = kv.Key.Split(':', 2);
            csv.WriteRecord(new ReviewCsvRecord
            {
                ItemType = parts.Length == 2 ? parts[0] : kv.Key,
                ItemName = parts.Length == 2 ? parts[1] : "",
                ReviewStatus = ReviewLabel(kv.Value.Status),
                ReviewNotes = kv.Value.Notes
            });
            csv.NextRecord();
        }

        return writer.ToString();
    }

    record ReviewCsvRecord
    {
        public string ItemType { get; init; } = "";
        public string ItemName { get; init; } = "";
        public string ReviewStatus { get; init; } = "";
        public string ReviewNotes { get; init; } = "";
    }

    async Task DownloadReviewCsv()
    {
        var csv = GenerateReviewCsv();
        var b64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(csv));
        await JS.InvokeVoidAsync("eval",
            $"const a=document.createElement('a');a.href='data:text/csv;base64,{b64}';" +
            $"a.download='ew-framework-reviews.csv';a.click();");
    }

    async Task CopyElementContext()
    {
        if (!_elements.TryGetValue(_selectedElementKey, out var el)) return;
        var usedByIndicators = IndicatorsUsingElement(_selectedElementKey);
        var usedByDisaggregates = DisaggregatesUsingElement(_selectedElementKey);
        var sb = new StringBuilder();
        sb.AppendLine($"**Data Element:** {_selectedElementKey}");
        sb.AppendLine($"**Category:** {el.DataElementCategory}");
        if (el.RelatedIndicatorClusters.Count > 0)
            sb.AppendLine($"**Cluster(s):** {string.Join(", ", el.RelatedIndicatorClusters)}");
        if (el.RelatedIndicatorTypes.Count > 0)
            sb.AppendLine($"**Related Indicator Type(s):** {string.Join(", ", el.RelatedIndicatorTypes)}");
        if (el.RelatedIndicatorDomains.Count > 0)
            sb.AppendLine($"**Related Indicator Domain(s):** {string.Join(", ", el.RelatedIndicatorDomains)}");
        sb.AppendLine($"**Sectors:** {string.Join(", ", el.RelatedSectors)}");
        if (!string.IsNullOrEmpty(el.AdditionalNotes))
            sb.AppendLine($"**Notes:** {el.AdditionalNotes}");
        if (!string.IsNullOrEmpty(el.ScoringRuleName))
            sb.AppendLine($"**Scoring Rule:** {el.ScoringRuleName}");
        sb.AppendLine();
        if (usedByIndicators.Count > 0)
        {
            sb.AppendLine($"**Used by {usedByIndicators.Count} indicator(s):**");
            foreach (var ind in usedByIndicators) sb.AppendLine($"- {ind}");
        }
        else
        {
            sb.AppendLine("**⚠ Not referenced by any indicator.**");
        }
        if (usedByDisaggregates.Count > 0)
        {
            sb.AppendLine();
            sb.AppendLine($"**Used by {usedByDisaggregates.Count} disaggregate(s):**");
            foreach (var d in usedByDisaggregates) sb.AppendLine($"- {d}");
        }
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", sb.ToString());
    }

    async Task CopyIndicatorContext()
    {
        if (!_indicators.TryGetValue(_selectedIndicatorKey, out var ind)) return;
        var sb = new StringBuilder();
        sb.AppendLine($"**Indicator:** {_selectedIndicatorKey}");
        var readinessText = ind.SectorReadiness.Count > 0
            ? string.Join(", ", ind.SectorReadiness.Select(sr => $"{sr.Sector}: {sr.Readiness}"))
            : "—";
        var clusterText = ind.Cluster.Count > 0 ? string.Join(", ", ind.Cluster) : "—";
        sb.AppendLine($"**Type:** {ind.Type} | **Domain:** {ind.Domain} | **Cluster:** {clusterText} | **Readiness:** {readinessText}");
        sb.AppendLine($"**Sectors:** {string.Join(", ", ind.Sectors)}");
        sb.AppendLine($"**Definition:** {ind.Definition}");
        sb.AppendLine($"**Recommended Metrics:** {ind.RecommendedMetrics}");
        sb.AppendLine($"**Data Needed:** {string.Join(", ", ind.DataNeeded)}");
        sb.AppendLine();
        sb.AppendLine($"**Data Elements ({_indEditElements.Count}):**");
        foreach (var el in _indEditElements.OrderBy(e => e))
        {
            if (_elements.TryGetValue(el, out var elem))
            {
                // sb.AppendLine($"- {el} [{elem.DataElementCategory}] ({string.Join(", ", elem.RelatedSectors)})");
                sb.AppendLine($"- {el}");
            }
            else
            {
                sb.AppendLine($"- {el} [⚠ not found in dictionary]");
            }
        }
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", sb.ToString());
    }

    // ── Clone helpers ─────────────────────────────────────────────────────

    static Disaggregate CloneDisaggregate(Disaggregate d) => new() { Name = d.Name, Description = d.Description, Sectors = d.Sectors.ToList(), DataElementNames = d.DataElementNames.ToList() };
    static DataElement CloneElement(DataElement e) => new() { Name = e.Name, DataElementCategory = e.DataElementCategory, RelatedSectors = e.RelatedSectors.ToList(), AdditionalNotes = e.AdditionalNotes, ScoringRuleName = e.ScoringRuleName };
    static Indicator CloneIndicator(Indicator i) => new() { Name = i.Name, Type = i.Type, Domain = i.Domain, Cluster = i.Cluster.ToList(), SectorReadiness = i.SectorReadiness.ToList(), Definition = i.Definition, RecommendedMetrics = i.RecommendedMetrics, DataNeeded = i.DataNeeded.ToList(), DataElementNames = i.DataElementNames.ToList() };
    static EssentialQuestion CloneQuestion(EssentialQuestion q) => new() { QuestionNumber = q.QuestionNumber, Question = q.Question, QuestionSummary = q.QuestionSummary, ApplicableSectors = q.ApplicableSectors.ToList(), RelatedIndicatorNames = q.RelatedIndicatorNames.ToList() };
