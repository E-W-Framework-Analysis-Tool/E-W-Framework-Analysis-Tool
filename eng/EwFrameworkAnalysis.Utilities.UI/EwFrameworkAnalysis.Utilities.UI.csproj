<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.8" PrivateAssets="all" />
    <PackageReference Include="Blazored.LocalStorage" Version="4.5.0" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EwFrameworkAnalysis.Common\EwFrameworkAnalysis.Common.csproj" />
  </ItemGroup>

  <Target Name="EnsureNodeModules" BeforeTargets="Build">
    <Message Text="Checking Tailwind CSS setup..." Importance="high" />

    <!-- Check if node_modules exists -->
    <Error Condition="!Exists('node_modules')" Text="Node modules not found. Run 'npm install' in $(MSBuildProjectDirectory) first." />

    <!-- Check if input.css exists -->
    <Error Condition="!Exists('wwwroot/css/input.css')" Text="Missing wwwroot/css/input.css. Create this file with your Tailwind imports." />

    <Exec Command="npx @tailwindcss/cli -i ./wwwroot/css/input.css -o ./wwwroot/css/app.css" WorkingDirectory="$(MSBuildProjectDirectory)" ContinueOnError="false" />
  </Target>
  
</Project>
