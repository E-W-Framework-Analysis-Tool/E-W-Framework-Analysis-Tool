public class DataElement
{
    public string Name { get; }
    public string EWFrameworkClusterCategory { get; }
    public string DataElementCategory { get; }
    public List<Sector> RelatedSectors { get; }
    public string? AdditionalNotes { get; }
    public List<string> RelatedIndicatorNames { get; }
    public string? EcsDataElementNameReference { get; }

    public DataElement(
        string name,
        string clusterOnlyCategory,
        string dataElementCategory,
        List<Sector> relatedSectors,
        string? additionalNotes,
        List<string> relatedIndicatorNames,
        string? ecsDataElementNameReference)
    {
        Name = name;
        EWFrameworkClusterCategory = clusterOnlyCategory;
        DataElementCategory = dataElementCategory;
        RelatedSectors = relatedSectors;
        AdditionalNotes = additionalNotes;
        RelatedIndicatorNames = relatedIndicatorNames;
        EcsDataElementNameReference = ecsDataElementNameReference;
    }
}


