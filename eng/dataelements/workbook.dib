# ECS stuff

#!csharp

// Define the output class for state inventory
public class StateEcsInventory
{
    public string State { get; set; }
    public string DataElementName { get; set; }
    public string ReportedAvailability { get; set; }
    public string InferredAvailability { get; set; }
}

// Create the state inventory by joining and mapping
var stateInventoryElements = (
    from recat in recategorizedElements
    join ecs in ecsStateCrosswalk 
        on recat.OriginalDataElementName equals ecs.MetricOrDataElement
    select new StateEcsInventory
    {
        State = ecs.State,
        DataElementName = recat.DataElementName,
        ReportedAvailability = ecs.ReportedCode,
        InferredAvailability = ecs.CollectedCode
    }
).ToList();

ecsStateCrosswalk.Count(); // 69666
stateInventoryElements.Count(); // 24808

#!csharp

var stateInventory = stateInventoryElements.GroupBy(x => x.State);

// Show distribution with inline mapping
Console.WriteLine("=== REPORTED AVAILABILITY BREAKDOWN ===");
var reportedDist = stateInventoryElements
    .GroupBy(x => string.IsNullOrWhiteSpace(x.ReportedAvailability) ? "Unreported" : 
                  x.ReportedAvailability.Equals("Found", StringComparison.OrdinalIgnoreCase) ? "Found" :
                  x.ReportedAvailability.Equals("Partial", StringComparison.OrdinalIgnoreCase) ? "Partial" :
                  x.ReportedAvailability.Equals("Not Found", StringComparison.OrdinalIgnoreCase) ? "Not Found" : 
                  x.ReportedAvailability)
    .Select(g => new { Status = g.Key, Count = g.Count() })
    .OrderByDescending(x => x.Count)
    .ToList();

foreach (var item in reportedDist)
{
    var percentage = (item.Count * 100.0 / stateInventoryElements.Count).ToString("F1");
    Console.WriteLine($"{item.Status}: {item.Count} ({percentage}%)");
}
stateInventoryElements.Count()

#!csharp

Console.WriteLine("\n=== INFERRED AVAILABILITY BREAKDOWN ===");
var inferredDist = stateInventoryElements
    .GroupBy(x => string.IsNullOrWhiteSpace(x.InferredAvailability) ? "Unreported" : 
                  x.InferredAvailability.Equals("Found", StringComparison.OrdinalIgnoreCase) ? "Found" :
                  x.InferredAvailability.Equals("Partial", StringComparison.OrdinalIgnoreCase) ? "Partial" :
                  x.InferredAvailability.Equals("Not Found", StringComparison.OrdinalIgnoreCase) ? "Not Found" : 
                  x.InferredAvailability)
    .Select(g => new { Status = g.Key, Count = g.Count() })
    .OrderByDescending(x => x.Count)
    .ToList();

foreach (var item in inferredDist)
{
    var percentage = (item.Count * 100.0 / stateInventoryElements.Count).ToString("F1");
    Console.WriteLine($"{item.Status}: {item.Count} ({percentage}%)");
}

Console.WriteLine($"\nTotal records: {stateInventoryElements.Count}");

// Breakdown by state
Console.WriteLine("\n=== BREAKDOWN BY STATE ===");
var stateBreakdown = stateInventoryElements
    .GroupBy(x => x.State)
    .OrderBy(g => g.Key)
    .ToList();

foreach (var stateGroup in stateBreakdown)
{
    Console.WriteLine($"\n{stateGroup.Key}:");
    
    var stateReported = stateGroup
        .GroupBy(x => string.IsNullOrWhiteSpace(x.ReportedAvailability) ? "unreported" : 
                      x.ReportedAvailability.Equals("Found", StringComparison.OrdinalIgnoreCase) ? "Found" :
                      x.ReportedAvailability.Equals("Partial", StringComparison.OrdinalIgnoreCase) ? "Partial" :
                      x.ReportedAvailability.Equals("Not Found", StringComparison.OrdinalIgnoreCase) ? "Not Found" : 
                      x.ReportedAvailability)
        .Select(g => new { Status = g.Key, Count = g.Count() })
        .OrderByDescending(x => x.Count);
    
    Console.WriteLine("  Reported:");
    foreach (var item in stateReported)
    {
        Console.WriteLine($"    {item.Status}: {item.Count}");
    }
    
    var stateInferred = stateGroup
        .GroupBy(x => string.IsNullOrWhiteSpace(x.InferredAvailability) ? "unreported" : 
                      x.InferredAvailability.Equals("Found", StringComparison.OrdinalIgnoreCase) ? "Found" :
                      x.InferredAvailability.Equals("Partial", StringComparison.OrdinalIgnoreCase) ? "Partial" :
                      x.InferredAvailability.Equals("Not Found", StringComparison.OrdinalIgnoreCase) ? "Not Found" : 
                      x.InferredAvailability)
        .Select(g => new { Status = g.Key, Count = g.Count() })
        .OrderByDescending(x => x.Count);
    
    Console.WriteLine("  Inferred:");
    foreach (var item in stateInferred)
    {
        Console.WriteLine($"    {item.Status}: {item.Count}");
    }
}

#!csharp

// Find records in ECS that don't match Recategorizations
var unmatchedEcs = ecsStateCrosswalk
    .Where(ecs => !recategorizedElements.Any(recat => recat.OriginalDataElementName == ecs.MetricOrDataElement))
    .Select(ecs => ecs.MetricOrDataElement)
    .Where(x => !string.IsNullOrWhiteSpace(x))
    .Distinct()
    .OrderBy(x => x)
    .ToList();

Console.WriteLine($"=== ECS RECORDS NOT MATCHING RECATEGORIZATIONS ===");
Console.WriteLine($"Total unmatched unique values in ECS: {unmatchedEcs.Count}");
Console.WriteLine("\nFirst 20 unmatched values from ECS:");
foreach (var item in unmatchedEcs.Take(20))
{
    Console.WriteLine($"  '{item}'");
}

// Find records in Recategorizations that don't match ECS
var unmatchedRecat = recategorizedElements
    .Where(recat => !ecsStateCrosswalk.Any(ecs => ecs.MetricOrDataElement == recat.OriginalDataElementName))
    .Select(recat => recat.OriginalDataElementName)
    .Distinct()
    .OrderBy(x => x)
    .ToList();

Console.WriteLine($"\n=== RECATEGORIZATION RECORDS NOT MATCHING ECS ===");
Console.WriteLine($"Total unmatched in Recategorizations: {unmatchedRecat.Count}");
Console.WriteLine("\nAll unmatched values from Recategorizations:");
foreach (var item in unmatchedRecat)
{
    Console.WriteLine($"  '{item}'");
}

// Try fuzzy matching to find near-misses
Console.WriteLine("\n=== POTENTIAL NEAR-MISSES (FUZZY MATCHING) ===");
var ecsValues = ecsStateCrosswalk
    .Select(x => x.MetricOrDataElement)
    .Where(x => !string.IsNullOrWhiteSpace(x))
    .Distinct()
    .ToList();

foreach (var recatValue in unmatchedRecat.Take(10))
{
    var candidates = ecsValues
        .Where(ecsVal => 
            ecsVal.Contains(recatValue, StringComparison.OrdinalIgnoreCase) ||
            recatValue.Contains(ecsVal, StringComparison.OrdinalIgnoreCase) ||
            LevenshteinDistance(recatValue.ToLower(), ecsVal.ToLower()) <= 3)
        .Take(3)
        .ToList();
    
    if (candidates.Any())
    {
        Console.WriteLine($"\nRecategorization: '{recatValue}'");
        Console.WriteLine("  Possible matches in ECS:");
        foreach (var candidate in candidates)
        {
            Console.WriteLine($"    - '{candidate}'");
        }
    }
}

// Helper function for fuzzy matching
int LevenshteinDistance(string s, string t)
{
    int n = s.Length;
    int m = t.Length;
    int[,] d = new int[n + 1, m + 1];

    if (n == 0) return m;
    if (m == 0) return n;

    for (int i = 0; i <= n; i++) d[i, 0] = i;
    for (int j = 0; j <= m; j++) d[0, j] = j;

    for (int i = 1; i <= n; i++)
    {
        for (int j = 1; j <= m; j++)
        {
            int cost = (t[j - 1] == s[i - 1]) ? 0 : 1;
            d[i, j] = Math.Min(Math.Min(d[i - 1, j] + 1, d[i, j - 1] + 1), d[i - 1, j - 1] + cost);
        }
    }
    return d[n, m];
}

