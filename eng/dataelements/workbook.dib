// Helper method to load CSV files
List<T> LoadCsv<T>(string filePath)
{
    var config = new CsvConfiguration(CultureInfo.InvariantCulture)
    {
        HeaderValidated = null,
        MissingFieldFound = null,
        TrimOptions = TrimOptions.Trim
    };
    
    using var reader = new StreamReader(filePath);
    using var csv = new CsvReader(reader, config);
    return csv.GetRecords<T>().ToList();
}

// Load the CSV files
var dataElementsNormalization = LoadCsv<DataElementNormalization>("DataElementsNormalization.csv");
var mainDataElements = LoadCsv<MainDataElement>("Main-DataElements.csv");
var ecsStateCrosswalk = LoadCsv<EcsStateCrosswalk>("EcsStateCrosswalk.csv");
var recategorizedElements = LoadCsv<RecategorizedDataElement>("Recategorizations.csv");

// Display counts to verify loading
Console.WriteLine($"Loaded {dataElementsNormalization.Count} records from DataElementsNormalization.csv");
Console.WriteLine($"Loaded {mainDataElements.Count} records from Main-DataElements.csv");
Console.WriteLine($"Loaded {ecsStateCrosswalk.Count} records from EcsStateCrosswalk.csv");
Console.WriteLine($"Loaded {recategorizedElements.Count} records from Recategorizations.csv");

#!csharp

public enum Sector
{
    PreK,
    K12,
    Postsecondary,
    Workforce
}

public class DataElement
{
    public string Name { get; }
    public string EWFrameworkClusterCategory { get; }
    public string DataElementCategory { get; }
    public List<Sector> RelatedSectors { get; }
    public string? AdditionalNotes { get; }
    public List<string> RelatedIndicatorNames { get; }
    public string? EcsDataElementNameReference { get; }
    
    public DataElement(
        string name,
        string clusterOnlyCategory,
        string dataElementCategory,
        List<Sector> relatedSectors,
        string? additionalNotes,
        List<string> relatedIndicatorNames,
        string? ecsDataElementNameReference)
    {
        Name = name;
        EWFrameworkClusterCategory = clusterOnlyCategory;
        DataElementCategory = dataElementCategory;
        RelatedSectors = relatedSectors;
        AdditionalNotes = additionalNotes;
        RelatedIndicatorNames = relatedIndicatorNames;
        EcsDataElementNameReference = ecsDataElementNameReference;
    }
}

// Helper to parse sector enum
List<Sector> ParseSectors(string? sectorString)
{
    if (string.IsNullOrWhiteSpace(sectorString))
        return new List<Sector>();
    
    var sectors = new List<Sector>();
    var parts = sectorString.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    
    foreach (var part in parts)
    {
        if (Enum.TryParse<Sector>(part.Replace("-", "").Replace(" ", ""), true, out var sector))
        {
            sectors.Add(sector);
        }
    }
    
    return sectors;
}

// Join and transform the data
var dataElements = new Dictionary<string, DataElement>();

foreach (var normalized in dataElementsNormalization)
{
    if (string.IsNullOrWhiteSpace(normalized.ProposedFinal))
        continue;
    
    var name = normalized.ProposedFinal.Trim();
    
    // Find matching recategorized element
    var recategorized = recategorizedElements
        .FirstOrDefault(r => r.DataElementName?.Trim().Equals(name, StringComparison.OrdinalIgnoreCase) == true);
    
    // Get cluster category and data element category
    var clusterCategory = recategorized?.ClusterOnlyCategory?.Trim() ?? "";
    var dataElementCategory = recategorized?.SuggestedCategory?.Trim() ?? "";
    
    // Parse sectors
    var sectors = ParseSectors(recategorized?.Sector);
    
    // Get additional notes
    var additionalNotes = string.IsNullOrWhiteSpace(normalized.AdditionalNotesOptional) 
        ? null 
        : normalized.AdditionalNotesOptional.Trim();
    
    // Get related indicators by joining on OriginalDataElementName
    var relatedIndicators = new List<string>();
    if (recategorized != null && !string.IsNullOrWhiteSpace(recategorized.OriginalDataElementName))
    {
        var originalName = recategorized.OriginalDataElementName.Trim();
        relatedIndicators = mainDataElements
            .Where(m => m.DataElement?.Trim().Equals(originalName, StringComparison.OrdinalIgnoreCase) == true)
            .Where(m => !string.IsNullOrWhiteSpace(m.Indicator))
            .Select(m => m.Indicator.Trim())
            .Distinct()
            .ToList();
    }
    
    // ECS reference (using OriginalDataElementName as reference)
    var ecsReference = recategorized?.OriginalDataElementName?.Trim();
    if (string.IsNullOrWhiteSpace(ecsReference))
        ecsReference = null;
    
    // Create the DataElement
    var dataElement = new DataElement(
        name,
        clusterCategory,
        dataElementCategory,
        sectors,
        additionalNotes,
        relatedIndicators,
        ecsReference
    );
    
    // Add to dictionary (skip duplicates)
    if (!dataElements.ContainsKey(name))
    {
        dataElements.Add(name, dataElement);
    }
}

// Export as C# code
var sb = new StringBuilder();
sb.AppendLine("public static class EwFrameworkDataElements");
sb.AppendLine("{");
sb.AppendLine("    public static readonly Dictionary<string, DataElement> Elements = new()");
sb.AppendLine("    {");

foreach (var kvp in dataElements.OrderBy(de => de.Key))
{
    var de = kvp.Value;
    var key = EscapeString(de.Name);
    var name = EscapeString(de.Name);
    var cluster = EscapeString(de.EWFrameworkClusterCategory);
    var category = EscapeString(de.DataElementCategory);
    
    var sectorsStr = de.RelatedSectors.Count > 0 
        ? $"new List<Sector> {{ {string.Join(", ", de.RelatedSectors.Select(s => $"Sector.{s}"))} }}"
        : "new List<Sector>()";
    
    var notesStr = de.AdditionalNotes != null 
        ? $"\"{EscapeString(de.AdditionalNotes)}\"" 
        : "null";
    
    var indicatorsStr = de.RelatedIndicatorNames.Count > 0
        ? $"new List<string> {{ {string.Join(", ", de.RelatedIndicatorNames.Select(i => $"\"{EscapeString(i)}\""))} }}"
        : "new List<string>()";
    
    var ecsRefStr = de.EcsDataElementNameReference != null
        ? $"\"{EscapeString(de.EcsDataElementNameReference)}\""
        : "null";
    
    sb.AppendLine($"        [\"{key}\"] = new DataElement(\"{name}\", \"{cluster}\", \"{category}\", {sectorsStr}, {notesStr}, {indicatorsStr}, {ecsRefStr}),");
}

sb.AppendLine("    };");
sb.AppendLine("}");

// Write to file
File.WriteAllText("EwFrameworkDataElements.cs", sb.ToString());
Console.WriteLine("\nExported to EwFrameworkDataElements.cs");

// Helper to escape strings for C# code
string EscapeString(string input)
{
    return input.Replace("\\", "\\\\").Replace("\"", "\\\"").Replace("\n", "\\n").Replace("\r", "\\r");
}

#!markdown

# Join final data elements to indicators

#!csharp

// Define the output class
public class NormalizedDataElement
{
    public string DataElementName { get; set; }
    public string OriginalDataElementName { get; set; }
    public string Category1 { get; set; }
    public string Category2 { get; set; }
    public string Sector { get; set; }
    public string Notes { get; set; }
    public List<string> Indicators { get; set; }
    public bool IsDisaggregate { get; set; }
}

// Create the normalized output by joining and grouping
var normalizedDataElements = (
    from norm in dataElementsNormalization
    join main in mainDataElements 
        on norm.OriginalDataElementName equals main.DataElement into mainGroup
    from main in mainGroup.DefaultIfEmpty() // Left join to include all normalization records
    group new { norm, main } by new 
    { 
        ProposedFinal = norm.ProposedFinal,
        OriginalDataElementName = norm.OriginalDataElementName,
        DataCategory = norm.DataCategory,
        UpdatedCategory = norm.UpdatedCategory,
        RollUpToSector = norm.RollUpToSector,
        AdditionalNotesOptional = norm.AdditionalNotesOptional
    } into g
    select new NormalizedDataElement
    {
        DataElementName = g.Key.ProposedFinal,
        OriginalDataElementName = g.Key.OriginalDataElementName,
        Category1 = g.Key.DataCategory,
        Category2 = g.Key.UpdatedCategory,
        Sector = g.Key.RollUpToSector,
        Notes = g.Key.AdditionalNotesOptional,
        Indicators = g.Where(x => x.main != null && !string.IsNullOrWhiteSpace(x.main.Indicator))
                      .Select(x => x.main.Indicator)
                      .Distinct()
                      .OrderBy(x => x)
                      .ToList(),
        IsDisaggregate = g.Any(x => x.main != null && 
                                    string.Equals(x.main.Type, "Disaggregate", StringComparison.OrdinalIgnoreCase))
    }
).ToList();

// Further deduplicate by DataElementName (ProposedFinal)
var deduplicatedNormalizedDataElements = normalizedDataElements
    .GroupBy(x => x.DataElementName)
    .Select(g => new NormalizedDataElement
    {
        DataElementName = g.Key,
        OriginalDataElementName = string.Join("; ", g.Select(x => x.OriginalDataElementName).Distinct()),
        Category1 = g.First().Category1, // Take first non-null or use a merge strategy
        Category2 = g.First().Category2,
        Sector = g.First().Sector,
        Notes = string.Join("; ", g.Select(x => x.Notes).Where(n => !string.IsNullOrWhiteSpace(n)).Distinct()),
        Indicators = g.SelectMany(x => x.Indicators).Distinct().OrderBy(x => x).ToList(),
        IsDisaggregate = g.Any(x => x.IsDisaggregate)
    })
    .OrderBy(x => x.DataElementName)
    .ToList();

Console.WriteLine($"Created {deduplicatedNormalizedDataElements.Count} deduplicated normalized data elements");

deduplicatedNormalizedDataElements

#!csharp

// Define the output class for state inventory
public class StateEcsInventory
{
    public string State { get; set; }
    public string DataElementName { get; set; }
    public string ReportedAvailability { get; set; }
    public string InferredAvailability { get; set; }
}

// Create the state inventory by joining and mapping
var stateInventoryElements = (
    from recat in recategorizedElements
    join ecs in ecsStateCrosswalk 
        on recat.OriginalDataElementName equals ecs.MetricOrDataElement
    select new StateEcsInventory
    {
        State = ecs.State,
        DataElementName = recat.DataElementName,
        ReportedAvailability = ecs.ReportedCode,
        InferredAvailability = ecs.CollectedCode
    }
).ToList();

ecsStateCrosswalk.Count(); // 69666
stateInventoryElements.Count(); // 24808

