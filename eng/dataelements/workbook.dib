## Quick validations

#!csharp

// Show statistics
var withIndicators = deduplicatedNormalizedDataElements.Count(x => x.Indicators.Any());
var disaggregateCount = deduplicatedNormalizedDataElements.Count(x => x.IsDisaggregate);
var withoutIndicators = deduplicatedNormalizedDataElements.Count(x => !x.Indicators.Any());

Console.WriteLine("\n=== STATISTICS ===");
Console.WriteLine($"Total deduplicated data elements: {deduplicatedNormalizedDataElements.Count}");
Console.WriteLine($"With indicators: {withIndicators}");
Console.WriteLine($"Without indicators: {withoutIndicators}");
Console.WriteLine($"Marked as disaggregate: {disaggregateCount}");

#!csharp

// Distribution of Category2 values
var category2Distribution = deduplicatedNormalizedDataElements
    .GroupBy(x => string.IsNullOrWhiteSpace(x.Category2) ? "(blank)" : x.Category2)
    .Select(g => new 
    { 
        Category = g.Key, 
        Count = g.Count() 
    })
    .OrderByDescending(x => x.Count)
    .ToList();

Console.WriteLine("=== CATEGORY2 DISTRIBUTION ===");
Console.WriteLine($"Total unique Category2 values: {category2Distribution.Count}");
Console.WriteLine();

foreach (var item in category2Distribution)
{
    Console.WriteLine($"{item.Category}: {item.Count}");
}

#!markdown

# Saving results to CSV

#!csharp

// Create output class for CSV
public class DataElementOutput
{
    public string DataElementName { get; set; }
    public string OriginalDataElementName { get; set; }
    public string Category { get; set; }
    public string Sector { get; set; }
    public string Notes { get; set; }
    public string Indicators { get; set; }
    public string IsDisaggregate { get; set; }
}

// Transform to output format
var outputData = deduplicatedNormalizedDataElements
    .Select(x => new DataElementOutput
    {
        DataElementName = x.DataElementName,
        OriginalDataElementName = x.OriginalDataElementName,
        Category = x.Category2,
        Sector = x.Sector,
        Notes = x.Notes,
        Indicators = string.Join("; ", x.Indicators),
        IsDisaggregate = x.IsDisaggregate.ToString()
    })
    .ToList();

// Write to CSV
var outputPath = "OUTPUT_DataElements.csv";
var config = new CsvConfiguration(CultureInfo.InvariantCulture)
{
    TrimOptions = TrimOptions.Trim
};

using (var writer = new StreamWriter(outputPath))
using (var csv = new CsvWriter(writer, config))
{
    csv.WriteRecords(outputData);
}

Console.WriteLine($"Successfully wrote {outputData.Count} records to {outputPath}");
Console.WriteLine($"File location: {Path.GetFullPath(outputPath)}");

