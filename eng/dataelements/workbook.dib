public class Indicator
{
    public required string Name { get; set; }
    public required IndicatorType Type { get; set; }
    public required IndicatorDomain Domain { get; set; }
    public required string Definition { get; set; }
    public required string RecommendedMetrics { get; set; }
    public List<DataCategory> DataNeeded
    {
        get; set;
    } = [];
    public List<Sector> Sectors
    {
        get; set;
    } = [];
    public List<string> DataElementNames
    {
        get; set;
    } = [];
}

public enum DataCategory
{
    AdministrativeData,
    Assessments,
    ClassroomObservations,
    CurriculumMaterials,
    EducatorAdministrativeData,
    Rubrics,
    StudentTranscripts,
    Surveys
}

public enum IndicatorType
{
    OutcomesMilestones,
    EWSystemConditions,
    AdjacentSystemConditions
}

public enum IndicatorDomain
{
    AcademicProgressCompletion,
    CareerReadinessEconomicSuccess,
    SocialEmotionalPhysicalWellbeing,
    CrossDomain
}

var elementToIndicators = new Dictionary<string, List<string>>();

foreach (var element in EwFrameworkDataElements.Elements.Values)
{
    foreach (var indicatorName in element.RelatedIndicatorNames)
    {
        if (!elementToIndicators.ContainsKey(indicatorName))
        {
            elementToIndicators[indicatorName] = new List<string>();
        }
        elementToIndicators[indicatorName].Add(element.Name);
    }
}

// Step 3: Update each indicator's DataElementNames based on the reverse mapping
foreach (var kvp in EwFrameworkIndicators.Indicators)
{
    var indicatorName = kvp.Key;
    var indicator = kvp.Value;
    
    if (elementToIndicators.ContainsKey(indicatorName))
    {
        indicator.DataElementNames = elementToIndicators[indicatorName].OrderBy(x => x).ToList();
        Console.WriteLine($"Updated '{indicatorName}': {indicator.DataElementNames.Count} elements");
    }
    else
    {
        Console.WriteLine($"WARNING: No data elements found for indicator '{indicatorName}'");
    }
}

// Step 4: Generate the updated dictionary code in compact single-line format
var outputPath = "UpdatedIndicators.cs";
using (var writer = new StreamWriter(outputPath))
{
    writer.WriteLine("public static readonly Dictionary<string, Indicator> Indicators = new()");
    writer.WriteLine("{");

    foreach (var kvp in EwFrameworkIndicators.Indicators)
    {
        var name = kvp.Key;
        var ind = kvp.Value;
        
        // Escape quotes and newlines in strings
        string EscapeString(string s) => s.Replace("\\", "\\\\").Replace("\"", "\\\"").Replace("\r\n", " ").Replace("\n", " ").Replace("\r", " ");
        
        // Format lists
        string FormatDataCategories(List<DataCategory> cats) => 
            $"[{string.Join(", ", cats.Select(c => $"DataCategory.{c}"))}]";
        
        string FormatSectors(List<Sector> sectors) => 
            $"[{string.Join(", ", sectors.Select(s => $"Sector.{s}"))}]";
        
        string FormatDataElementNames(List<string> names) => 
            names.Count == 0 ? "[]" : $"[\"{string.Join("\", \"", names.Select(EscapeString))}\"]";
        
        writer.WriteLine($"    [\"{EscapeString(name)}\"] = new() {{ Name = \"{EscapeString(ind.Name)}\", Type = IndicatorType.{ind.Type}, Domain = IndicatorDomain.{ind.Domain}, Definition = \"{EscapeString(ind.Definition)}\", RecommendedMetrics = \"{EscapeString(ind.RecommendedMetrics)}\", DataNeeded = {FormatDataCategories(ind.DataNeeded)}, Sectors = {FormatSectors(ind.Sectors)}, DataElementNames = {FormatDataElementNames(ind.DataElementNames)} }},");
    }

    writer.WriteLine("};");
}

Console.WriteLine($"\n=== Output written to {outputPath} ===");

// Step 5: Validation report
Console.WriteLine("\n=== VALIDATION REPORT ===\n");
Console.WriteLine($"Total Indicators: {EwFrameworkIndicators.Indicators.Count}");
Console.WriteLine($"Total Data Elements: {EwFrameworkDataElements.Elements.Count}");
Console.WriteLine($"\nIndicators with no data elements:");
foreach (var kvp in EwFrameworkIndicators.Indicators.Where(i => i.Value.DataElementNames.Count == 0))
{
    Console.WriteLine($"  - {kvp.Key}");
}

Console.WriteLine($"\nData elements referencing non-existent indicators:");
var allIndicatorNames = new HashSet<string>(EwFrameworkIndicators.Indicators.Keys);
foreach (var element in EwFrameworkDataElements.Elements.Values)
{
    foreach (var indicatorRef in element.RelatedIndicatorNames)
    {
        if (!allIndicatorNames.Contains(indicatorRef))
        {
            Console.WriteLine($"  - Element '{element.Name}' references unknown indicator '{indicatorRef}'");
        }
    }
}
