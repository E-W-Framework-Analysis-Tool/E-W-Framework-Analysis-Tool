#!markdown

# Connection Parsing Structures and Logic

#!csharp

public class CedsConnection
{
    public string Title { get; set; } = string.Empty;
    public List<string> SelectedDescriptors { get; set; } = new();
    public string Author { get; set; } = string.Empty;
    public string Location { get; set; } = string.Empty;
    public string Source { get; set; } = string.Empty;
    public string Description { get; set; } = string.Empty;
    public DataElements DataElements { get; set; } = new();
    public List<AnalysisSection> AnalysisRecommendations { get; set; } = new();
    public DateTime LastModified { get; set; }
    public string Status { get; set; } = string.Empty;
}

public class DataElements
{
    public ElementSection Metric { get; set; } = new();
    public ElementSection Disaggregates { get; set; } = new();
}

public class ElementSection
{
    public List<CedsElement> CedsElements { get; set; } = new();
    public List<NonCedsElement> NonCedsElements { get; set; } = new();
}

public class CedsElement
{
    public string Path { get; set; } = string.Empty;
    public int TermId { get; set; }
    public int DataModelId { get; set; }
}

public class NonCedsElement
{
    public string Name { get; set; } = string.Empty;
    public int ElementId { get; set; }
}

public class AnalysisSection
{
    public string Title { get; set; } = string.Empty;
    public string RawHtml { get; set; } = string.Empty;
    public string MarkdownContent { get; set; } = string.Empty;
}

#!csharp

#r "nuget:HtmlAgilityPack"
#r "nuget:ReverseMarkdown"

#!csharp

using System.Net.Http;
using System.Text.RegularExpressions;
using HtmlAgilityPack;
using ReverseMarkdown;

public static class CedsConnectionParser
{
    private static readonly HttpClient httpClient = new HttpClient();
    private static readonly Converter markdownConverter = new Converter();
    
    public static async Task<CedsConnection> ParseConnectionAsync(string url)
    {
        try
        {
            var html = await httpClient.GetStringAsync(url);
            return ParseConnectionHtml(html);
        }
        catch (Exception ex)
        {
            throw new Exception($"Failed to parse connection from URL {url}: {ex.Message}", ex);
        }
    }
    
    public static CedsConnection ParseConnectionHtml(string html)
    {
        var doc = new HtmlDocument();
        doc.LoadHtml(html);
        
        var connection = new CedsConnection();
        
        // Parse basic information
        ParseBasicInfo(doc, connection);
        
        // Parse data elements
        ParseDataElements(doc, connection);
        
        // Parse analysis recommendations
        ParseAnalysisRecommendations(doc, connection);
        
        // Parse metadata
        ParseMetadata(doc, connection);
        
        return connection;
    }
    
    private static void ParseBasicInfo(HtmlDocument doc, CedsConnection connection)
    {
        // Title
        var titleElement = doc.DocumentNode.SelectSingleNode("//span[@id='ContentPlaceHolder1_ucUseCaseReport_Title']//span[@style]");
        if (titleElement != null)
        {
            connection.Title = titleElement.InnerText?.Trim() ?? string.Empty;
        }
        
        // Selected Descriptors
        var descriptorsElement = doc.DocumentNode.SelectSingleNode("//td[@id='ContentPlaceHolder1_ucUseCaseReport_Categories']");
        if (descriptorsElement != null)
        {
            // Get the inner HTML and decode entities, then split by <br> tags
            var descriptorHtml = descriptorsElement.InnerHtml;
            
            // Split by <br> tags and process each line
            var lines = descriptorHtml.Split(new string[] { "<br>", "<br/>", "<br />", "\n" }, StringSplitOptions.RemoveEmptyEntries);
            
            var descriptors = new List<string>();
            foreach (var line in lines)
            {
                // Decode HTML and clean up the text
                var cleanLine = System.Net.WebUtility.HtmlDecode(line)
                    .Replace("&nbsp;", " ")
                    .Trim();
                
                // Skip the header line and empty lines
                if (!string.IsNullOrWhiteSpace(cleanLine) && 
                    !cleanLine.Contains("Selected Descriptors:") &&
                    !cleanLine.StartsWith("<b>"))
                {
                    // Remove leading whitespace and arrows
                    cleanLine = cleanLine.TrimStart(' ', '\t', '→', '-');
                    if (!string.IsNullOrWhiteSpace(cleanLine))
                    {
                        descriptors.Add(cleanLine);
                    }
                }
            }
            
            connection.SelectedDescriptors = descriptors;
        }
        
        // Author
        var authorElement = doc.DocumentNode.SelectSingleNode("//span[@id='ContentPlaceHolder1_ucUseCaseReport_Author']");
        if (authorElement != null)
        {
            connection.Author = authorElement.InnerText?.Trim() ?? string.Empty;
        }
        
        // Location
        var locationElement = doc.DocumentNode.SelectSingleNode("//span[@id='ContentPlaceHolder1_ucUseCaseReport_Location']");
        if (locationElement != null)
        {
            connection.Location = locationElement.InnerText?.Trim() ?? string.Empty;
        }
        
        // Source
        var sourceElement = doc.DocumentNode.SelectSingleNode("//span[@id='ContentPlaceHolder1_ucUseCaseReport_Source']");
        if (sourceElement != null)
        {
            connection.Source = sourceElement.InnerText?.Trim() ?? string.Empty;
        }
        
        // Description
        var descriptionElement = doc.DocumentNode.SelectSingleNode("//div[@id='ContentPlaceHolder1_ucUseCaseReport_Description']");
        if (descriptionElement != null)
        {
            connection.Description = descriptionElement.InnerText?.Trim() ?? string.Empty;
        }
    }
    
    private static void ParseDataElements(HtmlDocument doc, CedsConnection connection)
    {
        // Find all tables with data elements
        var dataElementTables = doc.DocumentNode.SelectNodes("//table[.//h2[contains(text(), 'Metric') or contains(text(), 'Disaggregate')]]");
        
        if (dataElementTables != null)
        {
            foreach (var table in dataElementTables)
            {
                var sectionHeader = table.SelectSingleNode(".//h2")?.InnerText?.Trim();
                var isMetric = sectionHeader?.Contains("Metric") == true;
                var isDisaggregate = sectionHeader?.Contains("Disaggregate") == true;
                
                if (isMetric || isDisaggregate)
                {
                    var section = isMetric ? connection.DataElements.Metric : connection.DataElements.Disaggregates;
                    ParseElementSection(table, section);
                }
            }
        }
    }
    
    private static void ParseElementSection(HtmlNode table, ElementSection section)
    {
        // Parse CEDS Elements
        var cedsElementsList = table.SelectNodes(".//td[@class='tdCedsElements'][1]//ol//li");
        if (cedsElementsList != null)
        {
            foreach (var li in cedsElementsList)
            {
                var link = li.SelectSingleNode(".//a");
                if (link != null)
                {
                    var onclick = link.GetAttributeValue("onclick", "");
                    var match = Regex.Match(onclick, @"openCEDSElementDetails\((\d+),(\d+)\)");
                    
                    if (match.Success)
                    {
                        var element = new CedsElement
                        {
                            Path = link.InnerText?.Trim() ?? string.Empty,
                            TermId = int.Parse(match.Groups[1].Value),
                            DataModelId = int.Parse(match.Groups[2].Value)
                        };
                        section.CedsElements.Add(element);
                    }
                }
            }
        }
        
        // Parse Non-CEDS Elements
        var nonCedsElementsList = table.SelectNodes(".//td[@class='tdCedsElements'][2]//ol//li");
        if (nonCedsElementsList != null)
        {
            foreach (var li in nonCedsElementsList)
            {
                var link = li.SelectSingleNode(".//a");
                if (link != null)
                {
                    var onclick = link.GetAttributeValue("onclick", "");
                    var match = Regex.Match(onclick, @"openNonCEDSElementDetails\((\d+)\)");
                    
                    if (match.Success)
                    {
                        var element = new NonCedsElement
                        {
                            Name = link.InnerText?.Trim() ?? string.Empty,
                            ElementId = int.Parse(match.Groups[1].Value)
                        };
                        section.NonCedsElements.Add(element);
                    }
                }
            }
        }
    }
    
    private static void ParseAnalysisRecommendations(HtmlDocument doc, CedsConnection connection)
    {
        var recommendationsSection = doc.DocumentNode.SelectSingleNode("//tbody[@id='ContentPlaceHolder1_ucUseCaseReport_tbodyRecommendations']");
        
        if (recommendationsSection != null)
        {
            // Find the main ul element
            var mainUl = recommendationsSection.SelectSingleNode(".//ul[@style='list-style-type: none;margin-bottom:10px;']");
            
            if (mainUl != null)
            {
                var listItems = mainUl.SelectNodes("./li");
                
                if (listItems != null)
                {
                    for (int i = 0; i < listItems.Count; i += 2) // Process pairs: h2 li + content li
                    {
                        var headerLi = listItems[i];
                        var contentLi = i + 1 < listItems.Count ? listItems[i + 1] : null;
                        
                        var h2Element = headerLi.SelectSingleNode(".//h2");
                        if (h2Element != null)
                        {
                            var section = new AnalysisSection();
                            section.Title = h2Element.InnerText?.Trim() ?? string.Empty;
                            
                            if (contentLi != null)
                            {
                                // Get raw HTML of the content li
                                section.RawHtml = contentLi.InnerHtml?.Trim() ?? string.Empty;
                                
                                // Convert to markdown using ReverseMarkdown
                                if (!string.IsNullOrWhiteSpace(section.RawHtml))
                                {
                                    section.MarkdownContent = markdownConverter.Convert(section.RawHtml);
                                }
                            }
                            
                            connection.AnalysisRecommendations.Add(section);
                        }
                    }
                }
            }
        }
    }
    
    private static void ParseMetadata(HtmlDocument doc, CedsConnection connection)
    {
        // Last Modified Date
        var lastModifiedElement = doc.DocumentNode.SelectSingleNode("//span[@id='ContentPlaceHolder1_ucUseCaseReport_LastModifiedDate']");
        if (lastModifiedElement != null && DateTime.TryParse(lastModifiedElement.InnerText?.Trim(), out var lastModified))
        {
            connection.LastModified = lastModified;
        }
        
        // Status
        var statusElement = doc.DocumentNode.SelectSingleNode("//span[@id='ContentPlaceHolder1_ucUseCaseReport_ReleaseStatus']");
        if (statusElement != null)
        {
            connection.Status = statusElement.InnerText?.Trim() ?? string.Empty;
        }
    }
}

