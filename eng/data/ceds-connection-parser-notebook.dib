#!markdown

# Mapping to CEDS DW

This uses the CEDS Elements v13 crosswalk from DataModelID to GlobalID (from `ceds-elements-v13-globalcrosswalk.csv`) to map from Connection to Global ID.

It also uses the results of the `ceds-dw-metadata-query.sql` to further map from Global ID to CEDS DW column metadata.

The result should give a rough estimate of what mapped elements exist in the DW and where.

#!csharp

#r "nuget: CsvHelper"

#!csharp

using CsvHelper.Configuration.Attributes;

public class CedsGlobalElement
{
    [Name("Global ID")]
    public string GlobalId { get; set; } = string.Empty;
    
    [Name("Data Model ID")]
    public string DataModelId { get; set; } = string.Empty;
    
    [Name("Element Name")]
    public string ElementName { get; set; } = string.Empty;
}

public class CedsDwMetadata
{
    [Name("schema_name")]
    public string SchemaName { get; set; } = string.Empty;
    
    [Name("table_name")]
    public string TableName { get; set; } = string.Empty;
    
    [Name("column_name")]
    public string ColumnName { get; set; } = string.Empty;
    
    [Name("column_data_type")]
    public string ColumnDataType { get; set; } = string.Empty;
    
    [Name("full_data_type")]
    public string FullDataType { get; set; } = string.Empty;
    
    [Name("CEDS_GlobalId")]
    public string? CedsGlobalId { get; set; }
    
    [Name("CEDS_Element")]
    public string? CedsElement { get; set; }
}

#!csharp

using System.IO;
using System.Globalization;
using CsvHelper;

public static List<CedsGlobalElement> LoadCedsElements(string csvPath)
{
    using var reader = new StringReader(File.ReadAllText(csvPath));
    using var csv = new CsvReader(reader, CultureInfo.InvariantCulture);
    
    var records = csv.GetRecords<CedsGlobalElement>().ToList();
    Console.WriteLine($"Loaded {records.Count} CEDS global elements");
    return records;
}

public static List<CedsDwMetadata> LoadDwMetadata(string csvPath)
{
    using var reader = new StringReader(File.ReadAllText(csvPath));
    using var csv = new CsvReader(reader, CultureInfo.InvariantCulture);
    
    // Configure to handle NULL values
    csv.Context.TypeConverterOptionsCache.GetOptions<string>().NullValues.Add("NULL");
    
    var records = csv.GetRecords<CedsDwMetadata>().ToList();
    Console.WriteLine($"Loaded {records.Count} DW metadata records");
    return records;
}

public static string? GetGlobalIdFromDataModelId(List<CedsGlobalElement> cedsElements, string dataModelId)
{
    return cedsElements
        .FirstOrDefault(e => string.Equals(e.DataModelId, dataModelId, StringComparison.OrdinalIgnoreCase))
        ?.GlobalId;
}

public static List<CedsDwMetadata> GetDwColumnsFromGlobalId(List<CedsDwMetadata> dwMetadata, string globalId)
{
    return dwMetadata
        .Where(d => string.Equals(d.CedsGlobalId, globalId, StringComparison.OrdinalIgnoreCase))
        .ToList();
}

public static void PrintDataStats(List<CedsGlobalElement> cedsElements, List<CedsDwMetadata> dwMetadata)
{
    var dwWithCeds = dwMetadata.Count(d => !string.IsNullOrWhiteSpace(d.CedsGlobalId));
    var uniqueGlobalInDw = dwMetadata
        .Where(d => !string.IsNullOrWhiteSpace(d.CedsGlobalId))
        .Select(d => d.CedsGlobalId)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Count();
    
    Console.WriteLine($"=== Data Statistics ===");
    Console.WriteLine($"CEDS Elements: {cedsElements.Count}");
    Console.WriteLine($"DW Metadata Records: {dwMetadata.Count}");
    Console.WriteLine($"DW Records with CEDS GlobalId: {dwWithCeds}");
    Console.WriteLine($"Unique Global IDs in DW: {uniqueGlobalInDw}");
}

#!csharp

var cedsElements = LoadCedsElements("ceds-elements-v13-globalcrosswalk.csv");
var dwMetadata = LoadDwMetadata("ceds-dw-metadata-v11-results.csv");
PrintDataStats(cedsElements, dwMetadata);

#!csharp

var connectionAnalysis = connections.SelectMany(conn => 
    conn.DataElements.Metric.CedsElements
        .Concat(conn.DataElements.Disaggregates.CedsElements)
        .Select(element => new
        {
            Connection = conn.Title,
            ElementPath = element.Path,
            DataModelId = element.DataModelId,
            TermId = element.TermId,
            GlobalId = GetGlobalIdFromDataModelId(cedsElements, element.DataModelId.ToString()),
            ElementName = cedsElements.FirstOrDefault(e => e.DataModelId == element.DataModelId.ToString())?.ElementName
        })
        .Where(x => x.GlobalId != null)
        .Select(x => new
        {
            x.Connection,
            x.ElementPath,
            x.DataModelId,
            x.TermId,
            x.GlobalId,
            x.ElementName,
            DwColumns = GetDwColumnsFromGlobalId(dwMetadata, x.GlobalId!)
        })
).ToList();

var connectionCoverage = connectionAnalysis
    .GroupBy(x => x.Connection)
    .Select(g => new
    {
        Connection = g.Key,
        TotalElements = g.Count(),
        ElementsWithDwMapping = g.Count(x => x.DwColumns.Any()),
        UniqueTables = g.SelectMany(x => x.DwColumns)
                       .Select(c => $"{c.SchemaName}.{c.TableName}")
                       .Distinct()
                       .Count()
    })
    .OrderByDescending(x => x.ElementsWithDwMapping)
    .ToList();

#!csharp

connectionAnalysis

#!csharp

using System.Linq;

public class IndicatorAnalysisOutput
{
    public string IndicatorName { get; set; } = string.Empty;
    public string IndicatorDataElement { get; set; } = string.Empty;
    public int DataModelId { get; set; }
    public string GlobalId { get; set; } = string.Empty;
    public string DataWarehouseLocations { get; set; } = string.Empty;
}

var outputRecords = connectionAnalysis.Select(x => new IndicatorAnalysisOutput
{
    IndicatorName = ((string)x.Connection).Contains(':') 
                ? ((string)x.Connection).Substring(0, ((string)x.Connection).IndexOf(':')).Trim()
                : (string)x.Connection, // take only up to the colon if present, this should be the exact indicator name.
    IndicatorDataElement = x.ElementPath,
    DataModelId = x.DataModelId,
    GlobalId = x.GlobalId ?? string.Empty,
    DataWarehouseLocations = string.Join("; ", 
        ((IEnumerable<CedsDwMetadata>)x.DwColumns).Select(c => $"{c.SchemaName}.{c.TableName}.{c.ColumnName}"))
}).ToList();

var outputPath = "ew-connection-to-ceds-dw-mapping.csv";

using (var writer = new StringWriter())
using (var csv = new CsvWriter(writer, CultureInfo.InvariantCulture))
{
    csv.WriteRecords(outputRecords);
    
    var csvContent = writer.ToString();
    File.WriteAllText(outputPath, csvContent);
    
    Console.WriteLine($"Exported {outputRecords.Count} records to {outputPath}");
}

#!csharp

var percentageCoverage = ((float)outputRecords.Where(x => string.IsNullOrWhiteSpace(x.DataWarehouseLocations)).Count()) / outputRecords.Count();
percentageCoverage.Display();

var outputDistinctByGlobalId = outputRecords.DistinctBy(x => x.GlobalId);
var percentageGlobalCoverage = ((float)outputDistinctByGlobalId.Where(x => string.IsNullOrWhiteSpace(x.DataWarehouseLocations)).Count()) / outputDistinctByGlobalId.Count();
percentageGlobalCoverage.Display();

#!csharp

var outputPath = "ew-connection-to-ceds-dw-mapping-distinct.csv";

using (var writer = new StringWriter())
using (var csv = new CsvWriter(writer, CultureInfo.InvariantCulture))
{
    var filteredRecords = outputRecords.DistinctBy(x => x.GlobalId).ToList();
    csv.WriteRecords(filteredRecords);
    
    var csvContent = writer.ToString();
    File.WriteAllText(outputPath, csvContent);
    
    Console.WriteLine($"Exported {filteredRecords.Count} records to {outputPath}");
}

