# Copy to .env to override docker-compose.yml defaults for your machine.
# bootstrap.ps1 writes this file for you when you pass -ApiPort or -SqlPort.

# Host port for the Ed-Fi API. macOS runs the AirPlay Receiver on 5000; 5001 belongs to
# the Blazor app's local HTTPS endpoint, so 5010 is a good choice there.
EDFI_API_PORT=5000

# Host port for SQL Server.
SQL_PORT=14333

# Set to true to restore over existing databases from the backups baked into the image,
# discarding local changes. Normally left false.
FORCE_RESTORE=false
